  const raw = String(node?.label ?? node?.title ?? node?.id ?? "");
  const canonical = raw.startsWith(`${node?.id} · `)
    ? raw.slice(String(node.id).length + 3)
    : raw;
  if (node?.kind === "object") {
    return { label: String(node.id ?? raw), subtitle: canonical || String(node.subtitle ?? "") };
  }
  if (node?.kind === "event") {
    const [stepId, ...human] = canonical.split(" — ");
    return { label: stepId || String(node.id ?? raw), subtitle: human.join(" — ") };
  }
  if (node?.kind === "actor") {
    return { label: canonical || String(node.id ?? raw), subtitle: "actor" };
