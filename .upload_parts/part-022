 const target=new Set(c.targetMetrics),factor=c.workloadAssumption.factor;
 const base={...p.baseline},fx={...p.fx};
 for(const m of SCENARIO_OUTCOMES){base[m.id]=target.has(m.id)?p.baseline[m.id]*factor:null;fx[m.id]=target.has(m.id)?p.fx[m.id]:null;}
 const calculation=calculateScenario(base,fx,inputs);
 const outcomes=SCENARIO_OUTCOMES.filter(m=>target.has(m.id)).map(m=>({...m,observed:p.baseline[m.id],comparisonScenario:base[m.id],withIntervention:calculation[m.id],difference:calculation[m.id]===null?null:calculation[m.id]-base[m.id],status:calculation[m.id]===null?'NOT_ASSESSABLE':'SIMULATED',measurementLevel:'FINANCIAL_SOURCE_OUTCOMES_NOT_RESOURCE_ALLOCATION',relativeAssumption:p.fx[m.id]}));
