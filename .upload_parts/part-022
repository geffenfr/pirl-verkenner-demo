    if(key==='effort'){activity.seconds=(activity.seconds??0)+value;activity.effortRecords++;}
    else {activity.cost=(activity.cost??0)+value;activity.costRecords++;}
   }
   if(numeric(u.duration_seconds)&&numeric(u.cost_eur)){paired.push(ref);activity.records++;}
   if(numeric(u.hourly_rate_eur))rates.push(u.hourly_rate_eur);
  }
  if(used)activities.set(activityId,activity);
 }
 const result={schema:'pirl.resource-input-measurement.v1',actorId:aid,participationEvents:participationKeys.size,
  pairedRecords:paired.length,pairedEventIds:[...new Set(paired.map(x=>x.eventId))],pairedRecordRefs:paired,
