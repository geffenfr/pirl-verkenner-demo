function renderSourceOptions(activeDataset) {
  const builtInIds = new Set(BUILT_IN_DATASETS.map(({ id }) => id));
  const noBuiltInSelected = !builtInIds.has(activeDataset.id);
  const neutralOption = `<option value=""${
    noBuiltInSelected ? " selected" : ""
  }>Geen ingebouwde omgeving</option>`;
  return neutralOption + BUILT_IN_DATASETS.map(
    ({ id, label }) =>
      `<option data-i18n-source-value value="${escapeHtml(id)}"${id === activeDataset.id ? " selected" : ""}>${escapeHtml(
        label,
      )}</option>`,
  ).join("");
}

function formatActiveDatasetBadge({
  dataset,
  runtimeSnapshot,
  datasetActivation,
}) {
  const label = dataset?.label || "Geen dataset";
  if (!dataset?.id) return readStoredLanguage() === "en" ? "No dataset" : "Geen dataset";
  if (datasetActivation?.status !== DATASET_ACTIVATION_STATUS.ACTIVE) return label;

  const runtimeSourceId = runtimeSnapshot?.source?.id ?? null;
  const activeDatasetId = datasetActivation?.activeDatasetId ?? null;
  const cases = runtimeSnapshot?.model?.cases;
  if (
    runtimeSourceId !== dataset.id ||
    activeDatasetId !== dataset.id ||
    !Array.isArray(cases)
  ) {
    return label;
  }

  const manifest = runtimeSnapshot?.model?.manifest;
  const explicitCount = manifest?.statistics?.case_count ?? manifest?.case_count;
  const describedCount = String(manifest?.description || "").match(
    /\b(\d+)\s+linked\b[^.]*\bcases\b/i,
  )?.[1];
  const caseCount = Number.isInteger(explicitCount)
    ? explicitCount
    : describedCount
      ? Number(describedCount)
      : cases.length;
  return `${label} · ${caseCount} cases`;
}

