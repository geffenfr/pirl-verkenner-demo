function adjacencyFor(graph) {
  const adjacency = new Map();
  const link = (from, to) => {
    if (!adjacency.has(from)) adjacency.set(from, []);
    adjacency.get(from).push(to);
  };
  for (const edge of asArray(graph?.edges)) {
    if (!edge?.from || !edge?.to) continue;
    link(edge.from, edge.to);
    link(edge.to, edge.from);
  }
  return adjacency;
}

function radialEntityLayout(graph, center) {
  const contract = graph?.layoutContract ?? {};
  const minimumSpacing = asFinite(contract.minimumSpacing, 205);
  const ringGap = asFinite(contract.ringGap ?? contract.radial?.ringDistance, 245);
  const startRadius = asFinite(contract.startRadius ?? contract.radial?.startRadius, 270);
  const margin = asFinite(contract.margin ?? contract.radial?.margin, 150);
  const resolvedMinimumSpacing = asFinite(
    contract.minimumSpacing ?? contract.radial?.minimumSpacing,
    minimumSpacing,
  );
  const positions = {};
  const adjacency = adjacencyFor(graph);
  const distance = new Map([[center.key, 0]]);
  const queue = [center.key];
  while (queue.length) {
    const key = queue.shift();
    const depth = distance.get(key);
    for (const neighbor of adjacency.get(key) ?? []) {
      if (distance.has(neighbor)) continue;
      distance.set(neighbor, depth + 1);
      queue.push(neighbor);
    }
  }
  const nodes = asArray(graph?.nodes)
    .filter(({ key }) => key !== center.key)
    .slice()
    .sort(
      (left, right) =>
        (left.hop ?? distance.get(left.key) ?? 99) -
          (right.hop ?? distance.get(right.key) ?? 99) ||
        String(left.kind).localeCompare(String(right.kind)) ||
        String(left.key).localeCompare(String(right.key)),
    );
  const rings = [];
  let index = 0;
  let radius = startRadius;
  while (index < nodes.length) {
    const capacity = Math.max(
      6,
      Math.floor((2 * Math.PI * radius) / resolvedMinimumSpacing),
    );
    const take = Math.min(capacity, nodes.length - index);
    rings.push({ radius, nodes: nodes.slice(index, index + take) });
    index += take;
    radius += ringGap;
  }
  const maximumRadius = rings.length ? rings.at(-1).radius : startRadius;
  const size = Math.ceil(2 * (maximumRadius + margin));
  const centerPoint = size / 2;
  positions[center.key] = { x: centerPoint, y: centerPoint };
  rings.forEach((ring, ringIndex) => {
    const count = ring.nodes.length;
    const offset =
      -Math.PI / 2 + (ringIndex % 2 ? Math.PI / Math.max(1, count) : 0);
    ring.nodes.forEach((node, nodeIndex) => {
      const angle = offset + (2 * Math.PI * nodeIndex) / Math.max(1, count);
      positions[node.key] = {
        x: centerPoint + ring.radius * Math.cos(angle),
        y: centerPoint + ring.radius * Math.sin(angle),
      };
    });
  });
  return { world: { width: size, height: size }, positions };
}

function objectCenterLayout(graph, center) {
  const contract = graph?.layoutContract ?? {};
  const width = asFinite(
    contract.worldWidth ?? contract.world?.width ?? contract.objectWorld?.width,
    1420,
  );
  const height = asFinite(
    contract.worldHeight ?? contract.world?.height ?? contract.objectWorld?.height,
    1040,
  );
  const centerX = asFinite(contract.centerX ?? contract.objectWorld?.center?.x, 710);
  const centerY = asFinite(contract.centerY ?? contract.objectWorld?.center?.y, 520);
  const positions = { [center.key]: { x: centerX, y: centerY } };
  const nodes = asArray(graph?.nodes);
  const objects = nodes.filter(({ key, kind }) => kind === "object" && key !== center.key);
  objects.forEach((node, index) => {
    const ring = index < 10 ? 1 : 2;
    const ringIndex = ring === 1 ? index : index - 10;
    const count =
      ring === 1 ? Math.min(objects.length, 10) : Math.max(1, objects.length - 10);
    const radius = ring === 1 ? 300 : 430;
    const angle = (2 * Math.PI * ringIndex) / count - Math.PI / 2;
    positions[node.key] = {
      x: centerX + radius * Math.cos(angle),
      y: centerY + radius * Math.sin(angle) * 0.82,
    };
  });
  const adjacency = adjacencyFor(graph);
  const nearestObject = (start) => {
    const queue = [[start, 0]];
    const seen = new Set([start]);
    while (queue.length) {
      const [key, depth] = queue.shift();
      if (depth > 3) break;
      const record = nodes.find((node) => node.key === key);
      if (key !== start && record?.kind === "object") return key;
      for (const neighbor of adjacency.get(key) ?? []) {
        if (seen.has(neighbor)) continue;
        seen.add(neighbor);
        queue.push([neighbor, depth + 1]);
      }
    }
    return center.key;
  };
  const groups = new Map();
  for (const node of nodes.filter(({ kind }) => kind !== "object")) {
    const anchor = nearestObject(node.key);
    if (!groups.has(anchor)) groups.set(anchor, []);
    groups.get(anchor).push(node);
  }
  for (const [anchorKey, group] of groups) {
    const anchor = positions[anchorKey] ?? positions[center.key];
    const isCenter = anchorKey === center.key;
    const baseAngle = isCenter ? 0 : Math.atan2(anchor.y - centerY, anchor.x - centerX);
    group.forEach((node, index) => {
      const layer = Math.floor(index / 8);
      const slot = index % 8;
      const layerCount = Math.min(8, group.length - layer * 8);
      const radius = 145 + layer * 95;
      const angle = isCenter
        ? (2 * Math.PI * slot) / Math.max(1, layerCount) + layer * 0.33
        : baseAngle +
          (layerCount <= 1 ? 0 : (slot / (layerCount - 1) - 0.5) * 1.7) +
          (layer % 2 ? 0.13 : -0.13);
      positions[node.key] = {
        x: clamp(anchor.x + radius * Math.cos(angle), 70, width - 70),
        y: clamp(anchor.y + radius * Math.sin(angle), 70, height - 70),
      };
    });
  }
  return { world: { width, height }, positions };
}

function layoutObjectGraph(graph = {}) {
  const center = graphCenterNode(graph);
  if (!center) return Object.freeze({ world: { width: 0, height: 0 }, positions: {} });
  const layout =
    center.kind === "object"
      ? objectCenterLayout(graph, center)
      : radialEntityLayout(graph, center);
  const manual = graph.manualPositions ?? {};
  for (const [key, position] of Object.entries(manual)) {
    if (!layout.positions[key]) continue;
    if (!Number.isFinite(Number(position?.x)) || !Number.isFinite(Number(position?.y))) continue;
    layout.positions[key] = { x: Number(position.x), y: Number(position.y) };
  }
  return Object.freeze({
    world: Object.freeze({ ...layout.world }),
    positions: Object.freeze(
      Object.fromEntries(
        Object.entries(layout.positions).map(([key, value]) => [key, Object.freeze({ ...value })]),
      ),
    ),
  });
}

function renderGraphControls(scale) {
  const percentage = `${Math.round(clamp(asFinite(scale, 1), 0.55, 1.8) * 100)}%`;
  return `<div class="object-map-controls" data-object-map-controls>
    <strong>Objectkaart</strong>
    <button type="button" data-object-action="zoom-out" aria-label="Uitzoomen">−</button>
    <button type="button" data-object-action="zoom-in" aria-label="Inzoomen">+</button>
    <button type="button" data-object-action="zoom-100">100%</button>
    <button type="button" data-object-action="zoom-fit">Overzicht</button>
    <button type="button" data-object-action="reset-layout">Herstel layout</button>
    <span class="object-scale" aria-live="polite">${percentage}</span>
    <span class="object-map-help">${escapeHtml(OBJECT_EXPLORER_COPY.graphHelp)}</span>
  </div>`;
}

function renderGraphSvg(graph, language) {
  const layout = layoutObjectGraph(graph);
  const positions = layout.positions;
  const scale = clamp(asFinite(graph.scale, 1), 0.55, 1.8);
  const nodesByKey = new Map(asArray(graph.nodes).map((node) => [node.key, node]));
  const edges = asArray(graph.edges)
    .map((edge) => {
      const from = positions[edge?.from];
      const to = positions[edge?.to];
      if (!from || !to) return "";
      const kind = canonicalEdgeKind(edge.kind);
      const label = edge.label || kind;
      return `<line class="object-graph-edge object-graph-edge-${escapeHtml(kind)}" data-edge-from="${escapeHtml(
        edge.from,
      )}" data-edge-to="${escapeHtml(edge.to)}" x1="${from.x}" y1="${from.y}" x2="${to.x}" y2="${to.y}" stroke="${OBJECT_EDGE_COLORS[kind]}" stroke-width="1.7" pointer-events="none"><title>${escapeHtml(
        label,
      )}</title></line>`;
    })
    .join("");
  const nodes = asArray(graph.nodes)
    .map((node) => {
      const point = positions[node.key];
      if (!point) return "";
      const isCenter = node.center === true;
      const isSelected = node.selected === true || isCenter;
      const selectable = node.selectable !== false && ENTITY_KINDS.has(node.kind);
      const width = node.kind === "object" ? 124 : 154;
      const height = node.kind === "object" ? 66 : 74;
      const color = nodeColor(node);
      const fill = isCenter ? color : isSelected ? "#fff7d6" : "#fff";
      const foreground = isCenter ? "#fff" : "#172033";
      const copy = graphNodeCopy(node);
      const label = copy.label;
      const subtitle = node.kind === "event" ? productCopy(copy.subtitle, language) : copy.subtitle;
      const sourceMarker = node.kind !== "event" ? " data-i18n-source-value" : "";
      const actionAttributes = selectable
        ? ` data-object-action="select-entity" data-selection-kind="${escapeHtml(
            node.kind,
          )}" data-selection-id="${escapeHtml(node.id ?? "")}" tabindex="0" role="button"`
        : "";
      return `<g class="object-graph-node${selectable ? " selectable" : " context"}"${sourceMarker} data-graph-node="${escapeHtml(
        node.key,
      )}" data-node-kind="${escapeHtml(node.kind)}" data-selected="${isSelected}" data-center="${isCenter}" transform="translate(${point.x},${point.y})"${actionAttributes} aria-label="${escapeHtml(
        [label, subtitle].filter(Boolean).join(" · "),
      )}">
        <title>${escapeHtml([label, subtitle].filter(Boolean).join(" · "))}</title>
        <rect class="object-node-hit" x="${-width / 2 - 10}" y="${
          -height / 2 - 10
        }" width="${width + 20}" height="${height + 20}" rx="20" fill="transparent" stroke="none" pointer-events="all"></rect>
        <rect class="object-node-shape" x="${-width / 2}" y="${
          -height / 2
        }" width="${width}" height="${height}" rx="14" fill="${escapeHtml(
          fill,
        )}" stroke="${escapeHtml(color)}" stroke-width="${
          isSelected ? 5 : isCenter ? 4 : 2
        }" pointer-events="none"></rect>
        <text x="0" y="-7" text-anchor="middle" style="font-size:11px;font-weight:900;fill:${escapeHtml(
          foreground,
        )}">${escapeHtml(label.slice(0, 23))}</text>
        <foreignObject x="${-width / 2 + 6}" y="3" width="${
          width - 12
        }" height="28"><div xmlns="http://www.w3.org/1999/xhtml" class="object-node-subtitle${
          isCenter ? " center" : ""
        }">${escapeHtml(subtitle.slice(0, 52))}</div></foreignObject>
      </g>`;
    })
    .join("");
  return `<svg class="object-graph-svg" viewBox="0 0 ${layout.world.width} ${layout.world.height}" width="${Math.round(
    layout.world.width * scale,
  )}" height="${Math.round(layout.world.height * scale)}" data-object-model="${escapeHtml(
    graph.modelKey ?? "",
  )}" aria-label="Objectkaart">${edges}${nodes}</svg>`;
}

function renderGraph(graph = {}, language) {
  if (graph.state === "INVENTORY_ONLY") {
    return `<div class="object-graph-viewport inventory-only" id="objectGraph" data-object-graph-state="INVENTORY_ONLY">
      <div class="object-empty object-inventory-only-graph">
        <b>Geen execution graph van toepassing</b>
        <span>Deze actor is expliciet als INVENTORY_ONLY geclassificeerd. Er worden geen fictieve relaties of losse participant-node getekend.</span>
      </div>
    </div>`;
  }
  if (graph.state !== "READY" || !asArray(graph.nodes).length) {
    return `<div class="object-graph-viewport neutral" id="objectGraph" data-object-graph-state="NEUTRAL">
      <div class="object-empty-map">
        <b>${escapeHtml(OBJECT_EXPLORER_COPY.graphEmptyTitle)}</b>
        <span>${escapeHtml(OBJECT_EXPLORER_COPY.graphEmptyText)}</span>
      </div>
    </div>`;
  }
  return `${renderGraphControls(graph.scale)}
    <div class="object-graph-viewport" id="objectGraph" data-object-graph-state="READY" data-object-viewport-anchor="${escapeHtml(
      graph.viewportAnchor ?? "center",
    )}" tabindex="0">
      ${renderGraphSvg(graph, language)}
    </div>`;
}

function renderParticipationState(selection) {
  const participation = selection?.participation;
  if (!participation || participation.supported === false) return "";
  const mode = String(participation.mode ?? "").toUpperCase();
  if (mode !== "OBSERVED_EXECUTION" && mode !== "INVENTORY_ONLY") return "";
  const selectedName = String(selection.label ?? "").startsWith(`${selection.id} · `)
    ? String(selection.label).slice(String(selection.id).length + 3)
    : selection.label;
  const name = participation.name ?? selectedName ?? selection.id ?? "Deze actor";
  const references = normalizeCount(
    participation.eventReferences ??
      participation.eventRefs ??
      participation.observedEventReferences,
  );
  const basis = participation.basis ?? "—";
  if (mode === "INVENTORY_ONLY") {
    return `<div class="object-notice warn" data-object-participation-state="INVENTORY_ONLY">
      <b>Inventory-only actor</b>
      <div class="object-tiny">${escapeHtml(
        name,
      )} bestaat in het organisatie-/capabilitymodel, maar heeft <b>geen geobserveerde uitvoeringsreferenties</b>. Deze actor wordt daarom bewust niet als execution-node getekend.</div>
      <div class="object-tiny object-muted">Basis: ${escapeHtml(
        basis,
      )} · eventreferenties: 0</div>
    </div>`;
  }
  return `<div class="object-notice" data-object-participation-state="OBSERVED_EXECUTION">
    <b>Geobserveerde uitvoeringsdeelnemer</b>
    <div class="object-tiny">${escapeHtml(name)} heeft <b>${references}</b> eventreferentie${
      references === 1 ? "" : "s"
    } in de actieve synthetische procesrealiteit.</div>
    <div class="object-tiny object-muted">Participation mode: ${escapeHtml(
      mode || "OBSERVED_EXECUTION",
    )} · basis: ${escapeHtml(basis)}</div>
  </div>`;
}

function renderJourney(journey = {}, selection, language) {
  if (journey.state === "INVENTORY_ONLY") {
    return `<section class="object-journey object-card" data-object-view-target="journey" aria-labelledby="object-journey-title">
      <div class="object-notice warn">
        <h3 id="object-journey-title">Geen Entity Journey</h3>
        <div class="object-tiny">Er is geen geobserveerde uitvoering voor deze inventory-only actor.</div>
      </div>
    </section>`;
  }
  if (journey.state !== "READY" || !selection) {
    return `<section class="object-journey object-card" data-object-view-target="journey" aria-labelledby="object-journey-title">
      <h3 id="object-journey-title">Entity Journey</h3>
      <div class="object-muted">${escapeHtml(OBJECT_EXPLORER_COPY.journeyEmpty)}</div>
    </section>`;
  }
  const records = asArray(journey.records).slice(0, 500);
  const total = normalizeCount(journey.total ?? asArray(journey.records).length);
  const recordMarkup = records.length
    ? `<div class="object-timeline">${records
        .map(
          (record) => `<div class="object-timeline-row">
            <span>${escapeHtml(record?.time ?? "—")}</span>
            <b>${escapeHtml(record?.type ?? "—")}</b>
            <span><span${["Beslissing", "Communicatie"].includes(record?.type) ? " data-i18n-source-value" : ""}>${escapeHtml(["Beslissing", "Communicatie"].includes(record?.type) ? record?.title ?? "—" : eventCopy(record?.title ?? "—", language))}</span>${
              record?.context
                ? `<br><span class="object-muted"${["Beslissing", "Communicatie"].includes(record?.type) ? " data-i18n-source-value" : ""}>${escapeHtml(record.context)}</span>`
                : ""
            }</span>
          </div>`,
        )
        .join("")}</div>`
    : '<div class="object-muted object-no-journey-records">Geen journey-records gevonden.</div>';
  return `<section class="object-journey object-card" data-object-view-target="journey" aria-labelledby="object-journey-title">
    <h3 id="object-journey-title">Entity Journey</h3>
    <div class="object-muted">Chronologische context van <strong>${escapeHtml(
      selection.label,
    )}</strong> · ${total} records.</div>
    ${recordMarkup}
  </section>`;
}

function renderDetailValue(row, language) {
  if (row?.format === "json") {
    const value =
      typeof row.value === "string" ? row.value : JSON.stringify(row?.value ?? {}, null, 2);
    return `<pre class="object-json">${escapeHtml(value)}</pre>`;
  }
  if (Array.isArray(row?.value)) return escapeHtml(row.value.join(", ") || "—");
  return escapeHtml(row?.term === "Processtap" ? eventCopy(row?.value ?? "—", language) : row?.value ?? "—");
}

function renderDetail(detail = {}, selection, language) {
  const rows = asArray(detail.rows);
  if (!selection || detail.state !== "READY") {
    return `<section class="object-card object-detail" aria-labelledby="object-detail-title">
      <h3 id="object-detail-title">Objectdetail</h3>
      <div class="object-empty">${escapeHtml(OBJECT_EXPLORER_COPY.entityEmpty)}</div>
    </section>`;
  }
  return `<section class="object-card object-detail" aria-labelledby="object-detail-title">
    <h3 id="object-detail-title">Objectdetail</h3>
    <dl class="object-kv">${rows
      .map(
        (row) => `<dt>${escapeHtml(row?.term ?? row?.label ?? "")}</dt><dd${selection.kind !== "event" || !["Type", "Processtap", "Proces"].includes(row?.term) ? " data-i18n-source-value" : ""}>${renderDetailValue(
          row, language,
        )}</dd>`,
      )
      .join("")}</dl>
  </section>`;
}

function renderLifecycle(lifecycle = {}, selection) {
  const metrics = asArray(lifecycle.metrics);
  if (!selection || lifecycle.state !== "READY") {
    return `<section class="object-card object-lifecycle" aria-labelledby="object-lifecycle-title">
      <h3 id="object-lifecycle-title">Lifecycle-samenvatting</h3>
      <div class="object-empty">${escapeHtml(OBJECT_EXPLORER_COPY.entityEmpty)}</div>
    </section>`;
  }
  return `<section class="object-card object-lifecycle" aria-labelledby="object-lifecycle-title">
    <h3 id="object-lifecycle-title">Lifecycle-samenvatting</h3>
    <div class="object-lifecycle-metrics">${metrics
      .map(
        (metric) => `<div class="object-metric">
          <span>${escapeHtml(metric?.label ?? "")}</span>
          <strong${typeof metric?.value === "string" && metric.value.length > 8 ? ' class="text"' : ""}>${escapeHtml(
            metric?.value ?? 0,
          )}</strong>
        </div>`,
      )
      .join("")}</div>
  </section>`;
}

function renderCapabilityRegion(capability = {}) {
  const source = capability ?? {};
  const region = source.region;
  const status = source.status ?? source.state ?? "";
  if (!region?.visible) {
    return `<div id="objectCapabilityRegion" data-object-capability-region data-capability-status="${escapeHtml(
      status,
    )}" hidden aria-hidden="true"></div>`;
  }
  return `<div id="objectCapabilityRegion" class="object-capability-region" data-object-capability-region data-capability-status="${escapeHtml(
    status,
  )}" role="status">
    ${region.title ? `<b>${escapeHtml(region.title)}</b>` : ""}
    ${region.message ? `<div>${escapeHtml(region.message)}</div>` : ""}
    ${region.supportingText ? `<div>${escapeHtml(region.supportingText)}</div>` : ""}
  </div>`;
}

function renderSelectedEntityCard(selection, graph, language) {
  const title = selection?.label ?? OBJECT_EXPLORER_COPY.noSelection;
  const subtitle = selection?.subtitle ?? OBJECT_EXPLORER_COPY.noSelectionSubtitle;
