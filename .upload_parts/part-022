  const target = snapshot.kind === "process" ? root.querySelector("[data-conformance-process]") : snapshot.kind === "variant" ? root.querySelector("[data-conformance-variant]") : null;
  target?.focus?.(); return Boolean(target);
}
function bindConformanceExplorerInteractions({ root, controller, onFocusSnapshot = () => {}, onCommit = () => {} } = {}) {
  if (!root || !controller) throw new TypeError("Conformance Explorer binder requires root and controller");
  const removers = [];
  const on = (target, type, handler) => { target?.addEventListener?.(type, handler); if (target) removers.push(() => target.removeEventListener(type, handler)); };
  const invoke = (action, fn, focus = captureConformanceFocus(root)) => { onFocusSnapshot(focus); const changed = Boolean(fn()); onCommit({ action, changed, focusSnapshot: focus }); return changed; };
  const process = root.querySelector("[data-conformance-process]");
  on(process, "change", (event) => { const value = event.currentTarget.value || null; event.currentTarget.blur?.(); return invoke("conformance-process", () => value ? controller.selectProcess(value) : controller.clearContextProcess(), null); });
