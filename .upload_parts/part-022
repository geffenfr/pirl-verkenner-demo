    <div class="object-selected-heading">
      <div>
        <h3 id="object-selection-title"${selection && selection.kind !== "event" ? " data-i18n-source-value" : ""}>${escapeHtml(selection?.kind === "event" ? eventCopy(title, language) : title)}</h3>
        <div class="object-muted"${selection?.kind === "object" ? " data-i18n-source-value" : ""}>${escapeHtml(subtitle)}</div>
      </div>
    </div>
    ${renderParticipationState(selection)}
    ${renderGraph(graph, language)}
