function createAppShell({
  root,
  router,
  contextStore,
  runtimeStore,
  screenRegistry,
  scopeService = null,
  measurementService = null,
  onboardingService = null,
  documentRef = document,
}) {
  if (!root || !router || !contextStore || !runtimeStore || !screenRegistry) {
    throw new TypeError(
      "App shell requires root, router, contextStore, runtimeStore and screenRegistry",
    );
  }
  for (const method of [
    "snapshot",
    "loadBuiltIn",
    "cancelPendingBuiltInLoads",
    "subscribe",
  ]) {
    if (typeof runtimeStore[method] !== "function") {
      throw new TypeError(`App shell runtimeStore must expose ${method}()`);
    }
  }
  for (const method of [
    "render",
    "transition",
    "prepareRender",
    "bind",
    "handleContextClear",
    "subscribe",
    "destroy",
  ]) {
    if (typeof screenRegistry[method] !== "function") {
      throw new TypeError(`App shell screenRegistry must expose ${method}()`);
    }
  }
  const initialCatalogueState=()=>({catalogueSearch:"",catalogueKind:"ALL",catalogueCategory:"",catalogueType:"",catalogueValidity:"ALL",catalogueGroupBy:"CATEGORY",catalogueShowAll:false,selectedCatalogueKey:null,executionSearch:"",focusKind:"ACTOR",focusSearch:""});
  let catalogueState=initialCatalogueState();
  let drawerOpen = false;
  let contextOpen = false;
  let presentationMode = false;
  let language = readStoredLanguage();
  let renderQueued = false;
  let destroyed = false;
  let localizationQueued = false;
  let localizationObserver = null;

  function scheduleLocalization() {
    if (destroyed || localizationQueued) return;
    localizationQueued = true;
    queueMicrotask(() => {
      localizationQueued = false;
      if (destroyed) return;
      localizeDom(root, language);
    });
  }

  const MutationObserverCtor = documentRef?.defaultView?.MutationObserver ?? globalThis?.MutationObserver;
  if (typeof MutationObserverCtor === "function") {
    localizationObserver = new MutationObserverCtor(() => scheduleLocalization());
    localizationObserver.observe(root, {
      subtree: true,
      childList: true,
      characterData: true,
      attributes: true,
      attributeFilter: ["aria-label", "title", "placeholder", "alt", "aria-description"],
    });
  }
  let activationRequest = 0;
  const initialRuntime = runtimeStore.snapshot();
  let datasetActivation = activationState(
    initialRuntime.model ? DATASET_ACTIVATION_STATUS.ACTIVE : DATASET_ACTIVATION_STATUS.IDLE,
    {
      activeDatasetId: initialRuntime.source?.id ?? null,
      generation: initialRuntime.generation ?? 0,
    },
  );
  screenRegistry.transition({
    previousRoute: null,
    routeId: router.getCurrentRoute(),
    explicitCarry: null,
    source: "initial",
  });

  const sameReference=sameCatalogueReference;
  function getGlobalCatalogue(){
    const snapshot=runtimeStore.snapshot(),context=contextStore.getState();
    const catalogue=snapshot.model?buildGoalNormCatalogue({goals:snapshot.model.goals||[],norms:snapshot.model.norms||[],observedPeriod:context.observedPeriod,state:catalogueState,searchAlias:itemDisplayName}):null;
    return {catalogue,activeReference:context.reference||{primary:null,comparisons:[]},uiState:{...catalogueState}};
  }
  function selectedCatalogueItem(){return getGlobalCatalogue().catalogue?.selected||null;}
  function useSelectedAsPrimaryReference(){
    const item=selectedCatalogueItem();if(!item)return false;const current=contextStore.getState().reference||{primary:null,comparisons:[]};
    const comparisons=(current.comparisons||[]).filter(ref=>!sameReference(ref,item.reference));
    return contextStore.setReference({primary:item.reference,comparisons});
  }
  function addSelectedAsComparisonReference(){
    const item=selectedCatalogueItem();if(!item)return false;const current=contextStore.getState().reference||{primary:null,comparisons:[]};
    if(sameReference(current.primary,item.reference)||(current.comparisons||[]).some(ref=>sameReference(ref,item.reference)))return false;
    return contextStore.setReference({primary:current.primary||null,comparisons:[...(current.comparisons||[]),item.reference]});
  }

  let reviewDisclosureContext=null;
  function render() {
    renderQueued = false;
    if (destroyed) return;
    if (runtimeStore.isActivating?.()) return;
    // Context and Runtime Store notifications occur before the awaiting event
    // handler resumes. Holding this render keeps the successful source switch
    // atomic with its final RC3.23 route transition.
    if (datasetActivation.status === DATASET_ACTIVATION_STATUS.LOADING) return;
    const identity = productIdentity(language);
    documentRef.title = identity.documentTitle;
    documentRef.documentElement?.setAttribute?.("lang", language);
    const activeRouteId = router.getCurrentRoute();
    const route = requireRoute(activeRouteId);
    const oldContextBar=root.querySelector?.("#v19ContextBar");
    const contextScroll=contextOpen?(oldContextBar?.scrollTop||0):0;
    const contextDisclosures=Array.from(oldContextBar?.querySelectorAll?.("details[data-context-section], details.norm-catalogue-filter")||[],el=>({
      selector:el.hasAttribute("data-context-section")?`details[data-context-section="${el.getAttribute("data-context-section")}"]`:"details.norm-catalogue-filter",
      open:el.open,
    }));
    const activeElement=documentRef.activeElement;
    const contextSearchSelector=contextOpen&&oldContextBar?.contains?.(activeElement)?["[data-context-focus-search]","[data-context-execution-search]","[data-catalogue-search]"].find(selector=>activeElement?.matches?.(selector)):null;
    const contextSearchFocus=contextSearchSelector?{selector:contextSearchSelector,start:activeElement.selectionStart??null,end:activeElement.selectionEnd??null,direction:activeElement.selectionDirection||"none"}:null;
    const currentContext=contextStore.getState(),currentRuntime=runtimeStore.snapshot();
    const contextCatalogue=getGlobalCatalogue();
    const researchScope=scopeService?.getScope()||null;
    const focusAnalysis=projectFocusAnalysis({runtimeSnapshot:currentRuntime,context:currentContext,routeId:activeRouteId,researchScope});
    const resourceAnalysis=projectResourceAnalysis({runtimeSnapshot:currentRuntime,context:currentContext,routeId:activeRouteId,researchScope});
    const reviewContext=JSON.stringify([activeRouteId,currentRuntime.generation,currentContext]);
    const reviewOpen=reviewDisclosureContext===reviewContext?new Set(Array.from(root.querySelectorAll?.('details[data-review-detail][open]')||[],el=>el.getAttribute('data-review-detail'))):new Set();
    const reviewFocus=reviewDisclosureContext===reviewContext?documentRef.activeElement?.closest?.('details[data-review-detail]')?.getAttribute?.('data-review-detail'):null;
    screenRegistry.prepareRender(activeRouteId);
    root.innerHTML = renderAppFrame({
      activeRouteId,
      context: currentContext,
      drawerOpen,
      contextOpen,
      presentationMode,
      runtimeSnapshot: currentRuntime,
      datasetActivation,
      screenMarkup: screenRegistry.render(route, { language }),
      contextCatalogue,
      focusAnalysis,
      resourceAnalysis,
      language,
    });
    applyScreenInformationHierarchy(root,{language,routeId:activeRouteId});
    // renderAppFrame resolves copy before DOM insertion. The observer above is
    // a defensive fallback for future third-party DOM producers, not a render
    // requirement; current interaction producers use the same boundary.
    for(const el of root.querySelectorAll?.('details[data-review-detail]')||[]){
      if(reviewOpen.has(el.getAttribute('data-review-detail')))el.open=true;
      if(reviewFocus===el.getAttribute('data-review-detail'))el.querySelector?.('summary')?.focus?.({preventScroll:true});
    }
    reviewDisclosureContext=reviewContext;
    if(contextOpen){
      const bar=root.querySelector?.("#v19ContextBar");
      if(bar){
        for(const disclosure of contextDisclosures){const details=bar.querySelector(disclosure.selector);if(details)details.open=disclosure.open;}
        if(contextSearchFocus){
          const search=bar.querySelector(contextSearchFocus.selector);
          search?.focus?.({preventScroll:true});
          if(search&&contextSearchFocus.start!=null)search.setSelectionRange?.(contextSearchFocus.start,contextSearchFocus.end??contextSearchFocus.start,contextSearchFocus.direction);
        }
        bar.scrollTop=contextScroll;
      }
    }
    bind();
    screenRegistry.bind({ root, routeId: activeRouteId, navigate: (target, source = "screen-action", options = {}) => router.go(target, { source, ...options }) });
  }

  function scheduleRender() {
    if (destroyed) return;
    if (datasetActivation.status === DATASET_ACTIVATION_STATUS.LOADING) return;
    if (renderQueued) return;
    renderQueued = true;
    queueMicrotask(render);
  }

  function setDatasetControlBusy(busy) {
    const selector = root.querySelector("#companySwitch050");
    if (selector) {
      selector.disabled = busy;
      selector.setAttribute?.("aria-busy", String(busy));
    }
    documentRef.body?.classList.toggle("switch-wait050", busy);
  }

  function normalizedActivationError(error) {
    return Object.freeze({
      name: String(error?.name || "Error"),
      code: error?.code == null ? null : String(error.code),
      message: String(error?.message || error || "Built-in dataset kon niet worden geladen."),
    });
  }

  async function activateBuiltInDataset(datasetId) {
    if (destroyed) return false;
    const requestedDatasetId = String(datasetId ?? "").trim();
    if (!requestedDatasetId) return false;

    const requestId = ++activationRequest;
    datasetActivation = activationState(DATASET_ACTIVATION_STATUS.LOADING, {
      requestId,
      requestedDatasetId,
      activeDatasetId: runtimeStore.snapshot().source?.id ?? null,
      generation: runtimeStore.snapshot().generation ?? 0,
    });
    setDatasetControlBusy(true);

    try {
      const snapshot = await runtimeStore.loadBuiltIn(requestedDatasetId);
      if (destroyed || requestId !== activationRequest) return false;
      if (
        snapshot.source?.kind !== "builtin" ||
        snapshot.source?.id !== requestedDatasetId
      ) {
        throw new Error(
          `Built-in activatie committeerde niet de gevraagde dataset: ${requestedDatasetId}`,
        );
      }

      // Built-in switches from the status-bar selector must clear the same
      // external semantic/measurement state as the Load Explorer buttons.
      measurementService?.clearAll?.("builtin-shell-switch");
      onboardingService?.clear?.("builtin-shell-switch");

      datasetActivation = activationState(DATASET_ACTIVATION_STATUS.ACTIVE, {
        requestId,
        requestedDatasetId,
        activeDatasetId: snapshot.source.id,
        generation: snapshot.generation,
      });
      catalogueState=initialCatalogueState();
      setDatasetControlBusy(false);

      // The final RC3.23 dataset-switch controller forces the observable target
      // back to the source screen (`explore.load`) after a successful commit.
      router.go("explore.load", { source: "dataset-switch" });
      scheduleRender();
      return true;
    } catch (error) {
      if (destroyed || requestId !== activationRequest) return false;
      const snapshot = runtimeStore.snapshot();
      datasetActivation = activationState(DATASET_ACTIVATION_STATUS.ERROR, {
        requestId,
        requestedDatasetId,
        activeDatasetId: snapshot.source?.id ?? null,
        generation: snapshot.generation ?? 0,
        error: normalizedActivationError(error),
      });
      setDatasetControlBusy(false);
      scheduleRender();
      return false;
    }
  }

  function handleRuntimeEvent(event) {
    if (event?.type !== "DATASET_ACTIVATED") return;
    const snapshot = event.current ?? runtimeStore.snapshot();
    const matchingShellLoad =
      datasetActivation.status === DATASET_ACTIVATION_STATUS.LOADING &&
      snapshot.source?.kind === "builtin" &&
      snapshot.source?.id === datasetActivation.requestedDatasetId;
    if (matchingShellLoad) return;

    // External imports and direct Runtime Store activations are also real
    // source intents. They supersede an in-flight shell request and must clear
    // an older shell error without inventing a built-in selection or route.
    if (datasetActivation.status === DATASET_ACTIVATION_STATUS.LOADING) {
      activationRequest += 1;
    }
    datasetActivation = activationState(DATASET_ACTIVATION_STATUS.ACTIVE, {
      requestId: activationRequest,
      activeDatasetId: snapshot.source?.id ?? null,
      generation: snapshot.generation ?? 0,
    });
    catalogueState=initialCatalogueState();
    setDatasetControlBusy(false);
    scheduleRender();
  }

  function handleRouteEvent(event) {
    screenRegistry.transition(event);
    scheduleRender();
  }

  // Drawer visibility owns no research computation. Preserve content and its
  // controller/focus bindings; genuine route/context changes still render.
  function updateMenuVisibility() {
    const drawer=root.querySelector("#v18Drawer"),button=root.querySelector("#v18MenuBtn");
    if(drawer){drawer.hidden=!drawerOpen;drawer.classList.toggle("open",drawerOpen);}
    button?.setAttribute("aria-expanded",String(drawerOpen));
  }

  function bind() {
    root.querySelector("#v18MenuBtn")?.addEventListener("click", () => {
      drawerOpen = true;
      updateMenuVisibility();
    });
    root.querySelectorAll("[data-drawer-close]").forEach((control) =>
      control.addEventListener("click", () => {
        drawerOpen = false;
        updateMenuVisibility();
      }),
    );
    root.querySelector("#v18ContextToggle")?.addEventListener("click", () => {
      contextOpen = !contextOpen;
      render();
    });
    root.querySelector("#v25ContextClose")?.addEventListener("click",()=>{contextOpen=false;render();});
    root.querySelectorAll("[data-open-decision-context]").forEach(btn=>btn.addEventListener("click",()=>{contextOpen=true;render();const d=root.querySelector("[data-context-section=decision-lenses]");if(d){d.open=true;d.scrollIntoView({block:"start"});}}));
    const lensDraft=()=>{const el=root.querySelector("[data-lens-draft]");if(el)el.textContent=language==="en"?"Not applied yet; use the button to commit.":"Nog niet toegepast; gebruik de knop om vast te zetten.";};
    root.querySelector("#v29LensActive")?.addEventListener("change",lensDraft);
    root.querySelectorAll("[data-lens-compare]").forEach(el=>el.addEventListener("change",lensDraft));
    root.querySelector("[data-lens-apply]")?.addEventListener("click",()=>{const active=root.querySelector("#v29LensActive")?.value||"",comparisons=Array.from(root.querySelectorAll("[data-lens-compare]:checked"),el=>el.dataset.lensCompare);contextStore.setDecisionLens(selectionForLenses(active,comparisons));});
    root.querySelector("[data-lens-clear]")?.addEventListener("click",()=>contextStore.clear("decisionLens"));
    root.querySelectorAll("[data-v19-node]").forEach((control) =>
      control.addEventListener("click", () => {
        drawerOpen = false;
        const changed = router.go(control.dataset.v19Node, { source: "menu" });
        if (!changed) updateMenuVisibility();
      }),
    );
    root.querySelectorAll("[data-local-target]").forEach((control) =>
      control.addEventListener("click", () => {
        const target = control.dataset.localTarget;
        if (target) router.go(target, { source: "local-navigation" });
      }),
    );
    root.querySelector("[data-context-new-selection]")?.addEventListener("click", () => {
      contextStore.clearSelections();
    });
