 const relationList=types.length?`<ul>${types.slice(0,12).map(x=>`<li><span data-i18n-source-value>${e(x.type)}</span> · ${x.count}</li>`).join('')}</ul>`:`<p class="v29-copy">${nl?'Geen expliciete relation-types in deze selectie.':'No explicit relation types in this selection.'}</p>`;
 const sampleRelations=(samples.relations||[]).length?`<details><summary>${nl?'Voorbeeldrelaties uit de bron':'Sample source relations'} (${samples.relations.length})</summary><ul>${samples.relations.map(x=>`<li data-i18n-source-value>${e(x.id||'—')} · ${e(x.type||'—')} · ${e(x.sourceObjectId||'—')} → ${e(x.targetObjectId||'—')}</li>`).join('')}</ul></details>`:'';
 const sampleObjects=(samples.objects||[]).length?`<details><summary>${nl?'Gerelateerde objecten':'Related objects'} (${rel.objects||0})</summary><ul>${samples.objects.map(x=>`<li data-i18n-source-value>${e(x.id||'—')}${x.type?` · ${e(x.type)}`:''}${x.label?` · ${e(x.label)}`:''}</li>`).join('')}</ul></details>`:'';
 const sampleActors=(samples.actors||[]).length?`<details><summary>${nl?'Gerelateerde actoren/resources':'Related actors/resources'} (${rel.actors||0})</summary><ul>${samples.actors.map(x=>`<li data-i18n-source-value>${e(x.id||'—')}${x.type?` · ${e(x.type)}`:''}${x.label?` · ${e(x.label)}`:''}</li>`).join('')}</ul></details>`:'';
 return `<details class="v29-provenance" data-relationship-context data-relationship-status="${e(v.status)}"><summary>${nl?'Relationele context':'Relationship context'} · ${rel.relations||0} ${nl?'relaties':'relations'}</summary><p class="v29-copy">${nl?'Dit zijn expliciet gerelateerde bronrecords naast de primaire onderzoekspopulatie.':'These are explicit related source records alongside the primary research population.'}</p><dl class="v29-kv"><dt>${nl?'Primaire events':'Primary events'}</dt><dd>${v.primaryCounts?.events??0}</dd><dt>${nl?'Gerelateerde objecten':'Related objects'}</dt><dd>${rel.objects||0}</dd><dt>${nl?'Gerelateerde actoren':'Related actors'}</dt><dd>${rel.actors||0}</dd><dt>${nl?'Gerelateerde cases':'Related cases'}</dt><dd>${rel.cases||0}</dd></dl>${relationList}${sampleRelations}${sampleObjects}${sampleActors}${renderObjectDepth2(v.objectDepth2,language)}<p class="v29-note">${e(nl?'Gerelateerde bronrecords verklaren alleen de relationele context. Ze voegen geen events of cases toe aan de primaire onderzoekspopulatie, rekenen geen uitkomsten toe en impliceren geen causale invloed.':'Related source records explain relationship context only. They do not add events or cases to the primary research population, allocate outcomes, or imply causal influence.')}</p></details>`;
}
function renderDecisionAssessment(vm,language='nl'){
  if(!vm||vm.status==='NO_DATASET')return '';
  const nl=language!=='en',lang=nl?'nl':'en',idx=nl?0:1;
  const facts=new Map(vm.facts.map(f=>[f.id,f]));
  const supportingFactIds=new Set(['financial_records','risk_records','customer_records','resource_coverage','resource_usage','incomplete_cases','information_positions','resource_information','resource_norms']);
  const partialInput=typeof facts.get('resource_coverage')?.value==='number'&&facts.get('resource_coverage').value<1;
  const fact=id=>{
    const f=facts.get(id);if(!f)return '';
    // Short measurement-level labels remain visible. Long reasoning moves to
    // Explanation, but a resource subset must never look like a process total.
    const level=f.measurementLevel==='TASK_COHORT_CONTRACT'?(nl?'Taakcohort · meetcontract':'Task cohort · measurement contract'):f.measurementLevel.includes('RESOURCE')?(nl?'Resource-deelmeting':'Resource subset'):
      f.measurementLevel.startsWith('LINKED')?(nl?'Gekoppelde records':'Linked records'):(nl?'Onderzoekspopulatie':'Research population');
    return `<div class="v29-fact" data-decision-fact="${e(id)}" data-value="${f.value??''}" data-measurement-level="${e(f.measurementLevel)}" data-measurement-status="${e(f.measurementStatus||f.status)}"><dt>${e(f[lang])}</dt><dd><strong>${f.measurementLevel==='TASK_COHORT_CONTRACT'?productivityValue(f.value,f.unit,language):num(f.value,f.unit,language)}</strong><small>${f.value===null?(nl?'Niet vastgesteld':'Not established'):e(level)}${f.value!==null&&['resource_cost','resource_effort'].includes(id)?' · '+resourceMetricStatus({status:f.measurementStatus||(partialInput?'PARTIAL':'RECORDED')},language):''}</small></dd></div>`;
  };
  const ref=x=>`<article class="v29-reference"><b>${x.role==='primary'?(nl?'Primaire aanleiding':'Primary starting reference'):(nl?'Vergelijkingsreferentie':'Comparison reference')}</b><p data-i18n-source-value>${e(x.label)} · ${e(x.id)}</p><dl class="v29-kv"><dt>${nl?'Doelwaarde / regel':'Target / rule'}</dt><dd>${x.target?e(`${x.target.operator||''} ${typeof x.target.value==='number'?num(x.target.value,x.target.unit,language):x.target.value} ${['ratio','EUR'].includes(x.target.unit)?'':x.target.unit||''}`):(nl?'Zie bronregel':'See source rule')}</dd><dt>Scope</dt><dd>${e(x.scope?.scope||'—')} · ${e(x.scope?.scopeRef||'—')}</dd><dt>${nl?'Meetperiode':'Measurement period'}</dt><dd>${x.measurementPeriod?e(`${x.measurementPeriod.start} → ${x.measurementPeriod.endExclusive}`):'—'}</dd><dt>${nl?'Bron':'Source'}</dt><dd>${e(x.source?.sourceId||'—')}</dd><dt>${nl?'Toepasselijkheid':'Applicability'}</dt><dd>${e(nl?({'APPLICABLE':'Van toepassing','NOT_APPLICABLE':'Niet van toepassing','UNKNOWN':'Onbekend','APPLICABILITY_UNKNOWN':'Onbekend'}[x.applicability?.status]||'Niet vastgesteld'):(x.applicability?.status||'Not established'))}</dd></dl><p class="v29-copy">${nl?'Alleen referentie; geen nieuw berekend doelresultaat. Een proces- of resourcecijfer is geen ondernemingscijfer.':'Reference only; no newly calculated goal result. A process or resource figure is not an enterprise figure.'}</p></article>`;
  const invalid=['INVALID_SCOPE','UNSUPPORTED_LENS'].includes(vm.status);
  const productivity=renderProductivity(vm.productivity,language,{location:'integrated'});
  const research=`<section class="v29-research-explanation" data-screen-explanation data-i18n-resolved><h3>${nl?'Bestuurlijke vergelijking: onderbouwing':'Decision comparison: evidence'}</h3><button type="button" class="v29-button" data-open-decision-context>${nl?'Perspectieven wijzigen in Context':'Change perspectives in Context'}</button><p class="v29-copy">${nl?'De perspectieven verwijzen naar één feitenregister. De resource is een benoemde deelpopulatie; andere cijfers blijven op onderzoeksniveau. Geen totaalscore of keuze van de beste interventie.':'Perspectives refer to one fact register. The resource is a labelled subset; other figures retain their research level. No aggregate score or choice of best intervention.'}</p><div class="v29-context-line"><span data-research-scope-label>${e(decisionScopeLabel(vm.context,language))}</span><span>${e(vm.context.observedPeriod?.label||'FULL')}</span>${vm.context.focus?`<span data-i18n-source-value>${e(vm.context.focus.label||vm.context.focus.id)}</span>`:''}</div>${renderRelationshipContext(vm.relationshipContext,language)}<details class="v29-references" data-review-detail="decision-references"><summary>${nl?'Gedeelde doelen, normen en regels':'Shared goals, norms and rules'} (${vm.references.length})</summary>${vm.references.map(ref).join('')||`<p>${nl?'Geen referentie gekozen. Je kunt ook vanuit een proces of object onderzoeken.':'No reference selected. You may start from a process or object.'}</p>`}</details><details class="v29-provenance" data-review-detail="decision-provenance"><summary>${nl?'Bronbasis en meetdefinities':'Source basis and measurement definitions'}</summary><p>${nl?'Bron-ID-lijsten zijn beperkte steekproeven, geen volledige populatielijst. Bron, scope en query definiëren de meting. Uitgesloten onderbouwing wordt niet alsnog gebruikt.':'Source-ID lists are limited samples, not complete population lists. Source, scope and query define the measurement. Excluded evidence is not reused.'}</p><pre>${e(JSON.stringify({sourceKey:vm.sourceKey,populationKey:vm.populationKey,population:vm.population,included:vm.included,applicability:vm.applicability},null,2))}</pre>${vm.facts.map(f=>`<details><summary>${e(f[lang])} · ${isDecisionMeasurement(f)?measuredValue(f,language):f.measurementLevel==='TASK_COHORT_CONTRACT'?productivityValue(f.value,f.unit,language):num(f.value,f.unit,language)}</summary><pre>${e(JSON.stringify(f,null,2))}</pre></details>`).join('')}</details><p class="v29-copy">${nl?'Gebruik de bestaande knop om de interventiecontext vast te zetten. Context- of onderbouwingswijzigingen maken de vastzetting ongeldig. De huidige getallen zijn geen berekende interventie-effecten; simulatieaannamen en effecten blijven afzonderlijk.':'Use the existing button to freeze intervention context. Context or evidence changes invalidate the snapshot. These figures are not calculated intervention effects; simulation assumptions and effects remain separate.'}</p></section>`;
  return `<section class="v29-assessment" data-decision-assessment data-assessment-status="${e(vm.status)}" data-population-key="${e(vm.populationKey||'')}" data-i18n-resolved><h3 class="v29-result-heading">${nl?'Beoordeling per perspectief':'Assessment by perspective'}</h3><div class="v29-body">${invalid?`<p role="alert">${nl?'Deze context kan niet worden beoordeeld.':'This context cannot be assessed.'}</p>`:!vm.lenses.length?`<p>${nl?'Kies een perspectief via Context om uitkomsten naast elkaar te bekijken.':'Choose a perspective through Context to compare results.'}</p>`:`<div class="v29-lenses">${vm.lenses.map(l=>`<article class="v29-lens" data-decision-lens="${e(l.id)}" data-lens-population="${e(l.populationKey)}"><h4>${e(l[lang])}</h4>${renderLensMeasurements(l.factIds,facts,language)}${renderSourceFieldDispositions(vm,language,l.id)}<dl class="v29-facts">${l.factIds.filter(id=>!supportingFactIds.has(id)&&!isDecisionMeasurement(facts.get(id))).map(fact).join('')||`<p>${nl?'Geen bruikbare onderbouwing opgenomen.':'No usable evidence included.'}</p>`}</dl><details class="v29-lens-explanation" data-lens-explanation="${e(l.id)}" data-review-detail="lens-explanation-${e(l.id)}"><summary>${nl?'Meetbasis en toelichting':'Measurement basis and explanation'}</summary><div class="v29-lens-body"><p>${e(l.question[idx])}</p><p class="v29-note">${e(l.limit[idx])}</p><dl class="v29-facts">${l.factIds.filter(id=>supportingFactIds.has(id)).map(fact).join('')}</dl><details><summary>${nl?'Thematisch gerelateerde bronreferenties':'Thematically related source references'} (${l.thematicReferences.length})</summary><p class="v29-copy">${nl?'Geordend op bronmetadata of cataloguscategorie; geen filter op waarnemingen of automatische toepasselijkheid.':'Grouped by source metadata or catalogue category; not a filter on observations or automatic applicability.'}</p><ul>${l.thematicReferences.map(r=>`<li data-i18n-source-value>${e(r.name)} · ${e(r.id)}</li>`).join('')}</ul></details></div></details></article>`).join('')}</div>`}${invalid?'':renderUnassignedMeasurements(vm,facts,language)+(!vm.lenses.length?renderSourceFieldDispositions(vm,language):'')+productivity}</div></section>${research}`;
}
return Object.freeze({renderDecisionLensControls,renderDecisionAssessment,decisionScopeLabel});

},


"src/presentation/screens/screen-information-hierarchy.js":function(load){
"use strict";
const {resourceMetric,resourceMetricStatus}=load("src/application/resource-usage-measurement.js");
const {escapeHtml:e}=load("src/presentation/html.js");
const {getScreenInformationContract}=load("src/product-contract/screen-information-contract.js");

// Presentation only. Configuration, membership, measurements and frozen
// assessment state retain their existing owners. Never infer applicability
// from the text of a translated label.
const INFORMATION_HIERARCHY_VERSION="pirl.screen-information-hierarchy.v2";
const EXPLANATION_SELECTORS=[
  'h2 + p.sub',
  '.research-scope-summary', '.integrated-scope-grid', 'details[data-measurement-coverage]',
  '.value-heading > .sub', '.behavior-heading > .sub', '.integrated-screen > .sub', '.ip-panel > .sub',
  '.value-scope', '.behavior-scope', '.ip-scope', '.advice-scope',
  '.integrated-boundary', '.value-boundary', '.behavior-boundary',
  '.advice-boundary', '.review-boundary', '.export-boundary',
  '.ip-notice.boundary', '.process-function-callout', '.object-function-callout',
  '.behavior-function', '.variant-function', '[data-screen-explanation]',
  '[data-supporting-analysis]'
];

/** Only route-relevant, already computed subset results; no copied context chips.
 * Source-level measurement coverage is NOT converted to productivity. */
function renderFocusedResults(vm,routeId,language='nl') {
  if(!vm?.visible||vm.status==='RETAINED_ONLY')return '';
  const family=routeId.startsWith('analysis.value.')?'value':routeId.startsWith('analysis.behavior.')?'behavior':routeId.startsWith('analysis.ip.')?'ip':null;
  if(!family)return '';
  const nl=language!=='en',m=vm.measurement||{},p=vm.participation||{},i=vm.information||{};
  const em=resourceMetric(m,"effort"),cm=resourceMetric(m,"cost");const hasUsage=em.value!==null||cm.value!==null;
  const fmt=(v,unit)=>v==null?'—':new Intl.NumberFormat(nl?'nl-NL':'en-GB',unit==='EUR'?{style:'currency',currency:'EUR'}:{maximumFractionDigits:unit==='hours'?1:0}).format(v)+(unit==='hours'?(nl?' u':' h'):'');
  const rows=family==='value'?
    [['direct-cost',nl?'Geregistreerde directe kosten':'Recorded direct costs',cm.value,'EUR'],['effort-hours',nl?'Geregistreerde actieve inzet':'Recorded active effort',em.value==null?null:em.value/3600,'hours']]:
    family==='behavior'?[['participation-events',nl?'Directe deelnamegebeurtenissen':'Direct participation events',p.events,'count'],['effort-hours',nl?'Geregistreerde actieve inzet':'Recorded active effort',em.value==null?null:em.value/3600,'hours']]:
    [['decisions',nl?'Directe beslissingen':'Direct decisions',i.decisions,'count'],['information-positions',nl?'Gekoppelde informatieposities':'Linked information positions',i.informationPositions,'count']];
  return `<section class="screen-subset-results" data-focused-results="${family}" data-i18n-resolved><h3>${nl?'Geselecteerde resource · deelmeting':'Selected resource · subset measurement'}</h3><dl>${rows.map(([id,label,value,unit])=>`<div><dt>${e(label)}</dt><dd data-subset-result="${id}" data-value="${value??''}">${fmt(value,unit)}${["direct-cost","effort-hours"].includes(id)?`<small data-resource-field-status="${(id==="direct-cost"?cm:em).status}">${resourceMetricStatus(id==="direct-cost"?cm:em,language)}</small>`:""}</dd></div>`).join('')}</dl>${family==='ip'?'':`<small data-measurement-status="${hasUsage?'PARTIAL_RECORDED_INPUT':'NOT_ESTABLISHED'}">${hasUsage?`${nl?'Gebruiksmeting bij':'Usage recorded for'} ${m.usageEvents} / ${p.events} ${nl?'deelnamegebeurtenissen met inzet én kosten':'participation events with effort and costs'}${m.independent?` · ${nl?'Inzet':'Effort'}: ${em.eventCount} / ${p.events}; ${nl?'kosten':'costs'}: ${cm.eventCount} / ${p.events}`:''}`:(nl?'Inzet en kosten niet vastgesteld':'Effort and costs not established')}</small>`}</section>`;
}

function renderSupportingAnalysis(markup,language='nl') {
  if(!markup)return '';
  return `<section data-supporting-analysis><h3>${language==='en'?'Selected focus: measurements and attribution':'Geselecteerde focus: metingen en toerekening'}</h3>${markup}</section>`;
}

/** No mutable fields are allowed in read-only accountability. Hidden controls
 * also count: future additions cannot silently smuggle settings into evidence. */
function hasEditableControls(node){
  return node.matches?.('input,select,textarea,[contenteditable="true"],[data-calculation-settings],[data-calculation-settings-actions]') ||
    Boolean(node.querySelector?.('input,select,textarea,[contenteditable="true"],[data-calculation-settings],[data-calculation-settings-actions]')) ||
    [...(node.querySelectorAll?.('button')||[])].some(b=>!b.matches('[data-open-decision-context],[data-readonly-action]'));
}
function protectedResult(node){
 return node.matches?.('.warn,.warning,.error,[role="alert"],[data-keep-visible]') ||
   Boolean(node.querySelector?.('[role="alert"],.error,[data-keep-visible]')) ||
   node.dataset?.researchScopeStatus==='INVALID';
}

/** Reparent explicit components before binding. Never remove content, copy
 * controls, change a store, or use translated text to decide semantic roles. */
function applyScreenInformationHierarchy(root,{language='nl',routeId=''}={}) {
 const main=root.querySelector('#main-content');if(!main)return null;
 if(main.dataset.informationHierarchy===INFORMATION_HIERARCHY_VERSION)return null;
 const contract=getScreenInformationContract(routeId),doc=main.ownerDocument,nl=language!=='en';
 main.dataset.informationHierarchy=INFORMATION_HIERARCHY_VERSION;
 main.dataset.informationRoute=routeId;
 main.dataset.informationContract=contract?'DECLARED':'UNREVIEWED_ROUTE';
 main.dataset.informationPrimaryRole=contract?.primaryRole||'UNKNOWN';
 const issues=[];if(!contract)issues.push('UNREVIEWED_ROUTE');
 const heading=main.querySelector('h2');
 const tools=doc.createElement('div');tools.className='screen-information-tools';tools.dataset.screenInformationTools='';tools.dataset.i18nResolved='';
 function disclosure(kind,label,description){
   const d=doc.createElement('details');d.className=kind==='settings'?'screen-calculation-settings':'screen-accountability';
   d.id=kind==='settings'?'screen-calculation-settings':'screen-accountability';
   if(kind==='settings')d.dataset.screenCalculationSettings=INFORMATION_HIERARCHY_VERSION;else d.dataset.screenAccountability=INFORMATION_HIERARCHY_VERSION;
   d.dataset.reviewDetail=d.id;
   const sum=doc.createElement('summary');sum.textContent=label;sum.dataset.i18nResolved='';d.append(sum);
   const body=doc.createElement('div');body.className='screen-accountability-body';d.append(body);
   const note=doc.createElement('p');note.className='screen-information-purpose';note.dataset.i18nResolved='';note.textContent=description;body.append(note);
   return {d,sum,body,contentCount:0};
 }
 const settings=disclosure('settings',nl?'Berekeningsinstellingen':'Calculation settings',nl?'Keuzes die de uitkomst van dit scherm beïnvloeden. De app-brede selectie beheer je via Context.':'Choices that affect this screen’s result. Manage the app-wide selection in Context.');
 const explanation=disclosure('accountability',nl?'Verantwoording':'Explanation & evidence',nl?'Alleen-lezen: de gebruikte meetbasis, brongegevens en uitleg bij deze uitkomst. Hier wijzig je geen filters of berekeningskeuzes.':'Read-only: the measurement basis, sources and explanation for this result. No filters or calculation choices are changed here.');
 const settingNodes=[...main.querySelectorAll('[data-calculation-settings]')];
 for(const node of settingNodes.filter(n=>!settingNodes.some(p=>p!==n&&p.contains(n)))){
   if(contract?.calculationSettings!=='APPLICABLE_WHEN_READY'){issues.push('UNREVIEWED_SETTINGS_COMPONENT');continue;}
   settings.body.append(node);settings.contentCount++;
 }
 const actionNodes=[...main.querySelectorAll('[data-calculation-settings-actions]')];
 for(const node of actionNodes){
   if(contract?.calculationSettings!=='APPLICABLE_WHEN_READY'||!settings.contentCount){issues.push('UNREVIEWED_SETTINGS_ACTION');continue;}
   settings.body.append(node);settings.contentCount++;
 }
 const selectors=[...EXPLANATION_SELECTORS,...(contract?.explanationSelectors||[])];
 const candidates=contract?.notApplicable?[]:[...main.querySelectorAll(selectors.join(','))];
 const targets=candidates.filter(n=>!candidates.some(p=>p!==n&&p.contains(n)));
 const hints=[];
 for(const node of targets){
   // This legacy selector changes shared scope; keep its existing state owner.
   if(node.matches('[data-review-detail="legacy-integrated-scope"]')){
     const host=root.querySelector('#v26ProcessSelect')?.closest('.v26-block-body');
     if(host){host.append(node);continue;}
     issues.push('GLOBAL_SCOPE_HOST_MISSING');continue;
   }
   if(node.closest('[data-calculation-settings]'))continue;
   if(protectedResult(node))continue;
   if(hasEditableControls(node)){node.dataset.informationUnclassified='EDITABLE_EXPLANATION';issues.push('EDITABLE_EXPLANATION');continue;}
   if(node.matches('.research-scope-summary')&&node.querySelector('[data-research-scope-issues]'))hints.push(nl?'Afbakeningssignalen beschikbaar':'Scope issues available');
   if(node.dataset.measurementCompleteness==='PARTIAL')hints.push(nl?'Ontbrekende meetwaarden':'Missing measurements');
   explanation.body.append(node);explanation.contentCount++;
 }
 function attach(area,kind,label){
   if(!area.contentCount)return;
   main.append(area.d);
   const back=doc.createElement('button');back.type='button';back.className='screen-accountability-button';back.dataset.i18nResolved='';
   back.setAttribute(kind==='settings'?'data-close-settings':'data-close-accountability','');back.textContent=nl?'Terug naar uitkomsten':'Back to results';
   back.addEventListener('click',()=>{area.d.open=false;(heading||main).scrollIntoView({block:'start',behavior:'auto'});});area.body.prepend(back);
   const button=doc.createElement('button');button.type='button';button.className='screen-accountability-button';button.textContent=label;
   button.setAttribute(kind==='settings'?'data-open-settings':'data-open-accountability','');button.setAttribute('aria-controls',area.d.id);button.setAttribute('aria-expanded','false');
   button.addEventListener('click',()=>{area.d.open=true;button.setAttribute('aria-expanded','true');if(kind==='settings')for(const link of main.querySelectorAll('[data-open-settings-shortcut]'))link.setAttribute('aria-expanded','true');area.d.scrollIntoView({block:'start',behavior:'auto'});area.sum.focus({preventScroll:true});});
   area.d.addEventListener('toggle',()=>{
     button.setAttribute('aria-expanded',String(area.d.open));
     if(kind==='settings')for(const link of main.querySelectorAll('[data-open-settings-shortcut]'))link.setAttribute('aria-expanded',String(area.d.open));
   });tools.append(button);
   if(kind==='settings')for(const link of main.querySelectorAll('[data-open-settings-shortcut]')){
     link.setAttribute('aria-controls',area.d.id);link.setAttribute('aria-expanded','false');
     link.addEventListener('click',()=>button.click());
   }
 }
 attach(settings,'settings',nl?'Berekeningsinstellingen':'Calculation settings');
 attach(explanation,'accountability',nl?'Verantwoording':'Explanation & evidence');
 if(hints.length){const note=doc.createElement('span');note.dataset.accountabilityAttention='';note.textContent=[...new Set(hints)].join(' · ');tools.append(note);}
 if(tools.childElementCount){if(heading)heading.insertAdjacentElement('afterend',tools);else main.prepend(tools);}
 main.dataset.informationIssues=JSON.stringify(issues);
 main.dataset.informationExplanation=explanation.contentCount?'READ_ONLY':(contract?.notApplicable?'NOT_APPLICABLE':'NO_EXPLANATION_IN_THIS_STATE');
 return {version:INFORMATION_HIERARCHY_VERSION,routeId,primaryRole:contract?.primaryRole,settings:settings.contentCount,moved:explanation.contentCount,issues,collapsed:true};
}
return Object.freeze({INFORMATION_HIERARCHY_VERSION,renderFocusedResults,renderSupportingAnalysis,hasEditableControls,protectedResult,applyScreenInformationHierarchy});

},
"src/product-contract/screen-information-contract.js":function(load){
