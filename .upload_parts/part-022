  if(otherMissing.length) blocks.push(`<div class="conformance-note bad"><b>Ontbrekend in uitvoering</b><div>${otherMissing.map((item) => `<span data-i18n-source-value>${escapeHtml(item.id)}</span>`).join("<br>")}</div></div>`);
  if (comparison.missing?.length && !(comparison.missingDetails||[]).length) blocks.push(`<div class="conformance-note bad"><b>Ontbrekend in uitvoering</b><div>${comparison.missing.map((id) => `<span data-i18n-source-value>${escapeHtml(id)}</span>`).join("<br>")}</div></div>`);
