const SCENARIO_CONTEXT_VERSION='pirl.simulation-context.v1';
// These are measurement/model contracts, not dataset or persona exceptions.
const SCENARIO_OUTCOMES=deepFreeze([
 {id:'cost',nl:'Uitvoeringskosten',en:'Execution costs',unit:'EUR',lenses:['finance','operations'],aggregation:'TOTAL'},
 {id:'income',nl:'Opbrengst',en:'Income',unit:'EUR',lenses:['finance'],aggregation:'TOTAL'},
 {id:'risk',nl:'Verwacht verlies',en:'Expected loss',unit:'EUR',lenses:['risk'],aggregation:'TOTAL'}
]);
