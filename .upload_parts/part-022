// An explicit route inventory, not a claim about unexecuted browser states.
// Navigation, source setup, inspection and human review have their own primary
// purpose: the common contract must not turn these into calculated dashboards.
const VERSION='pirl.screen-information-contract.v2';
const definitions={
 'home':['NAVIGATION','Navigation has no result calculation or separate calculation settings.'],
 'explore.load':['SOURCE_SETUP','Source import/activation is the primary action; source changes use the existing global context owner.'],
 'explore.dataset':['RECORD_INSPECTION','Collection/search/paging are local inspection; source and membership stay centrally owned.'],
 'explore.norms':['REFERENCE_RESULTS','Reference inspection and measured results; source applicability and measurement gaps remain distinct.'],
 'explore.objects':['OBJECT_INSPECTION','Graph view controls are local; existing explicit entity-selection actions keep their context semantics.'],
