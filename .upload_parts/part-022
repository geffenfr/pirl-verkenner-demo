"use strict";

function bindBehaviorAnalysisInteractions({ root, controller, navigate = () => false, onFocusSnapshot = () => {}, onCommit = () => {} } = {}) {
  if (!root || !controller) throw new TypeError("Behavior Analysis binder requires root and controller");
  const removers = [];
  const on = (target, type, handler, options) => {
    target?.addEventListener?.(type, handler, options);
    if (target) removers.push(() => target.removeEventListener(type, handler, options));
  };
  const commit = (action, fn) => {
    onFocusSnapshot(null);
    const changed = Boolean(fn());
    onCommit({ action, changed, focusSnapshot: null });
    return changed;
  };
  const process = root.querySelector("[data-behavior-process]");
  on(process, "change", (event) => {
    const value = event.currentTarget.value || null;
    event.currentTarget.blur?.();
    return value ? commit("behavior-process", () => controller.selectProcess(value)) : commit("behavior-process-clear", () => controller.clearContextProcess());
  });
  for (const card of root.querySelectorAll?.("[data-behavior-pattern]") || []) {
    on(card, "click", (event) => {
      event.preventDefault();
      card.blur?.();
      return commit("behavior-pattern", () => controller.selectPattern(Number(card.dataset.behaviorPattern)));
    });
  }
  return Object.freeze({
    captureFocus() { return null; },
    restoreFocus() { return false; },
    destroy() { for (const remove of removers.splice(0)) remove(); },
  });
}






return Object.freeze({"bindBehaviorAnalysisInteractions":bindBehaviorAnalysisInteractions});
},
