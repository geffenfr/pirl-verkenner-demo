 const participationKeys=new Set(rows.map(eventKey));
 for(const [ei,event] of rows.entries()){
  const eid=eventKey(event,ei),activityId=text(event.activity_id||event.event_type)||'UNKNOWN';
  const activity=activities.get(activityId)||{id:activityId,records:0,effortRecords:0,costRecords:0,seconds:null,cost:null};
  let used=false;
  for(const [ui,u] of arr(event.resource_usage).entries()){
   if(!u||text(u.actor_id)!==aid)continue;
   const ref={eventId:eid,usageIndex:ui};
   for(const [key,def] of Object.entries(fields)){
    const value=u[def.field],s=state[key];
    if(value===null||value===undefined){s.missing.push(ref);continue;}
    if(!numeric(value)){s.invalid.push({...ref,reason:'NON_FINITE_NON_NUMERIC_OR_NEGATIVE'});continue;}
