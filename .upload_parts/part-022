 comparisonBasis:{kind:'SAME_ASSUMED_HORIZON_WORKLOAD',factor,calendarScaling:false,assumption:c.workloadAssumption.explanation},
 gaps:['NO_CAUSAL_OR_FORECAST_VALIDATION','NO_QUALITY_CUSTOMER_CONTROL_DEPENDENCY_MODEL','NO_RESOURCE_OR_PRODUCTIVITY_EFFECT_MODEL'],
 modelId:p.modelId,sourceKey:p.sourceKey,scopeKey:p.scopeKey,ranking:null,actionAuthorized:false,forecastValidated:false,scenarioOnly:true});
