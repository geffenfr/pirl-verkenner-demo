 if(!finite(factor)||factor<=0||factor>1000)fail('INVALID_VOLUME_FACTOR');
 if(typeof d.basisNote!=='string'||d.basisNote.trim().length<8)fail('BASIS_EXPLANATION_REQUIRED');
 if(d.sameWorkload!==true)fail('COMPARABLE_WORK_CONFIRMATION_REQUIRED');
 const ids=arr(d.targetMetrics);if(!ids.length||new Set(ids).size!==ids.length||ids.some(id=>!SCENARIO_OUTCOMES.some(m=>m.id===id)))fail('INVALID_TARGET_METRICS');
 if(ids.some(id=>p.included?.value!==true||!finite(p.baseline?.[id])||!finite(p.fx?.[id])))fail('TARGET_BASELINE_OR_MODEL_UNAVAILABLE');
 if(ids.some(id=>finite(factor)&&finite(p.baseline?.[id])&&!Number.isSafeInteger(Math.round(p.baseline[id]*factor*100))))fail('UNSAFE_FINANCIAL_RANGE');
 if(issues.length)return deepFreeze({status:'INVALID',context:null,issues});
 return deepFreeze({status:'READY',issues:[],context:{schema:SCENARIO_CONTEXT_VERSION,sourceKey:p.sourceKey,scopeKey:p.scopeKey,
 observedPeriod:clone(obs),availableObservation:clone(p.availableObservation||null),researchContext:clone(p.researchContext||null),
 interventionIds:arr(p.interventions).map(x=>x.id),interventionStart:start,
 simulationHorizon:{startInclusive:horizon.startInclusive,endExclusive:horizon.endExclusive,startDate:d.horizonStart,endDateInclusive:d.horizonEnd,timeZone:zone},
 workloadAssumption:{kind:'EXPLICIT_COMPARABLE_VOLUME_FACTOR',factor,explanation:d.basisNote.trim(),userConfirmed:true,calendarScaling:false,constantTaskMixAssumed:true},
 targetMetrics:ids.slice(),modelId:p.modelId,epistemicStatus:'USER_ASSUMED_SCENARIO_NOT_FORECAST',actionAuthorized:false}});
}
// Exact supported formulas only. Units and scopes must match; text/category is
// never sufficient to turn an enterprise reference into a local verdict.
function referenceImpact(ref,ctx,outcomes,p){
 const out={id:ref.id,kind:ref.kind,label:ref.label,target:clone(ref.target||null),source:clone(ref.source||null),scope:clone(ref.scope||null),measurementPeriod:clone(ref.measurementPeriod||null),metric:ref.metric||null,
 status:'NOT_COMPARABLE',reason:null,projectedValue:null,goalAchievement:'NOT_ESTABLISHED',epistemicStatus:'SIMULATED_NOT_OBSERVED'};
 const fail=reason=>({...out,reason});
 if(ref.status!=='REFERENCE_ONLY')return fail('SOURCE_REFERENCE_NOT_RESOLVED');
 if(ref.applicability?.status!=='APPLICABLE')return fail('APPLICABILITY_NOT_ESTABLISHED');
 const rc=ctx.researchContext||{},scope=ref.scope||{},local=rc.process?.id,selected=p.selection||{};
 if(rc.case||selected.entity||p.selectedOutcome)return fail('LOCAL_SUBSET_NOT_TARGET_POPULATION');
 if(/ENTERPRISE|ORGANIZ/i.test(scope.scope||'')) {if(local||selected.kind!=='dataset')return fail('ENTERPRISE_TARGET_NOT_LOCAL_PROCESS');}
 else if(/PROCESS/i.test(scope.scope||'')){if(!local||scope.scopeRef!==local||selected.kind!=='process')return fail('PROCESS_TARGET_SCOPE_MISMATCH');}
 else return fail('TARGET_SCOPE_NOT_ESTABLISHED');
 const mp=ref.measurementPeriod,hs=ctx.simulationHorizon.startInclusive,he=ctx.simulationHorizon.endExclusive;
 if(!mp?.start||!mp?.endExclusive||Date.parse(mp.start)!==Date.parse(hs)||Date.parse(mp.targetEndExclusive||mp.endExclusive)!==Date.parse(he))return fail('TARGET_PERIOD_NOT_SIMULATION_HORIZON');
