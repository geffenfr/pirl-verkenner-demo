function validDate(s){if(typeof s!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(s)||Number(s.slice(0,4))<1900)return false;const d=new Date(s+'T00:00:00Z');return finite(d.getTime())&&d.toISOString().slice(0,10)===s;}
function resolveScenarioContext(draft,projection){
 const issues=[];const fail=code=>issues.push(code);
 if(draft?.enabled!==true)return deepFreeze({status:'LEGACY_SENSITIVITY',context:null,issues:[]});
 const d=draft||{},p=projection||{},obs=p.researchContext?.observedPeriod||{mode:'FULL',startInclusive:null,endExclusive:null,label:'FULL'};
 const zone=p.sourceTimeZone;try {if(!zone)throw Error();new Intl.DateTimeFormat('en',{timeZone:zone}).format();}catch(_){fail('TIME_ZONE_REQUIRED');}
 for(const k of ['interventionStart','horizonStart','horizonEnd'])if(!validDate(d[k]))fail('INVALID_'+k.toUpperCase());
 if(issues.length)return deepFreeze({status:'INVALID',context:null,issues});
 if(d.horizonEnd<d.horizonStart)fail('END_BEFORE_START');
 // v1 models a complete horizon under the chosen intervention, not a ramp-up.
 if(d.interventionStart>d.horizonStart)fail('INTERVENTION_AFTER_HORIZON_START');
 let horizon,start;
 try {horizon=customPeriod(d.horizonStart,d.horizonEnd,zone);start=customPeriod(d.interventionStart,d.interventionStart,zone).startInclusive;}catch(_){fail('INVALID_CALENDAR_RANGE');}
 const observedEnd=obs.mode==='FULL'?p.availableObservation?.endExclusive:obs.endExclusive;
 if(!observedEnd||!finite(Date.parse(observedEnd)))fail('OBSERVED_END_UNKNOWN');
 else if(start&&Date.parse(start)<Date.parse(observedEnd))fail('INTERVENTION_OVERLAPS_OBSERVATIONS');
