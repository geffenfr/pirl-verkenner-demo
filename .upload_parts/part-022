return Object.freeze({"renderProcessExplorer":renderProcessExplorer});
},
"src/presentation/screens/variant-explorer-interactions.js":function(load){
"use strict";

function captureVariantFocus(root) {
  const active = root?.ownerDocument?.activeElement;
  if (!active || !root.contains(active)) return null;
  if (active.matches?.("[data-variant-process]")) return { kind: "process" };
  if (active.matches?.("[data-variant-select]")) return { kind: "variant" };
  return null;
}
function restoreVariantFocus(root, snapshot) {
  if (!snapshot) return false;
  const target = snapshot.kind === "process" ? root.querySelector("[data-variant-process]") : snapshot.kind === "variant" ? root.querySelector("[data-variant-select]") : null;
  target?.focus?.();
  return Boolean(target);
}
function bindVariantExplorerInteractions({ root, controller, onFocusSnapshot = () => {}, onCommit = () => {} } = {}) {
  if (!root || !controller) throw new TypeError("Variant Explorer binder requires root and controller");
  const removers = [];
  const on = (target, type, handler, options) => { target?.addEventListener?.(type, handler, options); if (target) removers.push(() => target.removeEventListener(type, handler, options)); };
  const invoke = (action, fn, focus = captureVariantFocus(root)) => { onFocusSnapshot(focus); const changed = Boolean(fn()); onCommit({ action, changed, focusSnapshot: focus }); return changed; };

  const process = root.querySelector("[data-variant-process]");
  on(process, "change", (event) => {
    const value = event.currentTarget.value || null;
    event.currentTarget.blur?.();
    if (!value) return invoke("variant-process-clear", () => controller.clearContextProcess(), null);
    return invoke("variant-process", () => controller.selectProcess(value), null);
  });
  const select = root.querySelector("[data-variant-select]");
  on(select, "change", (event) => { const index = Number(event.currentTarget.value); event.currentTarget.blur?.(); return invoke("variant-select", () => controller.selectVariant(index), null); });
  for (const card of root.querySelectorAll?.("[data-variant-index]") || []) {
    on(card, "click", (event) => { event.preventDefault(); card.blur?.(); return invoke("variant-card", () => controller.selectVariant(Number(card.dataset.variantIndex)), null); });
  }
  const viewport = root.querySelector("[data-variant-viewport]");
  if (viewport) {
    const vm = controller.getViewModel();
    viewport.scrollLeft = Number(vm.controls?.scroll?.left || 0);
    viewport.scrollTop = Number(vm.controls?.scroll?.top || 0);
  }
  for (const button of root.querySelectorAll?.("[data-variant-action]") || []) {
    on(button, "click", (event) => {
      event.preventDefault(); button.blur?.();
      const scroll = { left: Number(viewport?.scrollLeft || 0), top: Number(viewport?.scrollTop || 0) };
      const action = button.dataset.variantAction;
      if (action === "zoom-out") return invoke(action, () => controller.zoom(1 / 1.2, scroll), null);
      if (action === "zoom-in") return invoke(action, () => controller.zoom(1.2, scroll), null);
      if (action === "zoom-100") return invoke(action, () => controller.resetScale(scroll), null);
      if (action === "fit") {
        const flow = root.querySelector("[data-variant-flow]");
        const natural = Math.max(Number(flow?.scrollWidth || 0), (root.querySelectorAll?.("[data-variant-step]")?.length || 0) * 212, 620);
        return invoke(action, () => controller.fitScale(viewport?.clientWidth || 0, natural), null);
      }
      return false;
    });
  }
  return Object.freeze({
    captureFocus() { return captureVariantFocus(root); },
    restoreFocus(snapshot) { return restoreVariantFocus(root, snapshot); },
    destroy() { for (const remove of removers.splice(0)) remove(); },
  });
}


return Object.freeze({"captureVariantFocus":captureVariantFocus,"restoreVariantFocus":restoreVariantFocus,"bindVariantExplorerInteractions":bindVariantExplorerInteractions});
},
"src/presentation/screens/variant-explorer.js":function(load){
"use strict";
const {currentLanguage}=load("src/presentation/i18n.js");
const {renderResearchScopeSummary,renderExecutionEvidence,renderIncompleteExecutionNotice}=load("src/presentation/screens/research-scope-presentation.js");
const {escapeHtml}=load("src/presentation/html.js");

function sourceDisplayLabel(displayLabels, language, fallback) {
  const preferred = language === "en" ? displayLabels?.en : displayLabels?.nl;
  const secondary = language === "en" ? displayLabels?.nl : displayLabels?.en;
  return String(preferred || secondary || fallback || "—");
}
function displaySequence(variant, language) {
  return (variant?.steps || []).map(step => sourceDisplayLabel(step.displayLabels, language, step.label || step.id)).join(" → ") || String(variant?.sequence || "");
}

function nl(value, digits = 0) {
  if(value == null)return "—";
  return Number(value || 0).toLocaleString((currentLanguage()==='en'?'en-GB':'nl-NL'), { maximumFractionDigits: digits });
}
function eur(value) {
  if(value == null)return "—";
  return Number(value || 0).toLocaleString((currentLanguage()==='en'?'en-GB':'nl-NL'), { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
}
function pct(value) {
  return `${(Number(value || 0) * 100).toLocaleString((currentLanguage()==='en'?'en-GB':'nl-NL'), { maximumFractionDigits: 1 })}%`;
