 let value=null,unit=null;
 if(ref.metric==='cost_income_ratio') {const cost=get('cost'),income=get('income');if(finite(cost)&&finite(income)&&income>0)value=cost/income;unit='ratio';}
 else {const bindings={direct_process_cost_eur:'cost',realized_revenue_eur:'income',expected_loss_eur:'risk'};if(bindings[ref.metric]){value=get(bindings[ref.metric]);unit='EUR';}else return fail('NO_COMPATIBLE_OUTCOME_FORMULA');}
 if(!finite(value))return fail('PROJECTED_INPUT_UNAVAILABLE');
 if(ref.target?.unit!==unit||!finite(ref.target?.value))return fail('TARGET_UNIT_OR_VALUE_MISMATCH');
 const ops={'<=':(a,b)=>a<=b,'>=':(a,b)=>a>=b,'<':(a,b)=>a<b,'>':(a,b)=>a>b,'=':(a,b)=>a===b,'==':(a,b)=>a===b};
 if(!ops[ref.target.operator])return fail('UNSUPPORTED_TARGET_OPERATOR');
