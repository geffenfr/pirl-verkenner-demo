function sourceDisplayLabel(displayLabels, language, fallback) {
  const preferred = language === "en" ? displayLabels?.en : displayLabels?.nl;
  const secondary = language === "en" ? displayLabels?.nl : displayLabels?.en;
  return String(preferred || secondary || fallback || "—");
}
