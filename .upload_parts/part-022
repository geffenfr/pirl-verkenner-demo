    y:
      world.y +
      ((finiteNumber(point?.clientY, "point.clientY") - rect.top) / rect.height) *
        world.height,
  });
}

function parseSvgTranslate(value) {
  const match = /^\s*translate\(\s*(-?(?:\d+\.?\d*|\.\d+))(?:[ ,]+)(-?(?:\d+\.?\d*|\.\d+))\s*\)\s*$/.exec(
    String(value ?? ""),
  );
  if (!match) throw new TypeError(`Unsupported SVG transform: ${value ?? ""}`);
  return Object.freeze({ x: Number(match[1]), y: Number(match[2]) });
}

function deriveNodeDragBounds(
  viewBox,
  nodeBox,
  { minimumMargin = 28, padding = 10 } = {},
) {
  const world = parseSvgViewBox(
    `${viewBox?.x} ${viewBox?.y} ${viewBox?.width} ${viewBox?.height}`,
  );
  const width = positiveNumber(nodeBox?.width, "nodeBox.width");
  const height = positiveNumber(nodeBox?.height, "nodeBox.height");
  const marginX = Math.max(
    finiteNumber(minimumMargin, "minimumMargin"),
    width / 2 + finiteNumber(padding, "padding"),
  );
  const marginY = Math.max(minimumMargin, height / 2 + padding);
  if (world.width <= marginX * 2 || world.height <= marginY * 2) {
    throw new RangeError("SVG viewBox is too small for the current node bounds");
  }
  return Object.freeze({
    minX: world.x + marginX,
    maxX: world.x + world.width - marginX,
    minY: world.y + marginY,
    maxY: world.y + world.height - marginY,
    marginX,
    marginY,
  });
}

function clampPointToBounds(point, bounds) {
  return Object.freeze({
    x: clamp(
      finiteNumber(point?.x, "point.x"),
      finiteNumber(bounds?.minX, "bounds.minX"),
      finiteNumber(bounds?.maxX, "bounds.maxX"),
    ),
    y: clamp(
      finiteNumber(point?.y, "point.y"),
      finiteNumber(bounds?.minY, "bounds.minY"),
      finiteNumber(bounds?.maxY, "bounds.maxY"),
    ),
  });
}

function zoomScale(currentScale, action) {
  const current = clamp(finiteNumber(currentScale, "currentScale"), MIN_SCALE, MAX_SCALE);
  if (action === "zoom-out") return clamp(current / ZOOM_FACTOR, MIN_SCALE, MAX_SCALE);
  if (action === "zoom-in") return clamp(current * ZOOM_FACTOR, MIN_SCALE, MAX_SCALE);
  if (action === "zoom-100") return 1;
  throw new RangeError(`Unknown zoom action: ${action}`);
}

function fitGraphScale(hostWidth, worldWidth) {
  return clamp(
    (positiveNumber(hostWidth, "hostWidth") - 18) /
      positiveNumber(worldWidth, "worldWidth"),
    MIN_SCALE,
    1,
  );
}

function distanceBetweenPoints(left, right) {
  return Math.hypot(
    finiteNumber(left?.clientX, "left.clientX") -
      finiteNumber(right?.clientX, "right.clientX"),
    finiteNumber(left?.clientY, "left.clientY") -
      finiteNumber(right?.clientY, "right.clientY"),
  );
}

function midpointBetweenPoints(left, right) {
  return Object.freeze({
    x: (finiteNumber(left?.clientX, "left.clientX") + finiteNumber(right?.clientX, "right.clientX")) / 2,
    y: (finiteNumber(left?.clientY, "left.clientY") + finiteNumber(right?.clientY, "right.clientY")) / 2,
  });
}

function pinchScale(initialScale, initialDistance, currentDistance) {
  return clamp(
    finiteNumber(initialScale, "initialScale") *
      (positiveNumber(currentDistance, "currentDistance") /
        positiveNumber(initialDistance, "initialDistance")),
    MIN_SCALE,
    MAX_SCALE,
  );
}

function anchoredScrollForScale({
  initialScrollLeft,
  initialScrollTop,
  localX,
  localY,
  initialScale,
  nextScale,
}) {
  const ratio =
    positiveNumber(nextScale, "nextScale") / positiveNumber(initialScale, "initialScale");
  const x = finiteNumber(localX, "localX");
  const y = finiteNumber(localY, "localY");
  return Object.freeze({
    left: Math.max(
      0,
      (finiteNumber(initialScrollLeft, "initialScrollLeft") + x) * ratio - x,
    ),
    top: Math.max(
      0,
      (finiteNumber(initialScrollTop, "initialScrollTop") + y) * ratio - y,
    ),
  });
}

function isActivationKey(event) {
  return event?.key === "Enter" || event?.key === " " || event?.key === "Spacebar";
}

function eventPoint(event) {
  return { clientX: Number(event.clientX), clientY: Number(event.clientY) };
}

function checkedValue(control) {
  return Boolean(control.checked);
}

function controlValue(control) {
  return String(control.value ?? "");
}

function graphScale(controller) {
  return Number(controller.getViewModel?.().graph?.scale ?? 1);
}

function graphScroll(controller) {
  const scroll = controller.getViewModel?.().graph?.scroll ?? {};
  return { left: Number(scroll.left ?? 0), top: Number(scroll.top ?? 0) };
}

function graphSvg(host) {
  return host?.querySelector?.("svg.object-graph-svg") ?? host?.querySelector?.("svg") ?? null;
}

function applyTransientScale(svg, scale) {
  const viewBox = parseSvgViewBox(svg);
  svg.setAttribute("width", String(Math.round(viewBox.width * scale)));
  svg.setAttribute("height", String(Math.round(viewBox.height * scale)));
  return viewBox;
}

function objectGraphInitialScroll({
  viewportAnchor = "center",
  savedScroll = { left: 0, top: 0 },
  scale = 1,
  hostWidth,
  hostHeight,
  worldWidth,
  worldHeight,
  centerX,
  centerY,
} = {}) {
  const resolvedScale = positiveNumber(scale, "scale");
  const width = positiveNumber(hostWidth, "hostWidth");
  const height = positiveNumber(hostHeight, "hostHeight");
  const world = {
    width: positiveNumber(worldWidth, "worldWidth") * resolvedScale,
    height: positiveNumber(worldHeight, "worldHeight") * resolvedScale,
  };
  const maximumLeft = Math.max(0, world.width - width);
  const maximumTop = Math.max(0, world.height - height);
  if (viewportAnchor === "explicit") {
    return Object.freeze({
      left: clamp(finiteNumber(savedScroll?.left ?? 0, "savedScroll.left"), 0, maximumLeft),
      top: clamp(finiteNumber(savedScroll?.top ?? 0, "savedScroll.top"), 0, maximumTop),
    });
  }
  if (viewportAnchor !== "center") {
    throw new RangeError(`Unknown Object graph viewport anchor: ${viewportAnchor}`);
  }
  return Object.freeze({
    left: clamp(
      finiteNumber(centerX, "centerX") * resolvedScale - width / 2,
      0,
      maximumLeft,
    ),
    top: clamp(
      finiteNumber(centerY, "centerY") * resolvedScale - height / 2,
      0,
      maximumTop,
    ),
  });
}

function restoreObjectGraphViewport(host, svg, graph = {}) {
  if (!host || !svg) return null;
  // Older/custom embedders that do not publish the viewport ownership marker
  // retain their live DOM scroll position. The clean controller always emits
  // an explicit marker, so the accepted Object route still restores or
  // centres deterministically without surprising unrelated interaction hosts.
  if (graph.viewportAnchor == null) return null;
  const viewBox = applyTransientScale(svg, Number(graph.scale ?? 1));
  const centerNode = svg.querySelector?.('[data-center="true"]');
  const center = centerNode
    ? parseSvgTranslate(centerNode.getAttribute?.("transform"))
    : { x: viewBox.x + viewBox.width / 2, y: viewBox.y + viewBox.height / 2 };
  const scroll = objectGraphInitialScroll({
    viewportAnchor: graph.viewportAnchor,
    savedScroll: graph.scroll,
    scale: Number(graph.scale ?? 1),
    hostWidth: Math.max(1, Number(host.clientWidth) || 1),
    hostHeight: Math.max(1, Number(host.clientHeight) || 1),
    worldWidth: viewBox.width,
    worldHeight: viewBox.height,
    centerX: center.x - viewBox.x,
    centerY: center.y - viewBox.y,
  });
  host.scrollLeft = scroll.left;
  host.scrollTop = scroll.top;
  return scroll;
}

function connectedEdges(svg, nodeKey) {
  return [...(svg?.querySelectorAll?.("[data-edge-from][data-edge-to]") ?? [])].filter(
    (edge) =>
      (edge.dataset?.edgeFrom ?? edge.getAttribute?.("data-edge-from")) === nodeKey ||
      (edge.dataset?.edgeTo ?? edge.getAttribute?.("data-edge-to")) === nodeKey,
  );
}

function updateConnectedEdges(svg, nodeKey, position) {
  for (const edge of connectedEdges(svg, nodeKey)) {
    const from = edge.dataset?.edgeFrom ?? edge.getAttribute?.("data-edge-from");
    if (from === nodeKey) {
      edge.setAttribute("x1", String(position.x));
      edge.setAttribute("y1", String(position.y));
    } else {
      edge.setAttribute("x2", String(position.x));
      edge.setAttribute("y2", String(position.y));
    }
  }
}

function setTransientNodePosition(svg, node, nodeKey, position) {
  node.setAttribute("transform", `translate(${position.x},${position.y})`);
  updateConnectedEdges(svg, nodeKey, position);
}

function safePointerCapture(target, method, pointerId) {
  try {
    target?.[method]?.(pointerId);
  } catch {
    // Pointer capture is browser-controlled and may already have been released.
  }
}

function captureObjectExplorerFocus(root) {
  const activeElement = root?.ownerDocument?.activeElement;
  if (!activeElement || activeElement.dataset?.objectControl !== "query") return null;
  if (typeof root.contains === "function" && !root.contains(activeElement)) return null;
  return Object.freeze({
    control: "query",
    selectionStart: Number.isInteger(activeElement.selectionStart)
      ? activeElement.selectionStart
      : null,
    selectionEnd: Number.isInteger(activeElement.selectionEnd) ? activeElement.selectionEnd : null,
    selectionDirection: activeElement.selectionDirection ?? "none",
  });
}

function restoreObjectExplorerFocus(root, snapshot) {
  if (!snapshot || snapshot.control !== "query") return false;
  const control = root?.querySelector?.('[data-object-control="query"]');
  if (!control) return false;
  try {
    control.focus?.({ preventScroll: true });
  } catch {
    control.focus?.();
  }
  if (
    Number.isInteger(snapshot.selectionStart) &&
    Number.isInteger(snapshot.selectionEnd) &&
    typeof control.setSelectionRange === "function"
  ) {
    const length = String(control.value ?? "").length;
    control.setSelectionRange(
      clamp(snapshot.selectionStart, 0, length),
      clamp(snapshot.selectionEnd, 0, length),
      snapshot.selectionDirection ?? "none",
    );
  }
  return true;
}

function requireController(controller) {
  const methods = [
    "getViewModel",
    "setKindFilter",
    "setQuery",
    "setDepth",
    "setRelationType",
    "setToggle",
    "selectActorRole",
    "selectEventType",
    "setParticipationFilter",
    "selectEntity",
    "selectGraphNode",
    "newSelection",
    "setView",
    "setViewport",
    "rememberViewport",
    "setManualPosition",
    "resetLayout",
  ];
  const missing = methods.filter((method) => typeof controller?.[method] !== "function");
  if (missing.length) {
    throw new TypeError(`Object Explorer interaction controller misses: ${missing.join(", ")}`);
  }
}

function bindObjectResultsPosition(root,controller) {
  const host=root.querySelector('#objectSearchResults');
  if(!host||typeof controller.getResultsPopulationKey!=='function')return()=>{};
  const key=controller.getResultsPopulationKey();
  const top=controller.getResultsPosition(key);
  const maximum=Math.max(0,Number(host.scrollHeight||0)-Number(host.clientHeight||0));
  host.scrollTop=Math.min(top,maximum);
  const save=()=>controller.rememberResultsPosition(key,Number(host.scrollTop||0));
  host.addEventListener?.('scroll',save,{passive:true});
  // Captured key belongs to this DOM population, not a newer controller state.
  return()=>{save();host.removeEventListener?.('scroll',save);};
}

function bindObjectExplorerInteractions({
  root,
  controller,
  onFocusSnapshot = () => {},
  onCommit = () => {},
} = {}) {
  if (!root?.querySelectorAll || !root?.querySelector) {
    throw new TypeError("Object Explorer interactions require a queryable root");
  }
  requireController(controller);
  if (typeof onFocusSnapshot !== "function" || typeof onCommit !== "function") {
    throw new TypeError("Object Explorer interaction callbacks must be functions");
  }

  const removers = [];
  removers.push(bindObjectResultsPosition(root,controller));
  const listen = (target, type, listener, options) => {
    target?.addEventListener?.(type, listener, options);
    removers.push(() => target?.removeEventListener?.(type, listener, options));
  };
  const invoke = (action, operation, focusSnapshot = null) => {
    if (focusSnapshot) onFocusSnapshot(focusSnapshot);
    const changed = operation();
    onCommit(Object.freeze({ action, changed: Boolean(changed), focusSnapshot }));
    return changed;
  };

  const scheduleViewTargetScroll = (view) => {
    const targetView = view === "journey" ? "journey" : "graph";
    queueMicrotask(() => {
      const target = root.querySelector(
        `[data-object-view-target="${targetView}"]`,
      );
      if (!target || typeof target.scrollIntoView !== "function") return;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  };

  for (const control of root.querySelectorAll("[data-object-control]")) {
    const name = control.dataset.objectControl;
    if (name === "query") {
      listen(control, "input", () => {
        const focusSnapshot = captureObjectExplorerFocus(root);
        invoke("query", () => controller.setQuery(controlValue(control)), focusSnapshot);
      });
    } else if (name === "kind-filter") {
      listen(control, "change", () =>
        invoke("kind-filter", () => controller.setKindFilter(controlValue(control))),
      );
    } else if (name === "depth") {
      listen(control, "change", () =>
        invoke("depth", () => controller.setDepth(Number(controlValue(control)))),
      );
    } else if (name === "relation-type") {
      listen(control, "change", () =>
        invoke("relation-type", () => controller.setRelationType(controlValue(control))),
      );
    } else if (name.startsWith("toggle-")) {
      const toggle = name.slice("toggle-".length);
      listen(control, "change", () =>
        invoke(`toggle-${toggle}`, () => controller.setToggle(toggle, checkedValue(control))),
      );
    }
  }

  const host =
    root.querySelector('[data-object-graph-state="READY"]') ?? root.querySelector("#objectGraph");
  const svg = graphSvg(host);
  if (host && svg) {
    restoreObjectGraphViewport(host, svg, controller.getViewModel().graph);
    listen(host, "scroll", () => controller.rememberViewport({
      scale: transientScaleForHost(),
      scroll: { left: Number(host.scrollLeft || 0), top: Number(host.scrollTop || 0) },
    }), { passive: true });
  }

  function transientScaleForHost() {
    const width = Number(svg?.getAttribute?.("width"));
    if (!svg || !Number.isFinite(width)) return graphScale(controller);
    const viewBox = parseSvgViewBox(svg);
    return clamp(width / viewBox.width, MIN_SCALE, MAX_SCALE);
  }

  function applyZoom(action) {
    if (!host || !svg) return false;
    const current = graphScale(controller);
    const viewBox = parseSvgViewBox(svg);
    const next =
      action === "zoom-fit"
        ? fitGraphScale(Math.max(1, Number(host.clientWidth) || 1), viewBox.width)
        : zoomScale(current, action);
    applyTransientScale(svg, next);
    const scroll =
      action === "zoom-fit"
        ? { left: 0, top: 0 }
        : { left: Number(host.scrollLeft || 0), top: Number(host.scrollTop || 0) };
    if (action === "zoom-fit") {
      host.scrollLeft = 0;
      host.scrollTop = 0;
    }
    return invoke(action, () => controller.setViewport({ scale: next, scroll }));
  }

  for (const control of root.querySelectorAll("[data-object-action]")) {
    const action = control.dataset.objectAction;
    if (action === "select-entity" && control.hasAttribute?.("data-graph-node")) continue;
    const activate = () => {
      if (action === "inventory-filter") {
        const kind = String(control.dataset.objectKind ?? "");
        const query = String(control.dataset.objectQuery ?? "");
        const participation = Boolean(
          control.closest?.("[data-object-participation-inventory]"),
        );
        if (participation) {
          return invoke("participation-filter", () =>
            controller.setParticipationFilter(
              query === "INVENTORY_ONLY" ? "inventory-only" : "observed",
            ),
          );
        }
        if (query && kind === "actor") {
          return invoke("actor-role", () => controller.selectActorRole(query));
        }
        if (query && kind === "event") {
          return invoke("event-type", () => controller.selectEventType(query));
        }
        return invoke("kind-filter", () => controller.setKindFilter(kind || "all"));
      }
      if (action === "select-entity") {
        return invoke("list-selection", () =>
          controller.selectEntity(
            String(control.dataset.selectionKind ?? ""),
            String(control.dataset.selectionId ?? ""),
            { source: "list" },
          ),
        );
      }
      if (action === "clear-selection") {
        return invoke("clear-selection", () => controller.newSelection());
      }
      if (action === "set-view") {
        const targetView = String(control.dataset.objectView ?? "graph");
        const changed = invoke("set-view", () => controller.setView(targetView));
        scheduleViewTargetScroll(targetView);
        return changed;
      }
      if (["zoom-out", "zoom-in", "zoom-100", "zoom-fit"].includes(action)) {
        return applyZoom(action);
      }
      if (action === "reset-layout") {
        if (host) {
          host.scrollLeft = 0;
          host.scrollTop = 0;
        }
        if (svg) applyTransientScale(svg, 1);
        return invoke("reset-layout", () => controller.resetLayout());
      }
      return false;
    };
    listen(control, "click", (event) => {
      event.preventDefault?.();
      activate();
    });
    if (action === "select-entity") {
      listen(control, "keydown", (event) => {
        if (!isActivationKey(event)) return;
        event.preventDefault?.();
        activate();
      });
    }
  }

  if (host && svg) {
    const pointerState = new Map();
    let pan = null;
    let pinch = null;
    let transientScale = graphScale(controller);

    const finishViewport = (action) =>
      invoke(action, () =>
        controller.setViewport({
          scale: transientScale,
          scroll: { left: Number(host.scrollLeft || 0), top: Number(host.scrollTop || 0) },
        }),
      );

    listen(host, "pointerdown", (event) => {
      if (event.button !== undefined && event.button !== 0 && event.pointerType !== "touch") return;
      if (event.target?.closest?.("[data-graph-node]")) return;
      if ((event.pointerType === "mouse" || !event.pointerType) && !event.target?.closest?.("svg.object-graph-svg")) return;
      const pointerId = event.pointerId ?? 1;
      pointerState.set(pointerId, eventPoint(event));
      safePointerCapture(host, "setPointerCapture", pointerId);
      if (pointerState.size === 1) {
        pan = {
          pointerId,
          startX: Number(event.clientX),
          startY: Number(event.clientY),
          scrollLeft: Number(host.scrollLeft || 0),
          scrollTop: Number(host.scrollTop || 0),
          moved: false,
        };
      } else if (pointerState.size === 2) {
        const [left, right] = [...pointerState.values()];
        const midpoint = midpointBetweenPoints(left, right);
        const rect = host.getBoundingClientRect();
        pinch = {
          distance: Math.max(1, distanceBetweenPoints(left, right)),
          scale: transientScale,
          scrollLeft: Number(host.scrollLeft || 0),
          scrollTop: Number(host.scrollTop || 0),
          localX: midpoint.x - Number(rect.left || 0),
          localY: midpoint.y - Number(rect.top || 0),
          moved: false,
        };
        pan = null;
      }
      event.preventDefault?.();
    });

    listen(host, "pointermove", (event) => {
      const pointerId = event.pointerId ?? 1;
      if (!pointerState.has(pointerId)) return;
      pointerState.set(pointerId, eventPoint(event));
      if (pinch && pointerState.size >= 2) {
        const [left, right] = [...pointerState.values()].slice(0, 2);
        const next = pinchScale(
          pinch.scale,
          pinch.distance,
          Math.max(1, distanceBetweenPoints(left, right)),
        );
        const scroll = anchoredScrollForScale({
          initialScrollLeft: pinch.scrollLeft,
          initialScrollTop: pinch.scrollTop,
          localX: pinch.localX,
          localY: pinch.localY,
          initialScale: pinch.scale,
          nextScale: next,
        });
        transientScale = next;
        applyTransientScale(svg, next);
        host.scrollLeft = scroll.left;
        host.scrollTop = scroll.top;
        pinch.moved = pinch.moved || Math.abs(next - pinch.scale) > 0.001;
        event.preventDefault?.();
        return;
      }
      if (pan?.pointerId === pointerId) {
        const deltaX = Number(event.clientX) - pan.startX;
        const deltaY = Number(event.clientY) - pan.startY;
        pan.moved = pan.moved || Math.hypot(deltaX, deltaY) > DRAG_THRESHOLD;
        host.scrollLeft = Math.max(0, pan.scrollLeft - deltaX);
        host.scrollTop = Math.max(0, pan.scrollTop - deltaY);
        event.preventDefault?.();
      }
    });

    const endViewportPointer = (event, cancelled) => {
      const pointerId = event.pointerId ?? 1;
      if (!pointerState.has(pointerId)) return;
      const wasPinch = Boolean(pinch && pointerState.size >= 2);
      pointerState.delete(pointerId);
      safePointerCapture(host, "releasePointerCapture", pointerId);
      if (wasPinch && pointerState.size < 2) {
        if (cancelled) {
          transientScale = pinch.scale;
          applyTransientScale(svg, pinch.scale);
          host.scrollLeft = pinch.scrollLeft;
          host.scrollTop = pinch.scrollTop;
        } else if (pinch.moved) {
          finishViewport("pinch");
        }
        pinch = null;
        pan = null;
        pointerState.clear();
      } else if (pan?.pointerId === pointerId) {
        if (cancelled || !pan.moved) {
          host.scrollLeft = pan.scrollLeft;
          host.scrollTop = pan.scrollTop;
        } else {
          finishViewport("pan");
        }
        pan = null;
      }
      event.preventDefault?.();
    };
    listen(host, "pointerup", (event) => endViewportPointer(event, false));
    listen(host, "pointercancel", (event) => endViewportPointer(event, true));

    for (const node of svg.querySelectorAll("[data-graph-node]")) {
      const nodeKey =
        node.dataset?.graphNode ?? node.getAttribute?.("data-graph-node") ?? "";
      if (!nodeKey || node.dataset?.objectAction !== "select-entity") continue;
      let drag = null;
      let suppressPointerClick = false;

      listen(node, "pointerdown", (event) => {
        if (event.button !== undefined && event.button !== 0 && event.pointerType !== "touch") return;
        suppressPointerClick = false;
        const viewBox = parseSvgViewBox(svg);
        const rect = svg.getBoundingClientRect();
        const point = clientPointToSvgPoint(eventPoint(event), rect, viewBox);
        const start = parseSvgTranslate(node.getAttribute("transform"));
        let nodeBox;
        try {
          nodeBox = node.getBBox();
        } catch {
          nodeBox = { width: node.dataset?.nodeKind === "object" ? 144 : 174, height: 94 };
        }
        const bounds = deriveNodeDragBounds(viewBox, nodeBox);
        drag = {
          pointerId: event.pointerId ?? 1,
          startClientX: Number(event.clientX),
          startClientY: Number(event.clientY),
          start,
          current: start,
          offsetX: point.x - start.x,
          offsetY: point.y - start.y,
          bounds,
          moved: false,
        };
        safePointerCapture(node, "setPointerCapture", drag.pointerId);
        event.preventDefault?.();
        event.stopPropagation?.();
      });

      listen(node, "pointermove", (event) => {
        if (!drag || drag.pointerId !== (event.pointerId ?? 1)) return;
        const point = clientPointToSvgPoint(
          eventPoint(event),
          svg.getBoundingClientRect(),
          parseSvgViewBox(svg),
        );
        drag.moved =
          drag.moved ||
          Math.hypot(
            Number(event.clientX) - drag.startClientX,
            Number(event.clientY) - drag.startClientY,
          ) > DRAG_THRESHOLD;
        drag.current = clampPointToBounds(
          { x: point.x - drag.offsetX, y: point.y - drag.offsetY },
          drag.bounds,
        );
        setTransientNodePosition(svg, node, nodeKey, drag.current);
        event.preventDefault?.();
        event.stopPropagation?.();
      });

      const endNodeDrag = (event, cancelled) => {
        if (!drag || drag.pointerId !== (event.pointerId ?? 1)) return;
        safePointerCapture(node, "releasePointerCapture", drag.pointerId);
        if (cancelled || !drag.moved) {
          setTransientNodePosition(svg, node, nodeKey, drag.start);
        } else if (drag.moved) {
          suppressPointerClick = true;
          invoke("node-drag", () => controller.setManualPosition(nodeKey, drag.current, {
            scale: transientScale,
            scroll: { left: Number(host.scrollLeft || 0), top: Number(host.scrollTop || 0) },
          }));
        }
        drag = null;
        event.preventDefault?.();
        event.stopPropagation?.();
      };
      listen(node, "pointerup", (event) => endNodeDrag(event, false));
