  activities:[...activities.values()].map(x=>({...x,seconds:Number.isFinite(x.seconds)?x.seconds:null,cost:x.cost==null||!Number.isFinite(roundMoney(x.cost))?null:roundMoney(x.cost)}))};
 for(const [key,def] of Object.entries(fields)){
  const s=state[key],unmeasuredEventIds=[...participationKeys].filter(id=>!s.eventKeys.has(id));
  const aggregate=key==='cost'?roundMoney(s.sum):s.sum,aggregationValid=Number.isFinite(aggregate);
  const status=!s.records.length||!aggregationValid?'NOT_ESTABLISHED':unmeasuredEventIds.length||s.missing.length||s.invalid.length?'PARTIAL':'RECORDED';
  result[key]={field:def.field,unit:def.unit,value:s.records.length&&aggregationValid?aggregate:null,status,aggregationIssue:s.records.length&&!aggregationValid?'NON_FINITE_TOTAL':null,
   recordCount:s.records.length,eventCount:s.eventKeys.size,eventIds:[...s.eventKeys],recordRefs:s.records,
   missingRecords:s.missing,invalidRecords:s.invalid,unmeasuredEventIds,
   coverageEvents:participationKeys.size?s.eventKeys.size/participationKeys.size:null,totalInputEstablished:false};
 }
