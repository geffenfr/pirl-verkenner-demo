function edgeKind(fromNode, toNode, processId, activityRanks) {
  if (fromNode.id === toNode.id) return "self-loop";
  if (processId === ALL && fromNode.processId !== toNode.processId) return "procesovergang";
  const ranks = activityRanks.get(fromNode.processId) || new Map();
  const fromRank = ranks.get(fromNode.activityId) ?? 999;
  const toRank = ranks.get(toNode.activityId) ?? 999;
