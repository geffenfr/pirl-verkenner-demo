  }
  function statusRows() {
    const integrated = integratedAssessmentController.getInterventionContext();
    const advice = adviceController.getInterventionPackage();
    const simulation = simulationController.getScenarioResult();
    const benchmark = benchmarkController.getResult();
    const benchmarkVM = benchmarkController.getViewModel();
    const review = researcherReviewController.getReviewRecord();
    const lastReview = researcherReviewController.getLastReviewRecord?.() || null;
    return {
      integrated: integrated ? "CURRENT_FROZEN_CONTEXT" : "NOT_FROZEN_OR_NOT_CURRENT",
      advice: advice ? "CURRENT_TRANSFERRED_PACKAGE" : "NOT_TRANSFERRED_OR_NOT_CURRENT",
      simulation: simulation ? "CURRENT_EXPLICIT_SCENARIO" : "NOT_CALCULATED_OR_NOT_CURRENT",
      benchmark: benchmark ? "CURRENT_REVEALED_COMPARISON" : benchmarkVM?.previouslyRevealed ? "HUMAN_PRIOR_EXPOSURE_NO_CURRENT_COMPARISON" : "NOT_REVEALED",
      review: review ? "CURRENT_HUMAN_REVIEW" : lastReview ? "STALE_HUMAN_REVIEW_NOT_CURRENT" : "NOT_REVIEWED",
    };
  }

  const api = {
    enter() { current(); return false; },
    getViewModel() {
      const { r } = current();
      const states = r.source && r.valid ? statusRows() : null;
      return deepFreeze({
        screen: "validation.export",
        screenState: !r.source ? "NO_DATASET" : !r.valid ? "INVALID_SCOPE" : "READY",
        blockReason: !r.source ? "Laad eerst een dataset." : !r.valid ? "Ongeldige onderzoeksafbakening; export valt niet terug op eerdere of bredere gegevens." : null,
        researchScope: r.summary,
        scopeLabel: r.summary.label,
