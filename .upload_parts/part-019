  const roles = stringArray(record?.roles);
  return (
    sourceId(record, "display_name", "name", "role", "actor_type", "type") ||
    roles[0] ||
    sourceId(record, "actor_id", "id")
  );
}

function actorRoleId(record) {
  return (
    sourceId(record, "role", "actor_role", "actor_type") ||
    stringArray(record?.roles)[0] ||
    sourceId(record, "type")
  );
}

function actorRoleLabel(record, roleDefinitions = []) {
  const sourceRoleId = actorRoleId(record);
  const definition = roleDefinitions.find(
    (candidate) => sourceId(candidate, "role_id", "id") === sourceRoleId,
  );
  // STABLE-02 normalizes the generic PERSON source category to the visible
  // EMPLOYEE role before Object inventory is rendered.  Prefer an explicit
  // source category where one exists; the fallback is dataset-independent.
  const normalizedRoleId =
    sourceRoleId === "PERSON"
      ? sourceId(record?.attributes, "actor_category") || "EMPLOYEE"
      : sourceRoleId;
  return (
    sourceId(definition, "name") ||
    sourceId(record, "role_name") ||
    normalizedRoleId ||
    actorName(record) ||
    "Actor"
  );
}

function cleanEventStepId(value) {
  const raw = stringValue(value);
  if (raw.includes("|")) return raw.split("|").at(-1);
  if (raw.includes(":")) return raw.split(":").at(-1);
  return raw;
}

function eventStepId(event) {
  return cleanEventStepId(
    sourceId(event, "activity_id", "activity", "event_type", "name") ||
      sourceId(event, "event_id", "id"),
  );
}

function generatedStepName(stepId) {
  const subjects = {
    COMP: "klacht", COMPLAINT: "klacht", KYC: "KYC", ONB: "onboarding", AML: "AML",
    PAY: "betaling", PAYMENT: "betaling", CARD: "kaarttransactie", CREDIT: "krediet",
    COLL: "incasso", COLLECTIONS: "incasso", SEC: "beveiliging", SECURITY: "beveiliging",
    DATA: "data", BUREAU: "kredietbureau", MONITORING: "monitoring",
    AUTHENTICATION: "authenticatie", SETTLEMENT: "vereffening", SCREENING: "screening",
    REMEDY: "herstel", HARDSHIP: "betalingsproblemen", VULNERABILITY: "kwetsbaarheid",
    LINEAGE: "data-lineage", DISPUTE: "betwisting", INCOME: "inkomen",
    IDENTITY: "identiteit", BENEFICIARY: "begunstigde", SOURCE: "herkomst van middelen",
    CUSTOMER: "klant",
  };
  const subject = (value) => subjects[value] || stringValue(value).toLowerCase().replaceAll("_", " ");
  const patterns = [
    [/^ADDITIONAL_(.+)_EVIDENCE_RECEIVED$/, (value) => `Aanvullend ${subject(value)}bewijs ontvangen`],
    [/^(.+)_CHANNEL_SWITCHED$/, (value) => `Kanaal gewisseld (${subject(value)})`],
    [/^(.+)_REWORK_REQUIRED$/, (value) => `Herbewerking vereist (${subject(value)})`],
    [/^(.+)_CLARIFICATION_REQUESTED$/, (value) => `Verduidelijking gevraagd (${subject(value)})`],
    [/^(.+)_CLARIFIED$/, (value) => `Verduidelijkt (${subject(value)})`],
    [/^MANUAL_(.+)_REVIEW_STARTED$/, (value) => `Handmatige beoordeling gestart (${subject(value)})`],
    [/^MANUAL_(.+)_REVIEW_COMPLETED$/, (value) => `Handmatige beoordeling afgerond (${subject(value)})`],
    [/^(.+)_REVIEW_COMPLETED$/, (value) => `Beoordeling afgerond (${subject(value)})`],
    [/^(.+)_REVIEWED$/, (value) => `Beoordeeld (${subject(value)})`],
    [/^(.+)_ESCALATED$/, (value) => `Geëscaleerd (${subject(value)})`],
    [/^(.+)_RETRY_STARTED$/, (value) => `Herpoging gestart (${subject(value)})`],
    [/^(.+)_RETRY$/, (value) => `Herpoging (${subject(value)})`],
    [/^(.+)_RECONCILED$/, (value) => `Gereconcilieerd (${subject(value)})`],
    [/^(.+)_RECEIVED$/, (value) => `Ontvangen (${subject(value)})`],
  ];
  for (const [pattern, render] of patterns) {
    const match = stepId.match(pattern);
    if (match) return render(match[1]);
  }
  const words = stringValue(stepId).toLowerCase().split("_").filter(Boolean);
  return words.length
    ? words.map((word, index) => index ? word : `${word.charAt(0).toUpperCase()}${word.slice(1)}`).join(" ")
    : "";
}

function eventStepName(event) {
  return (
    OBJECT_ACTIVITY_NAMES[eventStepId(event)] ||
    generatedStepName(eventStepId(event)) ||
    sourceId(event, "activity_name", "name", "event_type", "activity_id")
  );
}

function eventStepInventoryKey(event) {
  return (
    eventStepName(event) ||
    sourceId(event, "event_type") ||
    eventStepId(event)
  );
}

function stepTitle(event) {
  const stepId = eventStepId(event);
  const humanName = eventStepName(event);
  return humanName && humanName !== stepId ? `${stepId} — ${humanName}` : stepId;
}

function entityLabel(kind, record) {
  if (kind === "object") {
    const id = sourceId(record, "object_id", "id");
    return `${id} · ${objectType(record)}`;
  }
  if (kind === "event") {
    const id = sourceId(record, "event_id", "id");
    return `${id} · ${stepTitle(record)}`;
  }
  const id = sourceId(record, "actor_id", "id");
  return `${id} · ${actorName(record)}`;
}

function entitySubtitle(kind, record) {
  if (kind === "object") return objectName(record);
  if (kind === "event") return "Event/processtap is het centrum van deze verkenning.";
  return "Actor is het centrum van deze verkenning.";
}

function extensionId(extension) {
  return typeof extension === "string" ? extension : sourceId(extension, "id", "name", "extension_id");
}

function hasParticipationExtension(model) {
  const extensions = Array.isArray(model.manifest?.extensions) ? model.manifest.extensions : [];
  return extensions.some((extension) => extensionId(extension) === "pirl.actor-participation-semantics");
}

function normalizedParticipationMode(actor) {
  return stringValue(actor?.attributes?.participation_mode || actor?.participation_mode).trim().toUpperCase();
}

function participationBasis(actor) {
  return stringValue(actor?.attributes?.participation_basis || actor?.participation_basis);
}

function canonicalEntity(kind, record, participation = null) {
  const id =
    kind === "object"
      ? sourceId(record, "object_id", "id")
      : kind === "event"
        ? sourceId(record, "event_id", "id")
        : sourceId(record, "actor_id", "id");
  return {
    kind,
    id,
    key: `${kind}:${id}`,
    label: entityLabel(kind, record),
    title: entityLabel(kind, record),
    subtitle: entitySubtitle(kind, record),
    participation,
  };
}

function sortedCounts(values, limit = Infinity, firstSeenTies = false) {
  const counts = new Map();
  for (const value of values.filter(Boolean)) counts.set(value, (counts.get(value) || 0) + 1);
  return [...counts.entries()]
    .map(([value, count]) => ({ value, label: value, count }))
    // Map insertion order + stable sort preserve canonical source order on ties.
    .sort((left, right) => right.count - left.count || (firstSeenTies ? 0 : localeCompare(left.label, right.label)))
    .slice(0, limit);
}

function roundRobin(records, groupOf, maximum) {
  const buckets = new Map();
  for (const record of records) {
    const key = groupOf(record) || "";
    if (!buckets.has(key)) buckets.set(key, []);
    buckets.get(key).push(record);
  }
  const ordered = [...buckets.entries()].sort(([left], [right]) => localeCompare(left, right));
  const projected = [];
  for (let offset = 0; projected.length < maximum; offset += 1) {
    let found = false;
    for (const [, bucket] of ordered) {
      if (offset < bucket.length) {
        projected.push(bucket[offset]);
        found = true;
        if (projected.length === maximum) break;
      }
    }
    if (!found) break;
  }
  return projected;
}

function normalizedSearch(record) {
  return JSON.stringify(record).toLocaleLowerCase("nl");
}

function capabilityFor(model) {
  const entityCount = model.objects.length + model.actors.length;
  const relationCount = model.relations.length;
  if (entityCount === 0) {
    return deepFreeze({
      state: "UNAVAILABLE",
      reason: OBJECT_EXPLORER_COPY.unavailable,
      region: {
        visible: true,
        title: "Onvoldoende data/context — capability niet beschikbaar.",
        message: OBJECT_EXPLORER_COPY.unavailable,
        supportingText:
          "Beschikbare brondata blijft behouden; er wordt geen demo- of vorige-datasetdata ingevuld.",
      },
      evidence: { objectCount: model.objects.length, actorCount: model.actors.length, relationCount },
    });
  }
  if (relationCount === 0) {
    return deepFreeze({
      state: "PARTIAL",
      reason: OBJECT_EXPLORER_COPY.partial,
      region: {
        visible: true,
        title: "Beperkte broncontext — PARTIAL.",
        message: OBJECT_EXPLORER_COPY.partial,
        supportingText:
          "Alleen resultaten die uit de beschikbare bron kunnen worden onderbouwd zijn interpreteerbaar.",
      },
      evidence: { objectCount: model.objects.length, actorCount: model.actors.length, relationCount },
    });
  }
  return deepFreeze({
    state: "FULL",
    reason: null,
    evidence: { objectCount: model.objects.length, actorCount: model.actors.length, relationCount },
  });
}

function defaultControls({ view = OBJECT_EXPLORER_DEFAULTS.view } = {}) {
  return {
    view,
    kindFilter: OBJECT_EXPLORER_DEFAULTS.kindFilter,
    query: OBJECT_EXPLORER_DEFAULTS.query,
    depth: OBJECT_EXPLORER_DEFAULTS.depth,
    relationType: OBJECT_EXPLORER_DEFAULTS.relationType,
    participationFilter: OBJECT_EXPLORER_DEFAULTS.participationFilter,
    actorRoleFilter: OBJECT_EXPLORER_DEFAULTS.actorRoleFilter,
    toggles: { ...OBJECT_EXPLORER_DEFAULTS.toggles },
  };
}

function createIndex(model) {
  const objects = model.objects;
  const events = model.events;
  const actors = model.actors;
  const decisions = model.decisions;
  const communications = model.communications;
  const relations = model.relations;
  const roleDefinitions = Array.isArray(model.roles)
    ? model.roles
    : Array.isArray(model.roleDefinitions)
      ? model.roleDefinitions
      : [];

  const objectById = new Map(
    objects.map((record) => [sourceId(record, "object_id", "id"), record]).filter(([id]) => id),
  );
  const eventById = new Map(
    events.map((record) => [sourceId(record, "event_id", "id"), record]).filter(([id]) => id),
  );
  const actorById = new Map(
    actors.map((record) => [sourceId(record, "actor_id", "id"), record]).filter(([id]) => id),
  );
  const decisionById = new Map(
    decisions.map((record) => [sourceId(record, "decision_id", "id"), record]).filter(([id]) => id),
  );
  const communicationById = new Map(
    communications
      .map((record) => [sourceId(record, "communication_id", "id"), record])
      .filter(([id]) => id),
  );

  const eventOrder = sourceOrderMap(events, ["event_id", "id"]);
  const decisionOrder = sourceOrderMap(decisions, ["decision_id", "id"]);
  const communicationOrder = sourceOrderMap(communications, ["communication_id", "id"]);
  const eventOrderOf = (event) => eventOrder.get(sourceId(event, "event_id", "id")) ?? Number.MAX_SAFE_INTEGER;
  const decisionOrderOf = (decision) =>
    decisionOrder.get(sourceId(decision, "decision_id", "id")) ?? Number.MAX_SAFE_INTEGER;
  const communicationOrderOf = (communication) =>
    communicationOrder.get(sourceId(communication, "communication_id", "id")) ?? Number.MAX_SAFE_INTEGER;

  const eventsByObject = new Map();
  const eventsByActor = new Map();
  const decisionsByObject = new Map();
  const communicationsByObject = new Map();
  const relationsByObject = new Map();

  function append(map, key, value) {
    if (!key) return;
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(value);
  }

  for (const event of events) {
    for (const id of new Set(stringArray(event.object_ids))) append(eventsByObject, id, event);
    for (const id of new Set(stringArray(event.actor_ids))) append(eventsByActor, id, event);
  }
  for (const decision of decisions) {
    for (const id of new Set(stringArray(decision.object_ids))) append(decisionsByObject, id, decision);
  }
  for (const communication of communications) {
    const objectIds = new Set([
      ...stringArray(communication.object_ids),
      ...stringArray(communication.related_object_ids),
    ]);
    for (const id of objectIds) {
      append(communicationsByObject, id, communication);
    }
  }
  relations.forEach((relation, index) => {
    const source = sourceId(relation, "source_object_id", "source_id");
    const target = sourceId(relation, "target_object_id", "target_id");
    if (!source || !target || !objectById.has(source) || !objectById.has(target)) return;
    const indexed = { relation, index, source, target };
    append(relationsByObject, source, indexed);
    if (target !== source) append(relationsByObject, target, indexed);
  });

  for (const values of eventsByObject.values()) values.sort(recentFirst(eventTime, eventOrderOf));
  for (const values of eventsByActor.values()) values.sort(recentFirst(eventTime, eventOrderOf));
  for (const values of decisionsByObject.values()) values.sort(recentFirst(decisionTime, decisionOrderOf));
  for (const values of communicationsByObject.values()) {
    values.sort(recentFirst(communicationTime, communicationOrderOf));
  }

  const participationSupported = hasParticipationExtension(model);
  const participationByActor = new Map();
  for (const actor of actors) {
    const actorId = sourceId(actor, "actor_id", "id");
    const observedReferences = eventsByActor.get(actorId)?.length || 0;
    const declaredMode = normalizedParticipationMode(actor);
    let mode;
    let valid = true;
    if (declaredMode === "OBSERVED_EXECUTION") {
      mode = declaredMode;
      valid = observedReferences > 0;
    } else if (declaredMode === "INVENTORY_ONLY") {
      mode = declaredMode;
      valid = observedReferences === 0;
    } else if (participationSupported) {
      mode = "UNCLASSIFIED";
      valid = false;
    } else {
      mode = observedReferences > 0 ? "OBSERVED_EXECUTION" : "UNCLASSIFIED";
    }
    participationByActor.set(
      actorId,
      deepFreeze({
        mode,
        declaredMode: declaredMode || null,
        declared: Boolean(declaredMode),
        supported: participationSupported,
        valid,
        basis: participationBasis(actor) || (observedReferences > 0 ? "SOURCE_EVENT_REFERENCES" : null),
        observedEventReferences: observedReferences,
      }),
    );
  }

  return {
    model,
    objects,
    events,
    actors,
    decisions,
    communications,
    relations,
    roleDefinitions,
    objectById,
    eventById,
    actorById,
    decisionById,
    communicationById,
    eventsByObject,
    eventsByActor,
    decisionsByObject,
    communicationsByObject,
    relationsByObject,
    participationSupported,
    participationByActor,
    eventOrderOf,
    decisionOrderOf,
    communicationOrderOf,
  };
}

function lookupEntity(index, kind, id) {
  if (kind === "object") return index.objectById.get(String(id)) || null;
  if (kind === "event") return index.eventById.get(String(id)) || null;
  if (kind === "actor") return index.actorById.get(String(id)) || null;
  return null;
}

function entityProjection(index, kind, record, selected = false, selectedOutOfProjection = false) {
  const participation =
    kind === "actor" ? index.participationByActor.get(sourceId(record, "actor_id", "id")) : null;
  const entity = canonicalEntity(kind, record, participation);
  let resultTitle = entity.id;
  let resultSubtitle;
  if (kind === "object") {
    resultSubtitle = `${objectType(record)} · ${objectName(record)}`;
  } else if (kind === "event") {
    resultSubtitle = `${stepTitle(record)} · ${processName(index.model, record.process_id)}`;
  } else {
    resultSubtitle = `${actorName(record)} · ${actorRoleLabel(record, index.roleDefinitions)}`;
  }
  return deepFreeze({
    ...entity,
    resultTitle,
    resultSubtitle,
    selected,
    selectedOutOfProjection,
    selectedInjectedForContinuity: selectedOutOfProjection,
    visibleFallbackMarker: selected && selectedOutOfProjection && participation?.mode === "INVENTORY_ONLY",
    sourceRecord: record,
  });
}

function inventory(index) {
  const observed = [...index.participationByActor.values()].filter(
    ({ mode }) => mode === "OBSERVED_EXECUTION",
  ).length;
  const inventoryOnly = [...index.participationByActor.values()].filter(
    ({ mode }) => mode === "INVENTORY_ONLY",
  ).length;
  const unclassified = index.actors.length - observed - inventoryOnly;
  const allActorRoleCounts = sortedCounts(
    index.actors.map((actor) => actorRoleLabel(actor, index.roleDefinitions)),
  );
  const allEventTypeCounts = sortedCounts(index.events.map(eventStepInventoryKey));
  const actorRoleCounts = allActorRoleCounts.slice(0, 20);
  const eventTypeCounts = allEventTypeCounts.slice(0, 16);
  const objectSubtypes = sortedCounts(index.objects.map(objectType), Infinity, true);
  return deepFreeze({
    copy: OBJECT_EXPLORER_COPY.inventory,
    counts: {
      objects: index.objects.length,
      events: index.events.length,
      actors: index.actors.length,
    },
    objectSubtypes,
    actorRoles: actorRoleCounts,
    actorRoleCount: allActorRoleCounts.length,
    roleCount: allActorRoleCounts.length,
    eventTypes: eventTypeCounts,
    eventTypeCount: allEventTypeCounts.length,
    participation: {
      supported: index.participationSupported,
      actorInventory: index.actors.length,
      observedExecution: observed,
      inventoryOnly,
      unclassified,
      summary: `Actor inventory: ${index.actors.length} · geobserveerde uitvoering: ${observed} · inventory-only: ${inventoryOnly}${unclassified ? ` · ongeclassificeerd: ${unclassified}` : ""}`,
      explanation:
        "Standaard worden alleen deelnemers aan geobserveerde uitvoeringen als actor in de uitvoeringsselectie getoond. Records die alleen in de inventaris voorkomen blijven afzonderlijk inspecteerbaar.",
    },
  });
}

function recordMatches(record, query) {
  return !query || normalizedSearch(record).includes(query);
}

function filteredRecords(index, controls, kind) {
  const query = controls.query.trim().toLocaleLowerCase("nl");
  if (kind === "object") {
    let values = index.objects;
    if (controls.kindFilter.startsWith("object:")) {
      const subtype = controls.kindFilter.slice("object:".length);
      values = values.filter((record) => objectType(record) === subtype);
    } else if (!["all", "object"].includes(controls.kindFilter)) {
      values = [];
    }
    const matches = values.filter((record) => recordMatches(record, query));
    return matches.slice(0, query ? 160 : 80);
  }

  if (kind === "event") {
    if (!["all", "event"].includes(controls.kindFilter)) return [];
    // Inventory chips display derived activity names, not only raw source fields.
    // Match that same display key without modifying source records or research scope.
    const matches = index.events.filter((record) => recordMatches(record, query) ||
      eventStepInventoryKey(record).toLocaleLowerCase("nl").includes(query));
    return query
      ? [...matches].reverse().slice(0, 180)
      : roundRobin(matches, eventStepInventoryKey, 100);
  }

  if (!["all", "actor"].includes(controls.kindFilter)) return [];
  let actors = index.actors;
  if (controls.actorRoleFilter) {
    actors = actors.filter(actor => actorRoleLabel(actor, index.roleDefinitions) === controls.actorRoleFilter);
  }
  if (controls.participationFilter === "observed") {
    actors = actors.filter(
      (actor) => index.participationByActor.get(sourceId(actor, "actor_id", "id"))?.mode === "OBSERVED_EXECUTION",
    );
  } else if (controls.participationFilter === "inventory-only") {
    actors = actors.filter(
      (actor) => index.participationByActor.get(sourceId(actor, "actor_id", "id"))?.mode === "INVENTORY_ONLY",
    );
  } else if (index.participationSupported) {
    actors = actors.filter(
      (actor) => index.participationByActor.get(sourceId(actor, "actor_id", "id"))?.mode !== "INVENTORY_ONLY",
    );
  }
  const matches = actors.filter((record) => recordMatches(record, query));
  return query
    ? matches.slice(0, 220)
    : roundRobin(matches, (actor) => actorRoleLabel(actor, index.roleDefinitions), 140);
}

function resultGroups(index, controls, selection) {
  const labels = { object: "Objecten", event: "Events / processtappen", actor: "Actoren" };
  const groups = ["object", "event", "actor"].map((kind) => {
    const records = filteredRecords(index, controls, kind);
    const selectedRecord = selection?.kind === kind ? lookupEntity(index, kind, selection.id) : null;
    const selectedId = selection?.kind === kind ? selection.id : null;
    const initialProjectionIds = records.map((record) => canonicalEntity(kind, record).id);
    const sourceRecords = kind === "object" ? index.objects : kind === "event" ? index.events : index.actors;
    let selectedOutOfProjection = false;
    if (selectedRecord) {
      const visible = records.some((record) => {
        const projected = canonicalEntity(kind, record);
        return projected.id === selectedId;
      });
      if (!visible) {
        records.unshift(selectedRecord);
        selectedOutOfProjection = true;
      }
    }
    const seen = new Set();
    const items = records
      .map((record) => {
        const projectedId = canonicalEntity(kind, record).id;
        const selected = projectedId === selectedId;
        return {
          ...entityProjection(index, kind, record, selected, selected && selectedOutOfProjection),
          initialProjectionIndex: initialProjectionIds.indexOf(projectedId),
          sourceRank: sourceRecords.indexOf(record),
        };
      })
      .filter(({ id }) => {
        if (seen.has(id)) return false;
        seen.add(id);
        return true;
      });
    return {
      kind,
      label: labels[kind],
      items,
      visibleCount: items.length,
      totalCount: kind === "object" ? index.objects.length : kind === "event" ? index.events.length : index.actors.length,
    };
  });
  return deepFreeze({
    groups,
    empty: groups.every(({ items }) => items.length === 0),
    emptyText: OBJECT_EXPLORER_COPY.emptyResults,
  });
}

function unavailableResultGroups() {
  return deepFreeze({
    groups: [
      { kind: "object", label: "Objecten", items: [], visibleCount: 0, totalCount: 0 },
      { kind: "event", label: "Events / processtappen", items: [], visibleCount: 0, totalCount: 0 },
      { kind: "actor", label: "Actoren", items: [], visibleCount: 0, totalCount: 0 },
    ],
    empty: true,
    emptyText: OBJECT_EXPLORER_COPY.emptyResults,
  });
}

function edgeCandidate(kind, source, target, label, sourceRecordId, order) {
  return {
    key: `${kind}:${source}:${target}:${sourceRecordId}`,
    kind,
    from: source,
    to: target,
    label,
    sourceRecordId,
    order,
  };
}

function graphNeighbors(index, key, controls) {
  const separator = key.indexOf(":");
  const kind = key.slice(0, separator);
  const id = key.slice(separator + 1);
  const edges = [];

  if (kind === "object") {
    if (controls.toggles.objects) {
      const relations = (index.relationsByObject.get(id) || [])
        .filter(({ relation }) =>
          !controls.relationType || sourceId(relation, "relation_type", "type") === controls.relationType,
        )
        .slice(0, 70);
      for (const { relation, index: order, source, target } of relations) {
        edges.push(
          edgeCandidate(
            "object-object",
            `object:${source}`,
            `object:${target}`,
            sourceId(relation, "relation_type", "type") || "objectrelatie",
            sourceId(relation, "relation_id", "id") || `source-order-${order}`,
            order,
          ),
        );
      }
    }
    if (controls.toggles.events) {
      for (const event of (index.eventsByObject.get(id) || []).slice(0, 48)) {
        const eventId = sourceId(event, "event_id", "id");
        edges.push(
          edgeCandidate(
            "object-event",
            `object:${id}`,
            `event:${eventId}`,
            "gebeurtenis–object",
            eventId,
            index.eventOrderOf(event),
          ),
        );
      }
    }
    if (controls.toggles.decisions) {
      for (const decision of (index.decisionsByObject.get(id) || []).slice(0, 24)) {
        const decisionId = sourceId(decision, "decision_id", "id");
        edges.push(
          edgeCandidate(
            "object-decision",
            `object:${id}`,
            `decision:${decisionId}`,
            "besluit",
            decisionId,
            index.decisionOrderOf(decision),
          ),
        );
      }
    }
    if (controls.toggles.communications) {
      for (const communication of (index.communicationsByObject.get(id) || []).slice(0, 24)) {
        const communicationId = sourceId(communication, "communication_id", "id");
        edges.push(
          edgeCandidate(
            "object-communication",
            `object:${id}`,
            `communication:${communicationId}`,
            "communicatie",
            communicationId,
            index.communicationOrderOf(communication),
          ),
        );
      }
    }
  } else if (kind === "event" && controls.toggles.events) {
    const event = index.eventById.get(id);
    if (event) {
      for (const objectId of stringArray(event.object_ids).filter((value) => index.objectById.has(value))) {
        edges.push(
          edgeCandidate("object-event", `object:${objectId}`, key, "gebeurtenis–object", id, 0),
        );
      }
      if (controls.toggles.actors) {
        for (const actorId of stringArray(event.actor_ids).filter((value) => index.actorById.has(value))) {
          edges.push(edgeCandidate("event-actor", key, `actor:${actorId}`, "actor–gebeurtenis", id, 0));
        }
      }
    }
  } else if (kind === "actor" && controls.toggles.actors && controls.toggles.events) {
    for (const event of (index.eventsByActor.get(id) || []).slice(0, 48)) {
      const eventId = sourceId(event, "event_id", "id");
      edges.push(
        edgeCandidate(
          "event-actor",
          `event:${eventId}`,
          key,
          "actor–gebeurtenis",
          eventId,
          index.eventOrderOf(event),
        ),
      );
    }
  } else if (kind === "decision" && controls.toggles.decisions) {
    const decision = index.decisionById.get(id);
    if (decision) {
      for (const objectId of stringArray(decision.object_ids).filter((value) => index.objectById.has(value))) {
        edges.push(edgeCandidate("object-decision", `object:${objectId}`, key, "besluit", id, 0));
      }
    }
  } else if (kind === "communication" && controls.toggles.communications) {
    const communication = index.communicationById.get(id);
    if (communication) {
      const objectIds = [
        ...stringArray(communication.object_ids),
        ...stringArray(communication.related_object_ids),
      ];
      for (const objectId of [...new Set(objectIds)].filter((value) => index.objectById.has(value))) {
        edges.push(
          edgeCandidate("object-communication", `object:${objectId}`, key, "communicatie", id, 0),
        );
      }
    }
  }

  // Admission order is product-significant once the 220-node cap is reached:
  // relations, events, decisions and communications are traversed in that
  // class order.  Each class already applies its authoritative source/time
  // ordering above, so a global re-sort would corrupt the BFS frontier.
  return edges;
}

function graphNode(index, key, centerKey, hop) {
  const separator = key.indexOf(":");
  const kind = key.slice(0, separator);
  const id = key.slice(separator + 1);
  if (CANONICAL_KINDS.has(kind)) {
    const record = lookupEntity(index, kind, id);
    if (!record) return null;
    const entity = canonicalEntity(
      kind,
      record,
      kind === "actor" ? index.participationByActor.get(id) : null,
    );
    const graphLabel =
      kind === "object" ? id : kind === "event" ? eventStepId(record) : actorName(record);
    const graphSubtitle =
      kind === "object"
        ? objectType(record)
        : kind === "event"
          ? eventStepName(record)
          : actorRoleLabel(record, index.roleDefinitions);
    return {
      ...entity,
      graphLabel,
      graphSubtitle,
      center: key === centerKey,
      selectable: true,
      hop,
    };
  }
  if (kind === "decision") {
    const record = index.decisionById.get(id);
    if (!record) return null;
    return {
      key,
      kind,
      id,
      label: sourceId(record, "action_family") || id,
      subtitle: sourceId(record, "selected_action"),
      graphLabel: sourceId(record, "action_family") || id,
      graphSubtitle: sourceId(record, "selected_action"),
      center: false,
      selectable: false,
      hop,
    };
  }
  if (kind === "communication") {
    const record = index.communicationById.get(id);
    if (!record) return null;
    return {
      key,
      kind,
      id,
      label: communicationDisplayType(record) || sourceId(record, "channel") || id,
      subtitle: sourceId(record, "content_summary"),
      graphLabel: communicationDisplayType(record) || id,
      graphSubtitle: sourceId(record, "content_summary", "channel"),
      center: false,
      selectable: false,
      hop,
    };
  }
  return null;
}

function graphModelKey(datasetKey, selection, controls) {
  if (!selection || (selection.kind === "actor" && selection.participation?.mode === "INVENTORY_ONLY")) {
    return null;
  }
  return [
    datasetKey,
    selection.kind,
    selection.id,
    controls.depth,
    controls.relationType || "*",
    ...Object.entries(controls.toggles).map(([key, value]) => `${key}:${value ? 1 : 0}`),
  ].join("|");
}

function buildUnavailableGraph() {
  return deepFreeze({
    state: "UNAVAILABLE",
    modelKey: null,
    nodes: [],
    edges: [],
    title: "Onvoldoende data/context — capability niet beschikbaar.",
    body: OBJECT_EXPLORER_COPY.unavailable,
    projectionNotice: null,
    diagnostics: { visibleEdgeCount: 0, sourceCandidateEdgeCount: 0, excludedSourceEdgeCount: 0, excludedSourceEdgeKeys: [] },
    layoutContract: null,
  });
}

function buildGraph(index, selection, controls, datasetKey) {
  if (!selection) {
    return deepFreeze({
      state: "NEUTRAL",
      modelKey: null,
      nodes: [],
      edges: [],
      title: OBJECT_EXPLORER_COPY.neutralGraphTitle,
      body: OBJECT_EXPLORER_COPY.neutralGraphBody,
      projectionNotice: null,
      diagnostics: { visibleEdgeCount: 0, sourceCandidateEdgeCount: 0, excludedSourceEdgeCount: 0, excludedSourceEdgeKeys: [] },
      layoutContract: null,
    });
  }
  if (selection.kind === "actor" && selection.participation?.mode === "INVENTORY_ONLY") {
    return deepFreeze({
      state: "INVENTORY_ONLY",
      modelKey: null,
      nodes: [],
      edges: [],
      title: OBJECT_EXPLORER_COPY.inventoryOnlyGraphTitle,
      body: OBJECT_EXPLORER_COPY.inventoryOnlyGraphBody,
      projectionNotice: null,
      diagnostics: { visibleEdgeCount: 0, sourceCandidateEdgeCount: 0, excludedSourceEdgeCount: 0, excludedSourceEdgeKeys: [] },
      layoutContract: null,
    });
  }

  const modelKey = graphModelKey(datasetKey, selection, controls);
  const centerKey = `${selection.kind}:${selection.id}`;
  const queue = [{ key: centerKey, hop: 0 }];
  const hops = new Map([[centerKey, 0]]);
  const discoveredEdges = new Map();

  for (let cursor = 0; cursor < queue.length && queue.length <= 220; cursor += 1) {
    const current = queue[cursor];
    if (current.hop >= controls.depth) continue;
    for (const edge of graphNeighbors(index, current.key, controls)) {
      // RC3.23 stops admitting both nodes and edges as soon as the shared BFS
      // cap is reached.  Continuing to add edges between already seen nodes
      // after that point changes the capped topology.
      if (hops.size >= 220) break;
      const neighbor = edge.from === current.key ? edge.to : edge.from;
      if (!graphNode(index, neighbor, centerKey, current.hop + 1)) continue;
      if (!hops.has(neighbor)) {
        if (hops.size >= 220) continue;
        hops.set(neighbor, current.hop + 1);
        queue.push({ key: neighbor, hop: current.hop + 1 });
      }
      if (hops.get(neighbor) <= controls.depth) discoveredEdges.set(edge.key, edge);
    }
  }

  const nodes = [...hops.entries()]
    .map(([key, hop]) => graphNode(index, key, centerKey, hop))
    .filter(Boolean)
    .sort((left, right) => left.hop - right.hop || (left.center ? -1 : right.center ? 1 : localeCompare(left.key, right.key)));
  const edges = [...discoveredEdges.values()]
    .map(({ order: _order, ...edge }) => edge)
    .sort((left, right) => localeCompare(left.kind, right.kind) || localeCompare(left.key, right.key));
  const includedKeys = new Set(hops.keys());
  const sourceCandidateEdges = new Map();
  for (const key of includedKeys) {
    for (const edge of graphNeighbors(index, key, controls)) {
      if (includedKeys.has(edge.from) && includedKeys.has(edge.to)) {
        sourceCandidateEdges.set(edge.key, edge);
      }
    }
  }
  const excludedSourceEdgeKeys = [...sourceCandidateEdges.keys()]
    .filter((key) => !discoveredEdges.has(key))
    .sort(localeCompare);
  const projectionNotice =
    controls.toggles.actors && !controls.toggles.events && ["object", "actor"].includes(selection.kind)
      ? OBJECT_EXPLORER_COPY.projectionNotice
      : null;
  return deepFreeze({
    state: "READY",
    modelKey,
    nodes,
    edges,
    title: selection.label,
    body: selection.subtitle,
    projectionNotice,
    diagnostics: {
      visibleEdgeCount: edges.length,
      sourceCandidateEdgeCount: sourceCandidateEdges.size,
      excludedSourceEdgeCount: excludedSourceEdgeKeys.length,
      excludedSourceEdgeKeys,
    },
    layoutContract: {
      kind: selection.kind === "object" ? "OBJECT_CENTER_WORLD" : "RADIAL_BFS_WORLD",
      objectWorld: { width: 1420, height: 1040, center: { x: 710, y: 520 }, radii: [300, 430] },
      radial: { startRadius: 270, ringDistance: 245, minimumSpacing: 205, margin: 150 },
      nodeCap: 220,
    },
  });
}

function journeyEventRecord(index, event, type, order, contextSuffix = "") {
  const process = processName(index.model, event.process_id);
  return {
    key: `${type}:${sourceId(event, "event_id", "id")}`,
    time: eventTime(event),
    type,
    title: stepTitle(event),
    context: [process, contextSuffix].filter(Boolean).join(" · "),
    order,
  };
}

function journeyDecisionRecord(index, decision, order) {
  return {
    key: `decision:${sourceId(decision, "decision_id", "id")}`,
    time: decisionTime(decision),
    type: "Beslissing",
    title: sourceId(decision, "action_family", "decision_id", "id"),
    context: sourceId(decision, "selected_action"),
    order,
  };
}

// Display projection only: never rewrite the canonical communication record.
function communicationDisplayType(record) {
  // Authority v2 OA2-DISPLAY-001: preserve the canonical source interaction_type.
  return sourceId(record, "interaction_type");
}

function journeyCommunicationRecord(index, communication, order) {
  return {
    key: `communication:${sourceId(communication, "communication_id", "id")}`,
    time: communicationTime(communication),
    type: "Communicatie",
    title: communicationDisplayType(communication) || sourceId(communication, "communication_id", "id"),
    context: sourceId(communication, "content_summary", "channel"),
    order,
  };
}

function buildJourney(index, selection) {
  if (!selection) {
    return deepFreeze({
      state: "NEUTRAL",
      heading: "Entity Journey",
      copy: OBJECT_EXPLORER_COPY.neutralJourney,
      total: 0,
      records: [],
    });
  }
  if (selection.kind === "actor" && selection.participation?.mode === "INVENTORY_ONLY") {
    return deepFreeze({
      state: "INVENTORY_ONLY",
      heading: OBJECT_EXPLORER_COPY.inventoryOnlyJourneyTitle,
      copy: OBJECT_EXPLORER_COPY.inventoryOnlyJourneyBody,
      total: 0,
      records: [],
    });
  }

  const records = [];
  if (selection.kind === "object") {
    for (const event of index.eventsByObject.get(selection.id) || []) {
      records.push(journeyEventRecord(index, event, "Event", index.eventOrderOf(event)));
    }
    for (const decision of index.decisionsByObject.get(selection.id) || []) {
      records.push(journeyDecisionRecord(index, decision, index.decisionOrderOf(decision)));
    }
    for (const communication of index.communicationsByObject.get(selection.id) || []) {
      records.push(
        journeyCommunicationRecord(index, communication, index.communicationOrderOf(communication)),
      );
    }
  } else if (selection.kind === "actor") {
    for (const event of index.eventsByActor.get(selection.id) || []) {
      const objectContext = stringArray(event.object_ids).length
        ? `objecten ${stringArray(event.object_ids).join(", ")}`
        : "";
      records.push(
        journeyEventRecord(index, event, "Event", index.eventOrderOf(event), objectContext),
      );
    }
    for (const decision of index.decisions.filter(
      (record) => sourceId(record, "actor_id") === selection.id,
    )) {
      records.push(journeyDecisionRecord(index, decision, index.decisionOrderOf(decision)));
    }
  } else {
    const selectedEvent = index.eventById.get(selection.id);
    const objectIds = new Set(stringArray(selectedEvent?.object_ids));
    if (selectedEvent) {
      const context = [
        stringArray(selectedEvent.object_ids).length
          ? `objecten ${stringArray(selectedEvent.object_ids).join(", ")}`
          : "",
        stringArray(selectedEvent.actor_ids).length
          ? `actoren ${stringArray(selectedEvent.actor_ids).join(", ")}`
          : "",
      ]
        .filter(Boolean)
        .join(" · ");
      records.push(
        journeyEventRecord(index, selectedEvent, "Geselecteerd event", index.eventOrderOf(selectedEvent), context),
      );
    }
    const relatedEvents = new Map();
    for (const objectId of objectIds) {
      for (const event of index.eventsByObject.get(objectId) || []) {
        const id = sourceId(event, "event_id", "id");
        if (id !== selection.id) relatedEvents.set(id, event);
      }
    }
    for (const event of relatedEvents.values()) {
      records.push(
        journeyEventRecord(index, event, "Gerelateerd event", index.eventOrderOf(event)),
      );
    }
    const relatedDecisions = new Map();
    for (const objectId of objectIds) {
      for (const decision of index.decisionsByObject.get(objectId) || []) {
        relatedDecisions.set(sourceId(decision, "decision_id", "id"), decision);
      }
    }
    for (const decision of relatedDecisions.values()) {
      records.push(journeyDecisionRecord(index, decision, index.decisionOrderOf(decision)));
    }
  }

  const sorted = records.sort(ascendingTime);
  const projected = sorted.slice(0, 500).map(({ order: _order, ...record }) => record);
  return deepFreeze({
    state: "READY",
    heading: "Entity Journey",
    copy: `Chronologische context van ${selection.label} · ${sorted.length} records.`,
    total: sorted.length,
    records: projected,
    emptyText: "Geen journey-records gevonden.",
  });
}

function detailAndLifecycle(index, selection) {
  if (!selection) {
    return deepFreeze({
      detail: { state: "NEUTRAL", heading: "Objectdetail", copy: OBJECT_EXPLORER_COPY.neutralDetail, rows: [] },
      lifecycle: {
        state: "NEUTRAL",
        heading: "Lifecycle-samenvatting",
        copy: OBJECT_EXPLORER_COPY.neutralDetail,
