      if (edge.from === edge.to || Number(edge.count || 0) < threshold) continue;
      mainIds.add(edge.from); mainIds.add(edge.to);
    }
    const maxNodeCount = Math.max(0, ...orderedNodes.map(node => Number(node.count || 0)));
    if (mainIds.size < Math.min(4, orderedNodes.length)) {
      for (const node of orderedNodes) if (Number(node.count || 0) >= maxNodeCount * 0.5) mainIds.add(node.id);
    }
    if (!mainIds.size) orderedNodes.forEach(node => mainIds.add(node.id));
    const main = orderedNodes.filter(node => mainIds.has(node.id));
    const auxiliary = orderedNodes.filter(node => !mainIds.has(node.id));
    main.forEach((node, index) => { positions[node.id] = { x: 120 + index * 230, y: 180 }; });
    const order = orderByProcess.get(processId) || [];
    const lastMainX = Math.max(120, ...main.map(node => positions[node.id].x));
    const mainOrderX = node => Math.max(120, Math.min(lastMainX, 120 + Math.max(0, order.indexOf(node.activityId)) * 230));
