  }
  const record = lookupEntity(index, selection.kind, selection.id);
  if (!record) return detailAndLifecycle(index, null);

  if (selection.kind === "object") {
    const relationCount = (index.relationsByObject.get(selection.id) || []).length;
    return deepFreeze({
      detail: {
        state: "READY",
        heading: "Objectdetail",
        copy: null,
        rows: [
          { term: "ID", value: selection.id, format: "text" },
          { term: "Type", value: objectType(record), format: "text" },
          { term: "Naam", value: objectName(record), format: "text" },
          { term: "Status", value: sourceId(record, "lifecycle_status", "status"), format: "text" },
          { term: "Attributen", value: record.attributes || {}, format: "json" },
        ],
      },
      lifecycle: {
        state: "READY",
        heading: "Lifecycle-samenvatting",
        copy: null,
        metrics: [
          { label: "Events", value: (index.eventsByObject.get(selection.id) || []).length },
          { label: "Besluiten", value: (index.decisionsByObject.get(selection.id) || []).length },
          { label: "Relaties", value: relationCount },
        ],
      },
    });
  }
  if (selection.kind === "event") {
    return deepFreeze({
      detail: {
        state: "READY",
        heading: "Objectdetail",
        copy: null,
        rows: [
          { term: "Type", value: "Event / processtap", format: "text" },
          { term: "ID", value: selection.id, format: "text" },
          { term: "Processtap", value: stepTitle(record), format: "text" },
          { term: "Proces", value: processName(index.model, record.process_id), format: "text" },
          { term: "Tijdstip", value: eventTime(record), format: "text" },
          { term: "Gekoppelde objecten", value: stringArray(record.object_ids).join(", "), format: "text" },
          { term: "Actoren", value: stringArray(record.actor_ids).join(", "), format: "text" },
        ],
      },
      lifecycle: {
        state: "READY",
        heading: "Lifecycle-samenvatting",
        copy: null,
        metrics: [
          { label: "Objecten", value: stringArray(record.object_ids).length },
          { label: "Actoren", value: stringArray(record.actor_ids).length },
          { label: "Proces", value: processName(index.model, record.process_id) },
        ],
      },
    });
  }

  const events = index.eventsByActor.get(selection.id) || [];
  const processes = [...new Set(events.map(({ process_id: id }) => id).filter(Boolean))];
  const objects = new Set(events.flatMap(({ object_ids: ids }) => stringArray(ids)));
  return deepFreeze({
    detail: {
      state: "READY",
      heading: "Objectdetail",
      copy: null,
      rows: [
        { term: "Type", value: "Actor", format: "text" },
        { term: "ID", value: selection.id, format: "text" },
        { term: "Naam", value: actorName(record), format: "text" },
        { term: "Rol", value: actorRoleLabel(record, index.roleDefinitions), format: "text" },
        {
          term: "Processen",
          value: processes.map((id) => processName(index.model, id)).join(", "),
          format: "text",
        },
      ],
      participation: selection.participation,
    },
    lifecycle: {
      state: "READY",
      heading: "Lifecycle-samenvatting",
      copy: null,
      metrics: [
        { label: "Events", value: events.length },
        { label: "Objecten", value: objects.size },
        { label: "Processen", value: processes.length },
      ],
    },
  });
}

/**
 * Pure, source-backed read API for one canonical model. It deliberately exposes
 * no mutable indexes and never consults ground truth, benchmark or other routes.
 */
function createObjectExplorerQuery(model, { datasetKey = model?.bundleId || "external" } = {}) {
  if (!model || typeof model !== "object") throw new TypeError("Object Explorer query requires a canonical model");
  const index = createIndex(model);
  const capability = capabilityFor(model);
  const inventoryView = inventory(index);
  const relationTypes = deepFreeze(
    [...new Set(model.relations.map((relation) => sourceId(relation, "relation_type", "type")).filter(Boolean))]
      .sort(localeCompare),
  );

  return Object.freeze({
    datasetKey,
    capability,

    getInventory() {
      return inventoryView;
    },

    getRelationTypes() {
      return relationTypes;
    },

    findEntity(kind, id) {
      if (capability.state === "UNAVAILABLE") return null;
      if (!CANONICAL_KINDS.has(kind)) return null;
      const record = lookupEntity(index, kind, id);
      return record ? entityProjection(index, kind, record) : null;
    },

    getResults(controls, selection = null) {
      if (capability.state === "UNAVAILABLE") return unavailableResultGroups();
      return resultGroups(index, controls, selection);
    },

    getGraph(selection, controls) {
      if (capability.state === "UNAVAILABLE") return buildUnavailableGraph();
      return buildGraph(index, selection, controls, datasetKey);
    },

    getJourney(selection) {
      if (capability.state === "UNAVAILABLE") {
        return deepFreeze({
          state: "UNAVAILABLE",
          heading: "Entity Journey",
          copy: OBJECT_EXPLORER_COPY.unavailable,
          total: 0,
          records: [],
        });
      }
      return buildJourney(index, selection);
    },

    getDetail(selection) {
      if (capability.state === "UNAVAILABLE") {
        return deepFreeze({
          detail: {
            state: "UNAVAILABLE",
            heading: "Objectdetail",
            copy: OBJECT_EXPLORER_COPY.unavailable,
            rows: [],
          },
          lifecycle: {
            state: "UNAVAILABLE",
            heading: "Lifecycle-samenvatting",
            copy: OBJECT_EXPLORER_COPY.unavailable,
            metrics: [],
          },
        });
      }
      return detailAndLifecycle(index, selection);
    },
  });
}

function datasetKeyFor(snapshot) {
  if (!snapshot?.model) return null;
  return `${snapshot.source.kind}:${snapshot.source.id}:${snapshot.model.bundleId}:g${snapshot.generation}`;
}

function initialControllerState(snapshot) {
  const datasetKey = datasetKeyFor(snapshot);
  return deepFreeze({
    datasetKey,
    datasetGeneration: snapshot?.generation || 0,
    selection: null,
    ...defaultControls(),
    graphModelKey: null,
    manualPositions: {},
    scale: OBJECT_EXPLORER_DEFAULTS.scale,
    scroll: { ...OBJECT_EXPLORER_DEFAULTS.scroll },
    viewportAnchor: OBJECT_EXPLORER_DEFAULTS.viewportAnchor,
    revision: 0,
  });
}

function controlsFromState(state) {
  return deepFreeze({
    view: state.view,
    kindFilter: state.kindFilter,
    query: state.query,
    depth: state.depth,
    relationType: state.relationType,
    participationFilter: state.participationFilter,
      actorRoleFilter: state.actorRoleFilter,
    toggles: state.toggles,
  });
}

function sameValue(left, right) {
  return JSON.stringify(left) === JSON.stringify(right);
}

function contextSelection(selection) {
  return selection
    ? { id: selection.id, label: selection.label, kind: selection.kind }
    : null;
}

function transactCanonicalContext(contextStore, name, selection) {
  if (!contextStore) return false;
  if (typeof contextStore.transact !== "function") {
    throw new TypeError("Object Explorer contextStore must expose transact(name, updater)");
  }
  return contextStore.transact(name, (draft) => {
    draft.process = null;
    draft.pattern = null;
    draft.variant = null;
    draft.case = null;
    draft.decision = null;
    draft.entity = contextSelection(selection);
    draft.object = selection?.kind === "object" ? contextSelection(selection) : null;
    draft.caseSet = null;
    draft.population = null;
    draft.navigationPolicy = null;
  });
}

/**
 * Single-owner Object Explorer application controller. It subscribes only to the
 * canonical Runtime Store and publishes one immutable commit per accepted action.
 */
function createObjectExplorerController({ runtimeStore, contextStore = null, scopeService = null, onListenerError = () => {} } = {}) {
  if (!runtimeStore || typeof runtimeStore.snapshot !== "function" || typeof runtimeStore.subscribe !== "function") {
    throw new TypeError("Object Explorer controller requires a Runtime Store");
  }
  let runtimeSnapshot = runtimeStore.snapshot();
  let objectProjection = runtimeSnapshot.model
    ? projectObjectExplorerModel(runtimeSnapshot.model)
    : null;
  let query = objectProjection
    ? createObjectExplorerQuery(objectProjection.model, { datasetKey: datasetKeyFor(runtimeSnapshot) })
    : null;
  let state = initialControllerState(runtimeSnapshot);
  let cachedViewModel = null;
  let cachedViewState = null;
  let appliedScope=null,scopedProjection=null;
  let listPosition=null;
  const listeners = new Set();

  function notify(type, previous, meta = {}) {
    const event = deepFreeze({ type, previous, current: state, ...meta });
    for (const listener of listeners) {
      try {
        listener(event);
      } catch (error) {
        onListenerError(error, event);
      }
    }
  }

  function commit(type, candidate, { context = undefined, meta = {} } = {}) {
    const nextCandidate = typeof candidate === "function" ? candidate(state) : candidate;
    const next = deepFreeze({ ...nextCandidate, revision: state.revision + 1 });
    const stateChanged = !sameValue({ ...state, revision: 0 }, { ...next, revision: 0 });
    if (!stateChanged) {
      const contextChanged =
        context !== undefined ? transactCanonicalContext(contextStore, type, context) : false;
      if (!contextChanged) return false;
      const previous = state;
      state = next;
      cachedViewModel = null;
      cachedViewState = null;
      notify(type, previous, meta);
      return true;
    }
    const previous = state;
    // State is installed before Research Context emits. Both context listeners and
    // controller listeners therefore observe the same canonical selection.
    state = next;
    cachedViewModel = null;
    cachedViewState = null;
    if (context !== undefined) transactCanonicalContext(contextStore, type, context);
    notify(type, previous, meta);
    return true;
  }

  function currentControls() {
    return controlsFromState(state);
  }

  function selectedEntity(kind, id, source) {
    synchronizeScope();
    if (!query) return null;
    const entity = query.findEntity(kind, id);
