        adviceRecord: adviceController.getInterventionPackage(),
        simulationRecord: simulationController.getScenarioResult(),
        benchmarkRecord: benchmarkController.getResult(),
        benchmarkViewModel: benchmarkController.getViewModel(),
        reviewRecord: researcherReviewController.getReviewRecord(),
        lastReviewRecord: researcherReviewController.getLastReviewRecord?.() || null,
        runtimeIdentity,
        exportedAt,
      });
      lastExport = deepFreeze({ exportedAt: packageValue.exportedAt, scopeKey: packageValue.researchScope.key, sourceKey: packageValue.researchScope.sourceKey });
      emit("package-created", false);
      return packageValue;
    },
    suggestFilename(exportedAt = new Date()) {
      const { r, snapshot } = current();
      const stamp = isoFileStamp(exportedAt);
      return `PRO004_EVIDENCE_${cleanFilePart(snapshot.source?.id || r.summary?.sourceKey || "source")}_${stamp}.json`;
    },
    subscribe(fn) { if (typeof fn !== "function") throw new TypeError("Listener must be function"); if (destroyed) return () => {}; listeners.add(fn); return () => listeners.delete(fn); },
    destroy() { if (destroyed) return; destroyed = true; subscriptions.forEach(off => off()); listeners.clear(); lastExport = null; },
  };
  return Object.freeze(api);
}

function isoFileStamp(value) {
  const date = value instanceof Date ? value : new Date(value);
  if (!Number.isFinite(date.getTime())) throw new RangeError("Invalid export date");
  return date.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
}

return Object.freeze({"createEvidencePackageController":createEvidencePackageController});
},
