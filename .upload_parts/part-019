function graphFor(model, selectedCases, processId, sourceActivityName = activityName, sourceActivityPresentation = null) {
  const nodeMap = new Map();
  const edgeMap = new Map();
  for (const item of selectedCases) {
    const processEvents = item.events.filter(processMapEvent);
    const caseSeen = new Set();
    for (const event of processEvents) {
      const id = nodeId(event, processId);
      if (!id) continue;
      if (!nodeMap.has(id)) {
        const sourceActivityId = String(event.activity_id || event.event_type || "");
        const presentation = typeof sourceActivityPresentation === "function"
          ? sourceActivityPresentation(String(event.process_id || ""), sourceActivityId)
          : null;
        nodeMap.set(id, {
          id,
          processId: String(event.process_id || ""),
          activityId: sourceActivityId,
          displayCode: presentation?.code || compactActivityCode(sourceActivityId),
          displayLabels: presentation?.labels || null,
          label: sourceActivityName(sourceActivityId, event.event_type),
          count: 0,
          caseCount: 0,
          events: [],
        });
      }
      const node = nodeMap.get(id);
      node.count += 1;
      node.events.push(event);
      if (!caseSeen.has(id)) {
        node.caseCount += 1;
        caseSeen.add(id);
      }
    }
    for (let index = 0; index < processEvents.length - 1; index += 1) {
      const fromEvent = processEvents[index];
      const toEvent = processEvents[index + 1];
      const from = nodeId(fromEvent, processId);
      const to = nodeId(toEvent, processId);
      if (!from || !to) continue;
      const key = `${from}→${to}`;
      if (!edgeMap.has(key)) edgeMap.set(key, { from, to, count: 0, durationHours: 0, durationSamples: 0 });
      const edge = edgeMap.get(key);
      edge.count += 1;
      const fromTime = Date.parse(eventTime(fromEvent));
      const toTime = Date.parse(eventTime(toEvent));
      if (Number.isFinite(fromTime) && Number.isFinite(toTime) && toTime >= fromTime) {
        edge.durationHours += (toTime - fromTime) / 3_600_000;
        edge.durationSamples += 1;
      }
    }
  }

  const nodes = [...nodeMap.values()].map((node) => {
    const { events, ...publicNode } = node;
    return {
      ...publicNode,
      topActors: topActors(model, events),
    };
  });
  const activityRanks = new Map(
    processOrder(model).map((pid) => [pid, new Map(orderedActivities(model, pid).map((id, index) => [id, index]))]),
  );
  const nodeById = new Map(nodes.map((node) => [node.id, node]));
  const edges = [...edgeMap.values()].map((edge) => ({
    from: edge.from,
    to: edge.to,
    count: edge.count,
    avgHours: edge.durationSamples ? edge.durationHours / edge.durationSamples : null,
    kind: edgeKind(nodeById.get(edge.from), nodeById.get(edge.to), processId, activityRanks),
  }));
  const layout = defaultPositions(model, processId, nodes, edges);
  return { nodes, edges, ...layout };
}

function processColor(processId) {
  if (processId === "P-INVOICE") return "#6d4aff";
  if (processId === "P-COMPLAINT") return "#c85b15";
  if (processId === "P-INCIDENT") return "#0e6b75";
