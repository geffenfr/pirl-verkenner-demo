  return String(caseRecord?.display_case_id || caseRecord?.case_object_id || caseRecord?.case_id || caseRecord?.case_key || "");
}

function outcomeType(outcome) {
  return String(outcome?.outcome_type || outcome?.type || "").toUpperCase();
}

function linkedRecords(records, ids) {
  return records.filter((record) => objectIds(record).some((id) => ids.has(id)));
}

function outcomeOf(records, type) {
  return records.find((outcome) => outcomeType(outcome) === type) || null;
}

function numericMeasure(outcome, key) {
  const raw = outcome?.measures?.[key];
  if (raw == null || typeof raw === "boolean" || (typeof raw === "string" && !raw.trim())) return null;
  const value = Number(raw);
  return Number.isFinite(value) ? value : null;
}

function enrichCanonicalCase(model, caseRecord, objectById, relationsByObject, outcomesByObject) {
  const rootId = String(caseRecord.case_object_id || caseRecord.display_case_id || "");
  const ids = new Set([rootId]);
  for (const event of caseRecord.events || []) objectIds(event).forEach((id) => ids.add(id));
  for (const relation of relationsByObject.get(rootId) || []) {
    const source = sourceId(relation, "source_object_id", "source_id");
    const target = sourceId(relation, "target_object_id", "target_id");
    if (source) ids.add(source);
    if (target) ids.add(target);
  }
  const outcomes = outcomesByObject.get(rootId) || [];
  const complaint = [...ids].some((id) => objectType(objectById.get(id)) === "complaint");
  return {
    id: caseId(caseRecord),
    caseKey: JSON.stringify([String(caseRecord.process_id || ""), String(caseRecord.case_key || caseRecord.case_id || "")]),
    processId: caseRecord.process_id,
    caseObjectId: rootId,
    caseObjectType: String(caseRecord.case_object_type || objectType(objectById.get(rootId)) || ""),
    events: [...(caseRecord.events || [])].sort(eventSort),
    complaint,
    processOutcome: outcomeOf(outcomes, "PROCESS"),
    financialOutcome: outcomeOf(outcomes, "FINANCIAL"),
    outcomes,
  };
}

function buildCanonicalJourneys(model, metricReferenceModel = model) {
  const objectById = new Map(
    (metricReferenceModel.objects || []).map((record) => [sourceId(record, "object_id", "id"), record]).filter(([id]) => id),
  );
  const relationsByObject = new Map();
  for (const relation of metricReferenceModel.relations || []) {
    for (const id of [
      sourceId(relation, "source_object_id", "source_id"),
      sourceId(relation, "target_object_id", "target_id"),
    ]) {
      if (!id) continue;
      if (!relationsByObject.has(id)) relationsByObject.set(id, []);
      relationsByObject.get(id).push(relation);
    }
  }
  // Query-local only: preserve original record order and one contribution per
  // outcome even when object_ids repeats. Rebuilt for every model/scope query.
  const outcomesByObject = new Map();
  for (const outcome of model.outcomes || []) {
    for (const id of new Set(objectIds(outcome))) {
      if (!outcomesByObject.has(id)) outcomesByObject.set(id, []);
      outcomesByObject.get(id).push(outcome);
    }
  }
  return (model.cases || []).map((record) => enrichCanonicalCase(model, record, objectById, relationsByObject, outcomesByObject));
}

function buildNovaServeJourneys(model) {
  const objectById = new Map(
    (model.objects || []).map((record) => [sourceId(record, "object_id", "id"), record]).filter(([id]) => id),
  );
  const incidents = (model.objects || [])
    .filter((record) => objectType(record) === "incident")
    .sort((left, right) => sourceId(left, "object_id", "id").localeCompare(sourceId(right, "object_id", "id")));

  return incidents.map((incident) => {
    const rootId = sourceId(incident, "object_id", "id");
    const reached = new Set([rootId]);
    for (let round = 0; round < 8; round += 1) {
      let changed = false;
      for (const relation of model.relations || []) {
        const type = relationType(relation);
        const source = sourceId(relation, "source_object_id", "source_id");
        const target = sourceId(relation, "target_object_id", "target_id");
        if (NOVA_FORWARD_RELATIONS.has(type) && reached.has(source) && target && !reached.has(target)) {
          reached.add(target);
          changed = true;
        }
        if (NOVA_REVERSE_RELATIONS.has(type) && reached.has(target) && source && !reached.has(source)) {
          reached.add(source);
          changed = true;
        }
      }
      if (!changed) break;
    }

    const specific = new Set(
      [...reached].filter((id) => {
        if (id === rootId) return true;
        const type = objectType(objectById.get(id));
        return type && !GENERIC_NOVA_TYPES.has(type);
      }),
    );
    const events = linkedRecords(model.events || [], specific)
      .filter((event) => event.process_id)
      .sort(eventSort);
    const outcomes = linkedRecords(model.outcomes || [], specific).sort((left, right) =>
      timestampRank(left.timestamp) - timestampRank(right.timestamp),
    );
    const complaint = [...specific].some((id) => objectType(objectById.get(id)) === "complaint");
    return {
      id: rootId,
      processId: "P-INCIDENT",
      caseObjectId: rootId,
      caseObjectType: "incident",
      events,
      complaint,
      processOutcome: outcomeOf(outcomes, "PROCESS"),
      financialOutcome: outcomeOf(outcomes, "FINANCIAL"),
      outcomes,
    };
  });
}

function processOrder(model) {
  const known = model.bundleId === NOVASERVE_BUNDLE
    ? NOVA_ORDER
    : model.bundleId === BANK_BUNDLE
      ? BANK_ORDER
      : [];
  const discovered = [];
  const seen = new Set();
  for (const processId of [
    ...known,
    ...(model.events || []).map((event) => event.process_id),
    ...(model.processes || []).map((process) => process.process_id),
  ]) {
    if (!processId || seen.has(processId)) continue;
    seen.add(processId);
    discovered.push(processId);
  }
  return discovered;
}

function orderedActivities(model, processId) {
  const known = ACTIVITY_ORDER[processId] || [];
  const seen = new Set();
  const values = [];
  for (const id of [
    ...known,
    ...(model.events || []).filter((event) => event.process_id === processId && processMapEvent(event)).map((event) => event.activity_id),
  ]) {
    const activityId = String(id || "");
    if (!activityId || seen.has(activityId)) continue;
    seen.add(activityId);
    values.push(activityId);
  }
  return values;
}

function topActors(model, events) {
  const actorById = new Map(
    (model.actors || []).map((actor) => [sourceId(actor, "actor_id", "id"), actor]),
  );
  const counts = new Map();
  for (const event of events) {
    for (const actorId of Array.isArray(event.actor_ids) ? event.actor_ids : []) {
      counts.set(String(actorId), (counts.get(String(actorId)) || 0) + 1);
    }
  }
  return [...counts.entries()]
    .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]))
    .slice(0, 3)
    .map(([id, count]) => {
      const actor = actorById.get(id);
      const label = actor?.name || actor?.label || actor?.actor_name || actor?.role || id;
      return { id, label: String(label), count };
    });
}

function selectCaseEvents(journey, processId) {
  const events = (journey.events || []).filter((event) => event.process_id && processSequenceEvent(event));
  return processId === ALL ? events : events.filter((event) => event.process_id === processId);
}

function nodeId(event, processId) {
  const activityId = String(event.activity_id || event.event_type || "");
  return processId === ALL ? `${event.process_id || "P-OTHER"}|${activityId}` : activityId;
}

function variantSequence(events, processId) {
  return events
    .map((event) => {
      const activityId = String(event.activity_id || event.event_type || "");
      return processId === ALL
        ? `${String(event.process_id || "P-OTHER").replace(/^P-/, "")}:${activityId}`
        : activityId;
    })
    .join(" → ");
