    ["Integrated", integratedAssessmentController, "getInterventionContext"],
    ["Advice", adviceController, "getInterventionPackage"],
    ["Simulation", simulationController, "getScenarioResult"],
    ["Benchmark", benchmarkController, "getResult"],
    ["Researcher Review", researcherReviewController, "getReviewRecord"],
