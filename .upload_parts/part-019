        research: r,
        genericMeasurementStatus: genericMeasurementService?.getStatus?.() || null,
        measurementContextAudit: normsExplorerController?.getViewModel ? {
          schema: 'pirl.measurement-context-audit.v1',
          role: 'APPLICABILITY_METADATA_NOT_INCLUDED_ANALYTICAL_EVIDENCE',
          sourceKey: r.scope.sourceKey, scopeKey: r.scope.key,
          entries: (normsExplorerController.getViewModel().goals || [])
            .filter(g => g.measurement?.measurementContext)
