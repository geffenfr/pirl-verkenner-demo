    scopeService.subscribe(() => { lastExport = null; emit("research-scope"); }),
    ...(normsExplorerController?.subscribe ? [normsExplorerController.subscribe(() => {lastExport=null;emit("measurement-context");})] : []),
    runtimeStore.subscribe(event => { if (event.type === "DATASET_ACTIVATED") { lastExport = null; emit("dataset"); } }),
    integratedAssessmentController.subscribe(() => { lastExport = null; emit("integrated"); }),
    adviceController.subscribe(() => { lastExport = null; emit("advice"); }),
    simulationController.subscribe(() => { lastExport = null; emit("simulation"); }),
    benchmarkController.subscribe(() => { lastExport = null; emit("benchmark"); }),
    researcherReviewController.subscribe(() => { lastExport = null; emit("review"); }),
  ];

  function current() {
    if (destroyed) throw new Error("Evidence package controller destroyed");
    const r = read();
    const snapshot = runtimeStore.snapshot();
