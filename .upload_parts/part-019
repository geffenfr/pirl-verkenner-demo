function variantGroups(selectedCases, processId) {
  const groups = new Map();
  for (const item of selectedCases) {
    const sequence = variantSequence(item.events, processId);
    if (!groups.has(sequence)) groups.set(sequence, { sequence, cases: [] });
    groups.get(sequence).cases.push(item.journey);
  }
  return [...groups.values()]
    .map((group) => {
      const margins = group.cases
        .map((journey) => numericMeasure(journey.financialOutcome, "case_contribution_margin_eur"))
        .filter(Number.isFinite);
      const cycles = group.cases
        .map((journey) => numericMeasure(journey.processOutcome, "cycle_time_hours"))
        .filter(Number.isFinite);
      return {
        sequence: group.sequence,
        count: group.cases.length,
        complaints: group.cases.filter((journey) => journey.complaint).length,
        avgMargin: margins.length ? margins.reduce((sum, value) => sum + value, 0) / margins.length : 0,
        avgCycle: cycles.length ? cycles.reduce((sum, value) => sum + value, 0) / cycles.length : 0,
