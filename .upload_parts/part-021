const {createEvidenceFileDelivery}=load("src/presentation/evidence-file-delivery.js");



function bindEvidencePackageInteractions({ root, controller, navigate = () => false } = {}) {
  if (!root || !controller) throw new TypeError("Evidence package binding requires root and controller");
  const off = [];
  const bind = (selector, type, fn) => { const el = root.querySelector(selector); if (!el) return; const h = event => fn(event.currentTarget, event); el.addEventListener(type, h); off.push(() => el.removeEventListener(type, h)); };
  bind("#evidence-review", "click", () => navigate("validation.review", "export-action"));
  const win=root.ownerDocument.defaultView;
  const contextToken=()=>{const vm=controller.getViewModel();return `${vm.screenState}|${vm.revision}|${vm.researchScope?.sourceKey||""}|${vm.researchScope?.key||""}`;};
  const delivery=createEvidenceFileDelivery({windowRef:win,contextToken});
  const result=root.querySelector("#evidence-export-result");
  const say=value=>{if(result)setLocalizedText(result,value);};
  const msg=(id,params={})=>translateMessage("l10n02."+id,params,currentLanguage(root));
  const deliveryError=error=>{const value=String(error?.message||error);return currentLanguage(root)==='en'?({"Maak eerst een exportmoment.":"Prepare an export first.","Exportmoment is niet actueel; bereid opnieuw voor.":"Prepared export is stale; prepare it again.","Rond het deelvenster eerst af.":"Finish the share dialog first."}[value]||value):value;};
  const detail=()=>{const d=delivery.describe();return d?msg("export-detail",{filename:d.filename,bytes:d.bytes,hash:d.sha256,sourceKey:d.sourceKey,scopeKey:d.scopeKey,delivery:d.stale?"Niet meer actueel: bereid opnieuw voor.":"Afgifte nog niet bewezen."}):"Geen voorbereid exportmoment.";};
  bind("#evidence-export","click",()=>{
    try{const now=new Date(),value=controller.createEvidencePackage({exportedAt:now});
      if(!value){say("Geen geldige bron/afbakening; geen export voorbereid.");return;}
      delivery.prepare({value,filename:controller.suggestFilename(now),exportedAt:value.exportedAt});
      say(msg("export-prepared",{detail:detail()}));
    }catch(error){say(msg("export-error",{error:deliveryError(error)}));}
  });
  bind("#evidence-share","click",async()=>{try{const r=await delivery.share();say(msg("export-shared",{status:r.status+(r.message?": "+r.message:""),detail:detail()}));}catch(error){say(msg("export-share-error",{error:deliveryError(error),detail:detail()}));}});
  bind("#evidence-download","click",()=>{try{const r=delivery.download();say(msg("export-downloaded",{status:r.status,detail:detail()}));}catch(error){say(msg("export-download-error",{error:deliveryError(error),detail:detail()}));}});
  bind("#evidence-text","click",()=>{try{const r=delivery.download({alternative:true});say(msg("export-text",{status:r.status,detail:detail()}));}catch(error){say(msg("export-text-error",{error:deliveryError(error),detail:detail()}));}});
  bind("#evidence-readback","change",async(el)=>{const file=el.files?.[0];el.value="";const r=await delivery.readback(file);say(msg("export-readback",{status:r.status+(r.message?": "+r.message:""),detail:detail(),verification:r.verified?"Geselecteerde JSON-bytes zijn technisch identiek; dit is geen inhoudelijk of menselijk PASS.":"Geen actuele byteverificatie."}));});
  bind("#evidence-cancel","click",()=>{delivery.cancel();say("Exportmoment geannuleerd. Bron, scenario en review zijn niet gewijzigd.");});
  return Object.freeze({ destroy() { off.forEach(fn => fn());delivery.destroy(); } });
}

return Object.freeze({"bindEvidencePackageInteractions":bindEvidencePackageInteractions});
},
