"src/presentation/screens/simulation-interactions.js":function(load){
"use strict";
const {renderLocalizedMarkup}=load("src/presentation/i18n.js");
const {renderScenarioContextStatus}=load("src/presentation/screens/simulation-context-view.js");
const {renderSimulationResult,renderSimulationParameterStatus}=load("src/presentation/screens/simulation.js");


function bindSimulationInteractions({root,controller,navigate=()=>false,onCommit=()=>{}}={}){
 if(!root||!controller)throw new TypeError("Simulation binder needs root and controller");
 const off=[],doc=root.ownerDocument,win=doc.defaultView;
 function captureFocus(){const a=doc.activeElement;return {id:a?.id||null,start:a?.selectionStart??null,end:a?.selectionEnd??null,x:win.scrollX,y:win.scrollY};}
 function restoreFocus(s){if(!s)return false;const el=s.id?doc.getElementById(s.id):null;el?.focus?.({preventScroll:true});if(s.start!==null&&typeof el?.setSelectionRange==="function")el.setSelectionRange(s.start,s.end);win.scrollTo(s.x,s.y);return Boolean(el);}
 const language=()=>root.querySelector(".simulation-screen")?.dataset.language||"nl";
 function refresh(){const vm=controller.getViewModel(),r=root.querySelector('#sim-result'),b=root.querySelector('#sim-run');if(r)renderLocalizedMarkup(r,renderSimulationResult(vm,language()));if(b)b.disabled=!vm.canRun;const status=root.querySelector('[data-sim-parameter-status]');if(status)renderLocalizedMarkup(status,renderSimulationParameterStatus(vm,language()));const mode=root.querySelector('#sc-mode');if(mode)mode.value=vm.scenarioDraft?.enabled?'HORIZON':'BASELINE';const fields=root.querySelector("[data-sc-dated-fields]");if(fields)fields.hidden=!vm.scenarioDraft?.enabled;const sc=root.querySelector("[data-sc-state]");if(sc)sc.innerHTML=renderScenarioContextStatus(vm,language());}
 function bind(q,event,fn){for(const el of root.querySelectorAll(q)){const h=ev=>{const s=captureFocus(),changed=fn(ev.currentTarget);onCommit({changed:Boolean(changed)&&event!=="input",focusSnapshot:s});};el.addEventListener(event,h);off.push(()=>el.removeEventListener(event,h));}}
 bind('[data-sim-input]','input',el=>controller.setInput(el.dataset.simInput,el.type==="checkbox"?el.checked:el.value));
 bind('[data-local-field]','input',el=>controller.setLocalField(el.dataset.localField,el.type==="checkbox"?el.checked:el.value));
 bind('[data-sc-mode]','change',el=>controller.setScenarioField('enabled',el.value==='HORIZON'));
 bind('[data-sc-field]','input',el=>controller.setScenarioField(el.dataset.scField,el.type==='checkbox'?el.checked:el.value));
 bind('[data-sc-metric]','change',()=>controller.setScenarioField('targetMetrics',[...root.querySelectorAll('[data-sc-metric]:checked')].map(e=>e.dataset.scMetric)));
 bind('#sc-apply','click',()=>controller.applyScenarioContext());
 bind('#sim-outcome' ,'change',el=>controller.selectOutcome(el.value));
 function showCalculatedResult(){
  // Rendering and pending focus restoration finish before moving to the result.
  win.requestAnimationFrame(()=>win.requestAnimationFrame(()=>{
   if(!controller.getScenarioResult())return;
   const result=root.querySelector('#sim-result');if(!result)return;
   const settings=root.querySelector('[data-screen-calculation-settings]');if(settings)settings.open=false;
   result.focus({preventScroll:true});result.scrollIntoView({block:'start',behavior:'auto'});
  }));
 }
 bind('#sim-run','click',()=>{const changed=controller.run();if(changed)showCalculatedResult();return changed;});bind('#sim-reset','click',()=>controller.resetAssumptions());bind('#sim-advice','click',()=>navigate('advice','simulation-action'));
 off.push(controller.subscribe(ev=>{if(ev.render===false)refresh();}));
 return Object.freeze({captureFocus,restoreFocus,destroy(){off.forEach(f=>f());}});
}

return Object.freeze({"bindSimulationInteractions":bindSimulationInteractions});
},
