"src/presentation/screens/advice-interactions.js":function(load){
"use strict";
const {renderLocalizedMarkup,setLocalizedText}=load("src/presentation/i18n.js");
const {escapeHtml}=load("src/presentation/html.js");


/** Stable textarea input: do not recreate the screen for each character. Other
 * changes use the existing registry focus contract, preserving native caret and
 * document position; no synthetic second tap or delayed navigation handler.
 */
function bindAdviceInteractions({root,controller,navigate=()=>false,onCommit=()=>{}}={}){
  if(!root||!controller)throw new TypeError("Advice binder requires root and controller");
  const removers=[];const doc=root.ownerDocument||globalThis.document,win=doc?.defaultView||globalThis.window;
  function captureFocus(){const active=doc?.activeElement;return {id:active?.id||null,start:active?.selectionStart??null,end:active?.selectionEnd??null,
    x:win?.scrollX||0,y:win?.scrollY||0};}
  function restoreFocus(s){if(!s)return false;const el=s.id?doc?.getElementById(s.id):null;
    el?.focus?.({preventScroll:true});if(s.start!==null&&typeof el?.setSelectionRange==="function")el.setSelectionRange(s.start,s.end);
    win?.scrollTo?.(s.x,s.y);return Boolean(el);}
  function footer(){const vm=controller.getViewModel();const selected=root.querySelector('#adv-selected'),status=root.querySelector('#adv-package-status'),button=root.querySelector('#adv-simulation');
    if(selected)renderLocalizedMarkup(selected,'<span>Geselecteerd:</span> '+(vm.cards.filter(c=>c.selected).map(c=>'<span>'+escapeHtml(c.label)+'</span>').join(' · ')||'<span>geen</span>'));
    if(status)setLocalizedText(status,vm.handoffReady?'Interventiepakket vastgelegd; geen simulatie uitgevoerd.':'Nog geen interventiepakket overgedragen.');
    if(button)button.disabled=!vm.canTransfer;}
  function bind(selector,event,fn){for(const el of root.querySelectorAll(selector)){const handler=ev=>{const focusSnapshot=captureFocus();const changed=Boolean(fn(ev.currentTarget));if(event==='input')footer();onCommit({changed:event==='input'?false:changed,focusSnapshot});};
    el.addEventListener(event,handler);removers.push(()=>el.removeEventListener(event,handler));}}
  bind('[data-advice-select]','change',el=>controller.setSelected(el.dataset.adviceSelect,el.checked));
  bind('[data-advice-note]','input',el=>controller.setNote(el.dataset.adviceNote,el.value));
  bind('#adv-all','click',()=>controller.selectAll());bind('#adv-none','click',()=>controller.clearSelection());
  bind('#adv-integrated','click',()=>navigate('integrated'));
  bind('#adv-simulation','click',()=>{if(!controller.prepareSimulationContext())return false;navigate('simulation');return true;});
  return Object.freeze({captureFocus,restoreFocus,destroy(){for(const off of removers.splice(0))off();}});
}

return Object.freeze({"bindAdviceInteractions":bindAdviceInteractions});
},
"src/presentation/screens/research-scope-presentation.js":function(load){
"use strict";
const {escapeHtml:esc}=load("src/presentation/html.js");
const {localizeMarkup}=load("src/presentation/i18n.js");


function renderResearchScopeSummary(vm) {
  const s=vm.researchScope;if(!s)return '';
  const entity=Boolean(s.entity);
  return `<aside class="research-scope-summary" data-research-scope-key="${esc(s.key)}" data-research-scope-status="${esc(s.status)}">
    <strong>Onderzoeksafbakening: ${esc(s.label)}</strong>
    <div>${entity ? `${s.counts.events} directe brongebeurtenissen · ${s.relatedCounts.cases} gekoppelde cases als referentie (geen onderzoeksuitvoeringen)`
      : `${s.counts.cases} canonieke cases · ${s.counts.events} unieke brongebeurtenissen`}</div>
    ${vm.processRole==='CASE_PROCESS_REFERENCE'?'<div>Het getoonde proces is een bronverwijzing van deze case, geen extra vastgezette processelectie.</div>':''}
    ${s.issues.length?`<details data-research-scope-issues><summary>Bron- en afbakeningssignalen (${s.issues.length})</summary><ul>${s.issues.map(i=>`<li>${esc(i.code)} · ${esc(i.collection)} · ${esc(i.id || '')}: ${esc(i.detail)}</li>`).join('')}</ul></details>`:''}
  </aside>`;
}

// Presentation window only; original ordered research records remain unchanged.
const SOURCE_RECORD_PAGE_SIZE=50;
function sourceRecordWindow(rows=[],page=1) {
  const pages=Math.max(1,Math.ceil(rows.length/SOURCE_RECORD_PAGE_SIZE));
  const requested=Number(page),current=Number.isFinite(requested)?Math.max(1,Math.min(pages,Math.trunc(requested))):1;
  const start=(current-1)*SOURCE_RECORD_PAGE_SIZE;
  return {page:current,pages,start,end:Math.min(rows.length,start+SOURCE_RECORD_PAGE_SIZE),total:rows.length,rows:rows.slice(start,start+SOURCE_RECORD_PAGE_SIZE)};
}
function renderDirectEventRecords(rows=[]) {
  return `<div data-research-source-collection data-research-source-total="${rows.length}"><div data-research-source-controls></div><div data-research-source-page></div></div>`;
}
function renderDirectEventPage(rows=[],page=1) {
  const window=sourceRecordWindow(rows,page);
  return window.rows.map((row,offset)=>`<details class="research-source-record" data-research-event-lazy data-research-event-key="${esc(row.key)}" data-research-event-index="${window.start+offset}"><summary><span${row.id ? ' data-i18n-source-value' : ''}>${esc(row.id || 'Bronrij zonder event-ID')}</span> · <span${row.activityLabelIsSource ? " data-i18n-source-value" : ""}>${esc(row.activityLabel)}</span> · <span${row.processLabelIsSource ? " data-i18n-source-value" : ""}>${esc(row.processLabel)}</span></summary><div data-research-event-body></div></details>`).join('');
}

function eventRecordBody(row) {
  return `<dl><dt>Tijdstip (bron)</dt><dd${row.timestamp ? ' data-i18n-source-value' : ''}>${esc(row.timestamp || 'Niet beschikbaar')}</dd><dt>Object-ID’s</dt><dd data-i18n-source-value>${esc(row.objectIds.join(', ') || '—')}</dd><dt>Actor-ID’s</dt><dd data-i18n-source-value>${esc(row.actorIds.join(', ') || '—')}</dd><dt>Bronrij(en)</dt><dd>${esc(row.sourceRows.join(', '))}</dd></dl><details data-research-raw-lazy><summary>Volledig bronrecord</summary><pre></pre></details>`;
}

function bindResearchSourceRecords({root,viewModel,language="nl"}={}) {
  let rows=viewModel?.directEvidence || [];viewModel=undefined;
  let active=true;
  const states=new Map();
  const filled=new WeakSet();
  function show(collection,page=1) {
    if(!active || !root.contains(collection))return;
    const w=sourceRecordWindow(rows,page),en=language==='en';states.set(collection,w.page);
    const range=en?`Source records ${w.total?w.start+1:0}–${w.end} of ${w.total} · page ${w.page} of ${w.pages}`:`Bronrecords ${w.total?w.start+1:0}–${w.end} van ${w.total} · pagina ${w.page} van ${w.pages}`;
    collection.querySelector('[data-research-source-controls]').innerHTML=`<p role="status">${esc(range)}</p><button type="button" data-research-page-action="previous"${w.page===1?' disabled':''}>${en?'Previous page':'Vorige pagina'}</button> <label>${en?'Page':'Pagina'} <select data-research-page-select>${Array.from({length:w.pages},(_,i)=>`<option value="${i+1}"${i+1===w.page?' selected':''}>${en?'Page':'Pagina'} ${i+1}</option>`).join('')}</select></label> <button type="button" data-research-page-action="next"${w.page===w.pages?' disabled':''}>${en?'Next page':'Volgende pagina'}</button>`;
    collection.querySelector('[data-research-source-page]').innerHTML=localizeMarkup(renderDirectEventPage(rows,w.page),language);
  }
  function collectionFor(target){const c=target?.closest?.('[data-research-source-collection]');return c&&root.contains(c)?c:null;}
  function onChange(event){const t=event.target;if(active&&t?.matches?.('[data-research-page-select]'))show(collectionFor(t),t.value);}
  function onClick(event){const t=event.target?.closest?.('[data-research-page-action]'),c=collectionFor(t);if(!active||!c||t.disabled)return;const direction=t.getAttribute('data-research-page-action');show(c,(states.get(c)||1)+(direction==='next'?1:-1));}
  function onToggle(event) {
    const target=event.target;if(!active||!target?.open)return;
    if(target.matches?.('[data-research-collection]')){const c=target.querySelector('[data-research-source-collection]');if(c&&!states.has(c))show(c);return;}
    const outer=target.matches?.('[data-research-event-lazy]')?target:target.closest?.('[data-research-event-lazy]');
    if(!outer || !root.contains(outer))return;
    const row=rows[Number(outer.getAttribute('data-research-event-index'))];if(!row||row.key!==outer.getAttribute('data-research-event-key'))return;
    if(target===outer && !filled.has(outer)) {
      outer.querySelector('[data-research-event-body]').innerHTML=localizeMarkup(eventRecordBody(row),language);
      filled.add(outer);
    } else if(target.matches?.('[data-research-raw-lazy]') && !filled.has(target)) {
      target.querySelector('pre').textContent=JSON.stringify(row.sourceRecords[0],null,2);
      filled.add(target);
    }
  }
  root.addEventListener('toggle',onToggle,true);
  root.addEventListener('change',onChange);
  root.addEventListener('click',onClick);
  for(const c of root.querySelectorAll('[data-research-source-collection]')){const disclosure=c.closest('[data-research-collection]');if(!disclosure||disclosure.open)show(c);}
  return Object.freeze({destroy(){active=false;root.removeEventListener('toggle',onToggle,true);root.removeEventListener('change',onChange);root.removeEventListener('click',onClick);states.clear();rows=[];}});
}

function renderIncompleteExecutionNotice(vm) {
  const incomplete=vm.incompleteCases?.length||0;
  if(!incomplete && !vm.directEvidence?.length)return '';
  return `<section class="research-source-limits" data-research-incomplete-cases="${incomplete}">
    ${incomplete?`<p><strong>${incomplete} case(s) niet gebruikt voor volledige paden, varianten of scores.</strong> Eén of meer oorspronkelijke brongebeurtenissen zijn niet eenduidig beschikbaar; er wordt geen kunstmatige opvolging over die gaten gemaakt.</p>`:''}
    ${vm.directEvidence?.length?`<details data-research-collection><summary><span>Aanvullende brongebeurtenissen binnen de selectie</span> <span data-i18n-source-value>(${vm.directEvidence.length})</span></summary><p>Deze bronrecords zijn geen aanvullende volledige cases.</p>${renderDirectEventRecords(vm.directEvidence)}</details>`:''}
  </section>`;
}

function renderCaseReferences(references=[]) {
  if(!references.length)return '<p>Geen rechtstreeks gekoppelde caseverwijzing aangetroffen.</p>';
  return `<p>De volledige bronsequenties hieronder zijn <strong>referentie-informatie</strong>, niet de procestraces van de geselecteerde entiteit.</p>${references.map(row=>
    `<details class="research-case-reference" data-research-case-reference="${esc(row.caseKey)}"><summary><span data-i18n-source-value>${esc(row.caseId)}</span> · <span data-i18n-source-value>${esc(row.processId)}</span> · ${row.directEventIds.length}/${row.sourceEventCount} brongebeurtenissen direct gekoppeld</summary><p>Volledige casebronsequentie (referentie):</p><p class="research-sequence">${row.sequenceLimitation ? esc(row.sequenceLimitation) : row.sequence.length ? row.sequence.map(id=>`<span data-i18n-source-value>${esc(id)}</span>`).join(' → ') : 'Geen bronsequentie beschikbaar'}</p><p>Direct gekoppelde gebeurtenis-ID’s: ${row.directEventIds.map(id=>`<span data-i18n-source-value>${esc(id)}</span>`).join(', ')}</p><p>Niet gebruikt als volledige entiteitsvariant of conformance-score.</p></details>`).join('')}`;
}

function renderNormativeReferences(references=[]) {
  if(!references.length)return '<p>Geen procesreferentie aantoonbaar gekoppeld. Dit bewijst niet dat er geen norm kan gelden.</p>';
  return references.map(row=>`<details class="research-norm-reference" data-research-norm-reference="${esc(row.processId)}"><summary><span${row.labelIsSource ? " data-i18n-source-value" : ""}>${esc(row.label)}</span> · volledig normatief referentiemodel</summary><p class="research-sequence">${row.expected.length ? row.expected.map(id=>`<span data-i18n-source-value>${esc(id)}</span>`).join(' → ') : 'Geen uitvoerbare normatieve sequentie in de actieve bron.'}</p><p>Procesgebonden referentie, niet op objecttoepasselijkheid afgetekend. Niet waargenomen binnen een partiële objectprojectie betekent niet dat een stap in de volledige uitvoering ontbreekt.</p></details>`).join('');
}

/** Purpose-specific evidence without fabricating full object traces or scores. */
function renderExecutionEvidence(vm,title) {
  const invalid=vm.screenState==='INVALID_SCOPE';
  const isConformance=vm.screen==='conformance';
  return `<section class="research-execution-screen" data-research-execution-state="${esc(vm.screenState)}"><div class="panel">
    <h2>${esc(title)}</h2>${renderResearchScopeSummary(vm)}
    <p><strong>${esc(vm.notices?.primary || '')}</strong></p>
    ${invalid?'':`<section><h3>Directe onderzoeksgebeurtenissen</h3>${vm.directEvidence?.length?renderDirectEventRecords(vm.directEvidence):'<p>Geen directe brongebeurtenissen aangetroffen. Er wordt niet teruggevallen op de volledige dataset.</p>'}</section>
      <section><h3>${isConformance?'Normatief procesontwerp — referentie':'Gekoppelde volledige casevarianten — referentie'}</h3>${isConformance?renderNormativeReferences(vm.normativeReferences):renderCaseReferences(vm.caseReferences)}</section>
      ${isConformance?`<details><summary>Gekoppelde casebroncontext</summary>${renderCaseReferences(vm.caseReferences)}</details>`:''}
      <div class="research-interpretation"><strong>Interpretatiegrens</strong><p>${isConformance?'Geen conformance-score en geen ontbrekende-stappenverdict op basis van een partiële entiteitsprojectie.':'Een selectie van directe gebeurtenissen is geen volledige procesvariant. De volledige casebroncontext wordt niet aan de onderzoekspopulatie toegevoegd.'}</p></div>`}
  </div></section>`;
}

return Object.freeze({SOURCE_RECORD_PAGE_SIZE,sourceRecordWindow,renderDirectEventPage,"renderResearchScopeSummary":renderResearchScopeSummary,"renderDirectEventRecords":renderDirectEventRecords,"bindResearchSourceRecords":bindResearchSourceRecords,"renderIncompleteExecutionNotice":renderIncompleteExecutionNotice,"renderCaseReferences":renderCaseReferences,"renderNormativeReferences":renderNormativeReferences,"renderExecutionEvidence":renderExecutionEvidence});
},
