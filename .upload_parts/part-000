  align-items: center;
  justify-content: flex-end;
  gap: 6px;
  flex-wrap: wrap;
}

.badge,
.presentation-toggle,
.company-switch050,
.language-switch050 {
  border: 1px solid rgb(255 255 255 / 20%);
