  background: var(--pirl-header);
  color: #fff;
}

.head {
  display: flex;
  width: 100%;
  max-width: var(--pirl-max);
  margin: 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  min-width: 260px;
}

.brand h1 {
  margin: 0;
  font-size: 1.03rem;
