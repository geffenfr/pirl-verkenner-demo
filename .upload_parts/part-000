.migration-state {
  display: inline-flex;
  margin-bottom: 12px;
  border: 1px solid #d99a9a;
  border-radius: 999px;
  padding: 4px 9px;
  background: #fff0f0;
  color: var(--pirl-danger);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.05em;
}

footer {
  max-width: 1440px;
  margin: 0 auto;
  padding: 12px max(18px, env(safe-area-inset-right)) max(14px, env(safe-area-inset-bottom))
    max(18px, env(safe-area-inset-left));
  background: transparent;
  color: var(--pirl-muted);
  text-align: left;
  font-size: 0.72rem;
}

body.presentation .product-header,
body.presentation footer {
