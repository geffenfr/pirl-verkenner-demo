    <style data-source="src/styles/tokens.css">:root {
  color-scheme: light;
  --pirl-bg: #eef2f6;
  --pirl-surface: #ffffff;
  --pirl-surface-soft: #f7fbfc;
  --pirl-ink: #172033;
  --pirl-muted: #64748b;
  --pirl-line: #dce4ed;
  --pirl-header: #0b1524;
  --pirl-header-soft: #26364d;
  --pirl-accent: #0e6b75;
  --pirl-accent-dark: #0a525a;
  --pirl-accent-soft: #e6f4f4;
  --pirl-warning: #8a5200;
  --pirl-warning-bg: #fff7df;
  --pirl-danger: #a42828;
  --pirl-radius: 16px;
  --pirl-shadow: 0 10px 28px rgb(15 23 42 / 8%);
  --pirl-max: 1400px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-width: 0;
  min-height: 100%;
  overflow-x: clip;
}

body {
  background: var(--pirl-bg);
  color: var(--pirl-ink);
  line-height: 1.45;
}

button,
select {
  color: inherit;
  font: inherit;
}

button,
summary,
select {
  touch-action: manipulation;
}

button:focus-visible,
select:focus-visible,
summary:focus-visible {
  outline: 3px solid #47a7b0;
  outline-offset: 2px;
}
</style>
    <style data-source="src/styles/shell.css">.app {
  min-height: 100vh;
  min-height: 100dvh;
}

.product-header {
  padding: max(13px, env(safe-area-inset-top)) max(18px, env(safe-area-inset-right)) 13px
