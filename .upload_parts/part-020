  function decision(caseId, decisionId = null) {
    if(researchMode){if(!decisionId)return null;return decisions.find(d=>id(d,'decision_id','id')===decisionId && (!caseId || decisionCaseId(d)===caseId))||null;}
    const records = decisionsByCase.get(String(caseId || "")) || [];
    return records.find((record) => id(record, "decision_id", "id") === decisionId) || records[0] || null;
  }

  function positionFor(decisionRecord) {
    return decisionRecord
      ? ipById.get(id(decisionRecord, "information_position_id", "informationPositionId", "ip_id")) || null
      : null;
  }

  function trace(caseId,decisionId=null) {
    if(researchMode){
      const selected=decision(caseId,decisionId),pid=id(selected,'process_id');
      const matches=caseRecords.filter(c=>naturalCaseId(c)===caseId && (!pid||id(c,'process_id')===pid));
      const events=matches.length===1?matches[0].events:model.events||[];
      return {objectIds:new Set(events.flatMap(e=>ids(e))),events:[...events].sort(byTime),role:'SCOPED_EVENTS_ONLY'};
