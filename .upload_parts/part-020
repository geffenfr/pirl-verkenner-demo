      if (breached.length) evidence.push(`${breached.length} commitment(s) zijn formeel BREACHED.`);
      if (commitmentOutcome) evidence.push("Procesoutcome toont dat de beloofde termijn niet is gehaald.");
      hypotheses.push({ title: "Mogelijke commitment- of termijnverklaring", evidence });
    }
