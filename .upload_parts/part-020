  const listeners = new Set();
  const notify = (event) => { for (const listener of listeners) { try { listener(event); } catch (e) { onListenerError(e, event); } } };
  const unsubscribeRuntime = runtimeStore.subscribe((event) => {
    if (event?.type === "DATASET_ACTIVATED") { busy = false; error = null; notify(deepFreeze({ type: "LOAD_INVALIDATED", reason: "dataset" })); }
