function withManualPositions(graph, manualPositions) {
  if (!graph) return null;
  const positions = { ...graph.positions };
  for (const [nodeId, point] of Object.entries(manualPositions || {})) {
    if (!positions[nodeId]) continue;
    positions[nodeId] = { x: Number(point.x), y: Number(point.y) };
  }
  return { ...graph, positions };
}

function createProcessExplorerController({
  runtimeStore,
  contextStore = null,
  scopeService = null,
  onListenerError = () => {},
} = {}) {
  if (!runtimeStore || typeof runtimeStore.snapshot !== "function" || typeof runtimeStore.subscribe !== "function") {
    throw new TypeError("Process Explorer controller requires a Runtime Store");
  }

  const readResearch = scopeService ? createExecutionResearchReader({ runtimeStore, scopeService }) : null;
  let runtimeSnapshot = runtimeStore.snapshot();
  let query = runtimeSnapshot.model ? createProcessExplorerQuery(runtimeSnapshot.model) : null;
  let state = initialState(runtimeSnapshot);
  let cachedViewModel = null;
  let cachedViewState = null;
  const listeners = new Set();
  let destroyed = false;
  let evidenceCache = null;
  let evidenceCacheModel = null;
  let evidenceCacheKey = null;
  function entityEvidence() {
    if (!runtimeSnapshot.model || !state.entityContext) return null;
    if (readResearch) return readResearch().entityEvidence;
    const key = JSON.stringify(state.entityContext);
    if (evidenceCacheModel !== runtimeSnapshot.model || evidenceCacheKey !== key) {
      evidenceCache = createProcessEntityEvidence(runtimeSnapshot.model, state.entityContext);
      evidenceCacheModel = runtimeSnapshot.model; evidenceCacheKey = key;
    }
    return evidenceCache;
  }

  function notify(type, previous, meta = {}) {
    const event = deepFreeze({ type, previous, current: state, ...meta });
    for (const listener of listeners) {
      try {
        listener(event);
      } catch (error) {
        onListenerError(error, event);
      }
    }
  }

  function commit(type, candidate, { syncContext = false, meta = {} } = {}) {
    const raw = typeof candidate === "function" ? candidate(state) : candidate;
    const next = deepFreeze({ ...raw, revision: state.revision + 1 });
    const stateChanged = !sameValue({ ...state, revision: 0 }, { ...next, revision: 0 });
    const contextChanged = syncContext
      ? transactProcessContext(contextStore, type, query, next.selectedProcess)
      : false;
    if (!stateChanged && !contextChanged) return false;
    const previous = state;
    state = next;
    cachedViewModel = null;
    cachedViewState = null;
    notify(type, previous, meta);
