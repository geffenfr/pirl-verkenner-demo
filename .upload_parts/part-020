  return new Set(
    [...reached].filter((objectId) => {
      if (objectId === caseId) return true;
      const type = objectType(objectById.get(objectId));
      return type && !NOVA_GENERIC_TYPES.has(type);
    }),
  );
}

function genericCaseObjectIds(model, caseId, caseRecords) {
  const selected = caseRecords.find((record) => naturalCaseId(record) === caseId) || null;
  const found = new Set([caseId]);
  if (selected?.case_object_id) found.add(String(selected.case_object_id));
  for (const event of selected?.events || []) ids(event).forEach((objectId) => found.add(objectId));
  return found;
}

function buildCaseTrace(model, caseId, caseRecords, objectById) {
  const linked = model.bundleId === NOVASERVE_BUNDLE
    ? novaReachableObjectIds(model, caseId, objectById)
    : genericCaseObjectIds(model, caseId, caseRecords);
  const selectedCase = caseRecords.find((record) => naturalCaseId(record) === caseId) || null;
  const direct = selectedCase?.events || [];
  const events = model.bundleId === NOVASERVE_BUNDLE
    ? (model.events || []).filter((event) => ids(event).some((objectId) => linked.has(objectId)))
    : direct.length
      ? direct
      : (model.events || []).filter((event) => ids(event).some((objectId) => linked.has(objectId)));
  return {
    objectIds: linked,
    events: [...new Map(events.map((event) => [id(event, "event_id", "id"), event])).values()].sort(byTime),
  };
}

function linkedCommitments(model, objectIds) {
  return (model.commitments || []).filter((record) => ids(record).some((objectId) => objectIds.has(objectId)));
}

function linkedOutcomes(model, objectIds) {
  return (model.outcomes || []).filter((record) => ids(record).some((objectId) => objectIds.has(objectId)));
}

function issueTitle(item, decision) {
  const status = informationStatus(item);
  const category = informationCategory(item);
  const label = id(item, "name", "label", "element_id", "information_id", "id") || "informatie-item";
  const subject = category && category !== "Other issue" ? `${category}-informatie (${label})` : `Informatie-item ${label}`;
  const action = id(decision, "action_family", "selected_action", "action");
  if (status === "INACCESSIBLE") return `${subject} was niet toegankelijk op het beslismoment`;
  if (status === "MISSING") return `${subject} ontbrak op het beslismoment`;
  if (status === "STALE") return `${subject} was niet actueel genoeg op het beslismoment`;
  if (status === "UNKNOWN") return `${subject} was niet eenduidig bekend op het beslismoment`;
  return `${subject} had status ${status}${action ? ` bij ${action}` : ""}`;
}

function issueEvidence(item, decision) {
  const label = id(item, "name", "label", "element_id", "information_id", "id") || informationCategory(item);
  const action = id(decision, "action_family", "selected_action", "action") || id(decision, "decision_id", "id");
  return [
    `${label}: status ${informationStatus(item)}; waarde ${typeof item?.value === "object" ? JSON.stringify(item.value) : String(item?.value ?? "—")}`,
    `Beslismoment ${action} (${id(decision, "decision_id", "id")})`,
  ];
}

function createInformationPositionQuery(model,{researchMode=false,sourceKind='external'}={}) {
  if (!model || typeof model !== "object") throw new TypeError("Information Position query requires a canonical model");
  const decisions = Array.isArray(model.decisions) ? model.decisions : [];
  const positions = Array.isArray(model.informationPositions) ? model.informationPositions : [];
  const caseRecords = Array.isArray(model.cases) ? model.cases : [];
  const objectById = new Map((model.objects || []).map((record) => [id(record, "object_id", "id"), record]).filter(([key]) => key));
  const ipById = new Map(positions.map((record) => [id(record, "information_position_id", "id"), record]).filter(([key]) => key));
  const decisionsByCase = new Map();
  for (const decision of decisions) {
    const caseId = decisionCaseId(decision);
    if (!caseId && !researchMode) continue;
    if (!decisionsByCase.has(caseId)) decisionsByCase.set(caseId, []);
    decisionsByCase.get(caseId).push(decision);
  }
  for (const records of decisionsByCase.values()) records.sort(byTime);
  const issueRows = [];
  for (const decision of decisions) {
    const caseId = decisionCaseId(decision);
    if (!caseId && !researchMode) continue;
    const decisionId = id(decision, "decision_id", "id");
    const ip = ipById.get(id(decision, "information_position_id", "informationPositionId", "ip_id")) || null;
    const items = researchMode?temporalInformationItems(ip,decision):informationItems(ip);
    const bad = items.filter((item) => isInformationIssue(informationStatus(item)));
    if (bad.length) {
      for (const item of bad) {
        issueRows.push({
          caseId,
          decisionId,
          processId: id(decision, "process_id", "processId"),
          category: informationCategory(item),
          status: informationStatus(item),
          label: id(item, "name", "label", "element_id", "information_id", "id") || "informatie-item",
          evidence: informationEvidence(item),
        });
      }
    } else if (researchMode && (!ip || !items.length)) {
      issueRows.push({caseId,decisionId,processId:id(decision,"process_id","processId"),
        category:"Onbekende informatiepositie",status:"UNKNOWN",label:"Geen beoordeelbare informatie-items beschikbaar",evidence:"—"});
    } else if (ip) {
      issueRows.push({
        caseId,
        decisionId,
        processId: id(decision, "process_id", "processId"),
        category: IP_COMPLETE_CATEGORY,
        status: "AVAILABLE",
        label: "Geen ontbrekend item gevonden",
        evidence: "—",
