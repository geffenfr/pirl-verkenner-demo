    return {...item,...(['MISSING','INACCESSIBLE','UNKNOWN'].includes(sourceStatus)?{value:null,actual_value:null}:{}),
      temporalBasis:explicit?'EXPLICIT_AVAILABLE_FROM':'STORED_DECISION_SNAPSHOT',sourceStatus};
  });
}












return Object.freeze({"IP_COMPLETE_CATEGORY":IP_COMPLETE_CATEGORY,"IP_ISSUES_FILTER":IP_ISSUES_FILTER,"informationStatus":informationStatus,"isInformationIssue":isInformationIssue,"informationCategory":informationCategory,"informationEvidence":informationEvidence,"createInformationPositionQuery":createInformationPositionQuery,"temporalInformationItems":temporalInformationItems});
},
"src/application/advice-evidence.js":function(load){
"use strict";
const {deepFreeze}=load("src/core/data/immutability.js");
const {finiteMeasurement,researchCaseKey}=load("src/application/analysis-research-scope.js");
const {temporalInformationItems,informationStatus,isInformationIssue,informationCategory}=load("src/application/information-position-projection.js");




const array=value=>Array.isArray(value)?value:[];
const ident=(row,key)=>String(row?.[key]||row?.id||"");
const distinct=values=>[...new Set(values.filter(Boolean))];
const lensFor=(snapshot,id)=>snapshot.evidence.find(l=>l.id===id&&snapshot.included[id]===true&&l.included===true);
const members=(rows,ids,key)=>{const allowed=new Set(array(ids));return rows.filter(r=>allowed.has(ident(r,key)));};

/** Hydrate only IDs explicitly included in the current frozen Integrated evidence.
 * Current records are immutable and scoped to the identical source/scope key.
 * No query by neighbours, hidden scenario fields, local inspector or ground truth.
 */
function collectAdviceEvidence(research,snapshot) {
  const records=research.scope.records;
  const ip=lensFor(snapshot,"ip"),behavior=lensFor(snapshot,"behavior"),value=lensFor(snapshot,"value");
  const decisions=ip?members(records.decisions,ip.sources.decisionIds,"decision_id"):[];
  const positions=ip?members(records.informationPositions,ip.sources.informationPositionIds,"information_position_id"):[];
  const positionById=new Map(positions.map(p=>[ident(p,"information_position_id"),p]));
  const ipIssues=[];let missingPositions=0;
  for(const decision of decisions){
    const position=positionById.get(String(decision.information_position_id||""));
    if(!position){missingPositions++;continue;}
    const items=temporalInformationItems(position,decision);
    if(!items.length){missingPositions++;continue;}
    items.forEach((item,index)=>{
      const status=informationStatus(item);
      if(!isInformationIssue(status)&&status!=="POST_CUTOFF")return;
      // Only whitelisted identifiers/status/category; never expose item values or
      // future evidence. Post-cutoff data is a historical information gap only.
