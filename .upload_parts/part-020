    if (Number.isFinite(m.risk) && Number.isFinite(b.risk) && m.risk > b.risk && m.risk > 0) notes.push({ kind: "risk", text: `Hogere expected loss per case: € ${m.risk.toFixed(0)} versus € ${b.risk.toFixed(0)}.` });
