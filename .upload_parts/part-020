  const option = query?.options?.find((candidate) => candidate.id === processId);
  return option ? { id: option.id, label: option.label } : null;
}

function transactProcessContext(contextStore, name, query, processId) {
  if (!contextStore) return false;
  if (typeof contextStore.transact !== "function") {
    throw new TypeError("Process Explorer contextStore must expose transact(name, updater)");
  }
  return contextStore.transact(name, (draft) => {
    draft.process = processContextSelection(query, processId);
    draft.pattern = null;
    draft.variant = null;
    draft.case = null;
    draft.decision = null;
    draft.entity = null;
    draft.object = null;
    draft.caseSet = null;
    draft.population = null;
    draft.navigationPolicy = null;
  });
