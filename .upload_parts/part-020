function semanticLabel(sequence, baselineSequence) {
  const ids = String(sequence || "").split(" → ").filter(Boolean);
  const baselineIds = String(baselineSequence || "").split(" → ").filter(Boolean);
  const upper = String(sequence || "").toUpperCase();
  const counts = new Map();
  ids.forEach((id) => counts.set(id, (counts.get(id) || 0) + 1));
  const repeated = [...counts.entries()].filter(([, count]) => count > 1).sort((a, b) => b[1] - a[1]);
  if (sequence && sequence === baselineSequence) return "Standaard / meest voorkomend patroon";
  if (/REWORK/.test(upper)) return "Herwerk / herstelronde";
  if (/CLARIF|DETAILS_CONFIRMED|EVIDENCE_RECEIVED|CONTEXT_ENRICHED|ADDITIONAL_INFO/.test(upper)) return "Aanvullende informatie / verduidelijking";
  if (/MANUAL.*REVIEW|HUMAN.*REVIEW|REVIEW_STARTED|REVIEW_COMPLETED/.test(upper)) return "Handmatige review";
  if (/ESCALAT/.test(upper)) return "Escalatie en herstel";
  if (/RETRY|RECONCIL|RECOVERY|RESTORE|TECHNICAL/.test(upper)) return "Technische retry / herstel";
  if (/CHANNEL.*SWITCH|SWITCHED/.test(upper)) return "Kanaalwissel";
  if (repeated.length) {
    const id = repeated[0][0];
    if (/I04/.test(id)) return "Herplanning";
    if (/I07/.test(id)) return "Herhaalde service-uitvoering";
    return "Herhaalde processtap / lus";
  }
  if (baselineIds.length && ids.length < baselineIds.length) return "Verkorte / snelle route";
  if (baselineIds.length && ids.length > baselineIds.length) return "Uitgebreide route";
