function asNumber(value) {
  return finiteMeasurement(value);
}

function mean(values) {
  const usable = values.filter(Number.isFinite);
  return usable.length ? usable.reduce((sum, value) => sum + value, 0) / usable.length : null;
}

function recordId(record, ...keys) {
  for (const key of keys) {
    const value = record?.[key];
    if (value !== undefined && value !== null && value !== "") return String(value);
  }
  return "";
}

function objectIds(record) {
  const values = record?.object_ids ?? record?.objects ?? [];
  return Array.isArray(values) ? values.map(String) : [];
}

function caseIdentity(caseRecord) {
  return String(caseRecord?.display_case_id || caseRecord?.case_object_id || caseRecord?.case_id || caseRecord?.case_key || "");
}

function caseObjectUniverse(caseRecord) {
  const ids = new Set([String(caseRecord?.case_object_id || "")].filter(Boolean));
  for (const event of caseRecord?.events || []) objectIds(event).forEach((id) => ids.add(id));
  return ids;
}

function linkedOutcomes(model, caseRecord) {
  const ids = caseObjectUniverse(caseRecord);
  return (model.outcomes || []).filter((outcome) => objectIds(outcome).some((id) => ids.has(id)));
}

function outcomeOf(outcomes, type) {
  const expected = String(type || "").toUpperCase();
  return outcomes.find((outcome) => String(outcome?.outcome_type || outcome?.type || "").toUpperCase() === expected) || null;
}

function enrichCase(model, caseRecord, measurementModel=null) {
  const outcomes = linkedOutcomes(model, caseRecord);
  const processOutcome = measurementModel?caseOutcomeBinding(measurementModel,caseRecord,'PROCESS').record:outcomeOf(outcomes, "PROCESS");
