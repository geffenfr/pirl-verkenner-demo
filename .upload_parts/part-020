    String(value || "source")
      .trim()
      .replace(/\s+/g, "-")
      .replace(/[^A-Za-z0-9_.:-]/g, "-") || "source"
  );
}

function normalizedHeader(value) {
  return String(value || "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "");
}

function delimiterScore(line, delimiter) {
  let count = 0;
  let quoted = false;
  for (let index = 0; index < line.length; index += 1) {
    if (line[index] === '"') {
      if (quoted && line[index + 1] === '"') index += 1;
      else quoted = !quoted;
    } else if (!quoted && line[index] === delimiter) {
      count += 1;
    }
  }
  return count;
}

function detectDelimiter(text) {
  const firstLine = String(text).split(/\r?\n/, 1)[0] || "";
  const candidates = [",", ";", "\t"];
  return candidates.reduce((best, candidate) =>
    delimiterScore(firstLine, candidate) > delimiterScore(firstLine, best) ? candidate : best,
  );
}

function parseCsvRows(text) {
  const source = String(text ?? "");
  if (!source.trim()) return deepFreeze([]);
  const delimiter = detectDelimiter(source);
  const rows = [];
  let row = [];
  let field = "";
  let quoted = false;

  for (let index = 0; index < source.length; index += 1) {
    const character = source[index];
    if (quoted) {
      if (character === '"' && source[index + 1] === '"') {
        field += '"';
        index += 1;
      } else if (character === '"') {
        quoted = false;
      } else {
        field += character;
      }
    } else if (character === '"') {
      quoted = true;
    } else if (character === delimiter) {
      row.push(field);
      field = "";
    } else if (character === "\n") {
      row.push(field.replace(/\r$/, ""));
      rows.push(row);
      row = [];
      field = "";
    } else {
      field += character;
    }
  }

  if (quoted) {
    throw new SourceAdapterError("MALFORMED_CSV", "CSV bevat een niet-afgesloten quoted field.");
  }
  row.push(field.replace(/\r$/, ""));
  if (row.some((value) => value !== "")) rows.push(row);
  return deepFreeze(rows);
}

function pickHeader(headers, candidates) {
  const exact = new Map(headers.map((header) => [normalizedHeader(header), header]));
  for (const candidate of candidates) {
    const match = exact.get(normalizedHeader(candidate));
    if (match) return match;
  }
  for (const header of headers) {
    const normalized = normalizedHeader(header);
    if (candidates.some((candidate) => normalized.includes(normalizedHeader(candidate)))) return header;
  }
  return null;
}

function assertUniqueHeaders(headers) {
  const seen = new Set();
  for (const header of headers) {
    const normalized = normalizedHeader(header);
    if (!normalized) {
      throw new SourceAdapterError("MALFORMED_CSV", "CSV bevat een lege kolomnaam.");
    }
    if (seen.has(normalized)) {
      throw new SourceAdapterError("MALFORMED_CSV", `CSV bevat een dubbele kolomnaam: ${header}.`);
    }
    seen.add(normalized);
  }
}

function adaptCsv(text, { name = "source.csv" } = {}) {
  const rows = parseCsvRows(text);
  const sourceName = baseName(name);
  const sourceId = safeId(sourceName);
  if (!rows.length) {
    return deepFreeze({
      schema: "adapter.csv.v2",
      bundle_id: sourceId,
      manifest: { name: sourceName, source_format: "CSV" },
      collections: { events: [] },
    });
  }

  const headers = rows[0].map((header) => String(header).trim());
  assertUniqueHeaders(headers);
  const records = rows
    .slice(1)
    .filter((row) => row.some((value) => String(value).trim() !== ""))
    .map((row) => Object.fromEntries(headers.map((header, index) => [header, row[index] ?? ""])));
  const caseHeader = pickHeader(headers, ["case_id", "case", "caseid", "trace_id", "traceid"]);
  const activityHeader = pickHeader(headers, [
    "activity_id",
    "activity",
    "activityname",
    "event_type",
    "event",
    "concept:name",
  ]);
  const timestampHeader = pickHeader(headers, ["timestamp", "time:timestamp", "datetime", "time", "date"]);
  const processHeader = pickHeader(headers, ["process_id", "process", "processid"]);
  const objectHeader = pickHeader(headers, ["object_id", "object", "objectid"]);
  const eventHeader = pickHeader(headers, ["event_id", "eventid"]);

  if (records.length && !activityHeader) {
    throw new SourceAdapterError(
      "MISSING_ACTIVITY_COLUMN",
      "CSV mist een herkenbare activity/event-kolom.",
    );
  }

  const events = records.map((record, index) => {
    const processId = processHeader ? String(record[processHeader] || "") : sourceId;
    const activityId = String(record[activityHeader] || "");
    return {
      event_id: eventHeader ? String(record[eventHeader] || `${sourceId}-e${index + 1}`) : `${sourceId}-e${index + 1}`,
      case_id: caseHeader ? String(record[caseHeader] || "") : "",
      process_id: processId,
      activity_id: activityId,
      event_type: activityId,
      timestamp: timestampHeader ? record[timestampHeader] || null : null,
      object_ids: objectHeader && record[objectHeader] ? [String(record[objectHeader])] : [],
      attributes: { ...record },
      provenance: { source_type: "CSV", source_ref: name },
    };
  });
  const processIds = [...new Set(events.map(({ process_id: processId }) => processId).filter(Boolean))];

  return deepFreeze({
    schema: "adapter.csv.v2",
    bundle_id: sourceId,
    manifest: { name: sourceName, source_format: "CSV" },
    collections: {
      events,
      processes: processIds.map((processId) => ({ process_id: processId, name: processId })),
    },
  });
}

function bundleFromJsonObject(raw, name) {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) {
    throw new SourceAdapterError("UNRECOGNIZED_JSON", "JSON-bron moet één object bevatten.");
  }
  if (isOcelJson(raw)) return adaptOcelJson(raw, { name, consume: true });
  if (isOcdsJson(raw)) return adaptOcdsJson(raw, { name });
  if (raw.collections && typeof raw.collections === "object" && !Array.isArray(raw.collections)) {
    return structuredClone(raw);
  }

  const collections = {};
  for (const key of KNOWN_COLLECTIONS) {
    if (Array.isArray(raw[key])) collections[key] = structuredClone(raw[key]);
  }
  if (!Object.keys(collections).length) {
    throw new SourceAdapterError(
      "UNRECOGNIZED_JSON",
      "JSON bevat geen herkenbare PIRL-collections.",
    );
  }
  return {
    schema: raw.schema || "adapter.json.v2",
    bundle_id: raw.bundle_id || safeId(baseName(name)),
    manifest: raw.manifest || {
      name: raw.name || baseName(name),
      source_format: "JSON",
    },
    collections,
  };
}

function hasOwn(record, key) {
  return Object.prototype.hasOwnProperty.call(record, key);
}

function isOcelJson(raw) {
  return (
    hasOwn(raw, "ocel:events") ||
    hasOwn(raw, "ocel:objects") ||
    hasOwn(raw, "objectTypes") ||
    hasOwn(raw, "eventTypes") ||
    hasOwn(raw, "ocelVersion")
  );
}

function ocelRecords(value, collectionName, { consume = false } = {}) {
  if (value === undefined || value === null) return [];
  if (Array.isArray(value)) return consume ? value : structuredClone(value);
  if (typeof value === "object") {
    return Object.entries(value)
      .sort(([left], [right]) => left.localeCompare(right))
      .map(([recordId, record]) => {
        if (!record || typeof record !== "object" || Array.isArray(record)) {
          throw new SourceAdapterError(
            "MALFORMED_OCEL",
            `OCEL ${collectionName} bevat geen geldig record voor ${recordId}.`,
          );
        }
        return { id: recordId, ...(consume ? record : structuredClone(record)) };
      });
  }
  throw new SourceAdapterError(
    "MALFORMED_OCEL",
    `OCEL ${collectionName} moet een array of object-map zijn.`,
  );
}

function ocelAttributes(value, collectionName, recordId, { consume = false } = {}) {
  if (value === undefined || value === null) return { values: EMPTY_ATTRIBUTES, source: null };
  if (Array.isArray(value)) {
    const values = {};
    const seenNames = new Set();
    let sourceIsRedundant = true;
    for (const attribute of value) {
      if (!attribute || typeof attribute !== "object" || Array.isArray(attribute)) {
        throw new SourceAdapterError(
          "MALFORMED_OCEL",
          `OCEL ${collectionName} ${recordId} bevat een ongeldig attribuut.`,
        );
      }
      const name = id(attribute, "name", "key");
      if (name) {
        if (seenNames.has(name)) sourceIsRedundant = false;
        seenNames.add(name);
        values[name] = consume ? attribute.value : structuredClone(attribute.value);
      }
      const keys = Object.keys(attribute);
      if (!name || keys.some((key) => !["name", "key", "value"].includes(key))) sourceIsRedundant = false;
    }
    return {
      values: Object.keys(values).length ? values : EMPTY_ATTRIBUTES,
      source: sourceIsRedundant ? null : (consume ? value : structuredClone(value)),
    };
  }
  if (typeof value === "object") {
    return { values: consume ? value : structuredClone(value), source: null };
  }
  throw new SourceAdapterError(
    "MALFORMED_OCEL",
    `OCEL ${collectionName} ${recordId} heeft geen geldige attributen.`,
  );
}

function id(record, ...keys) {
  for (const key of keys) {
    if (record?.[key] !== undefined && record[key] !== null && record[key] !== "") {
      return String(record[key]);
    }
  }
  return "";
}

function ocelRelationships(record, collectionName, recordId, { consume = false } = {}) {
  const relationships =
    record.relationships ??
    record.objects ??
    record.omap ??
    record["ocel:omap"] ??
    record["ocel:o2o"] ??
    [];
  if (!Array.isArray(relationships)) {
    throw new SourceAdapterError(
      "MALFORMED_OCEL",
      `OCEL ${collectionName} ${recordId} heeft geen geldige relationships-array.`,
    );
  }
  return consume ? relationships : structuredClone(relationships);
}

function relatedObjectId(relationship) {
  if (typeof relationship === "string" || typeof relationship === "number") {
    return String(relationship);
  }
  return id(relationship, "objectId", "object_id", "id", "ocel:oid");
}

function relationshipQualifier(relationship) {
  if (!relationship || typeof relationship !== "object" || Array.isArray(relationship)) return null;
  return id(relationship, "qualifier", "type", "ocel:qualifier") || null;
}

function adaptOcelJson(raw, { name = "source.ocel.json", consume = false } = {}) {
  if (!raw || typeof raw !== "object" || Array.isArray(raw) || !isOcelJson(raw)) {
    throw new SourceAdapterError("UNRECOGNIZED_OCEL", "JSON-bron is geen herkenbare OCEL JSON-bron.");
  }

  const rawObjects = ocelRecords(raw.objects ?? raw["ocel:objects"], "objects", { consume });
  const rawEvents = ocelRecords(raw.events ?? raw["ocel:events"], "events", { consume });
  const sourceName = raw.name || baseName(name);
  const processId = id(raw, "process_id") || safeId(sourceName);
  const sourceProvenance = Object.freeze({ source_type: "OCEL", source_ref: name });
  const relations = [];

  const objects = consume && Array.isArray(rawObjects) ? rawObjects : new Array(rawObjects.length);
  for (let index = 0; index < rawObjects.length; index += 1) {
    const object = rawObjects[index];
    const objectId = id(object, "object_id", "id", "ocel:oid") || `object-${index + 1}`;
    const relationships = ocelRelationships(object, "object", objectId, { consume });
    const attributes = ocelAttributes(
      object.attributes ?? object.ovmap ?? object["ocel:ovmap"],
      "object",
      objectId,
      { consume },
    );
    relationships.forEach((relationship, relationshipIndex) => {
      const targetObjectId = relatedObjectId(relationship);
      if (!targetObjectId) return;
      relations.push({
        relation_id:
          id(relationship, "relation_id") ||
          `ocel-relation-${String(index + 1).padStart(4, "0")}-${String(relationshipIndex + 1).padStart(3, "0")}`,
        relation_type: relationshipQualifier(relationship) || "OCEL_OBJECT_RELATION",
        source_object_id: objectId,
        target_object_id: targetObjectId,
        qualifier: relationshipQualifier(relationship),
        attributes: {},
        provenance: sourceProvenance,
      });
    });
    objects[index] = {
      object_id: objectId,
      object_type: id(object, "object_type", "type", "ocel:type") || "object",
      name: object.name || objectId,
      attributes: attributes.values,
      ...(attributes.source ? { ocel_attributes: attributes.source } : {}),
      provenance: sourceProvenance,
    };
  }

  const events = consume && Array.isArray(rawEvents) ? rawEvents : new Array(rawEvents.length);
  for (let index = 0; index < rawEvents.length; index += 1) {
    const event = rawEvents[index];
    const eventId = id(event, "event_id", "id", "ocel:eid") || `event-${index + 1}`;
    const relationships = ocelRelationships(event, "event", eventId, { consume });
    const attributes = ocelAttributes(
      event.attributes ?? event.vmap ?? event["ocel:vmap"],
      "event",
      eventId,
      { consume },
    );
    const activityId = id(event, "activity_id", "activity", "type", "ocel:activity");
    events[index] = {
      event_id: eventId,
      process_id: id(event, "process_id") || processId,
      case_id: id(event, "case_id"),
      activity_id: activityId,
      event_type: id(event, "event_type", "activity", "type", "ocel:activity") || activityId,
      timestamp: event.timestamp || event.time || event["ocel:timestamp"] || null,
      object_ids: [...new Set(relationships.map(relatedObjectId).filter(Boolean))],
      actor_ids: Array.isArray(event.actor_ids) && event.actor_ids.length ? event.actor_ids.map(String) : EMPTY_IDS,
      attributes: attributes.values,
      ...(attributes.source ? { ocel_attributes: attributes.source } : {}),
      provenance: sourceProvenance,
    };
  }

  return deepFreeze({
    schema: "adapter.ocel-json.v2",
    bundle_id: safeId(processId),
    manifest: {
      name: sourceName,
      source_format: "OCEL_JSON",
      ocel_version: raw.ocelVersion || raw["ocel:global-log"]?.["ocel:version"] || null,
    },
    collections: {
      events,
      objects,
      relations,
      processes: [{ process_id: processId, name: sourceName }],
    },
  });
}

function adaptOcdsJsonLines(text, { name = "source.ocds.jsonl" } = {}) {
  const source = String(text ?? "");
  const grouped = new Map();
  let lineNumber = 0;
  let recordCount = 0;
  let offset = 0;

  while (offset <= source.length) {
    let end = source.indexOf("\n", offset);
    if (end < 0) end = source.length;
    lineNumber += 1;
    let line = source.slice(offset, end);
    if (line.endsWith("\r")) line = line.slice(0, -1);
    const trimmed = line.trim();
    if (trimmed) {
      let release;
      try {
        release = JSON.parse(trimmed);
      } catch (cause) {
        throw new SourceAdapterError(
          "MALFORMED_JSONL",
          `JSONL-regel ${lineNumber} bevat geen geldige JSON.`,
          { cause },
        );
      }
      if (!release || typeof release !== "object" || Array.isArray(release) || !release.ocid || !release.id) {
        throw new SourceAdapterError(
          "UNRECOGNIZED_JSONL",
          `JSONL-regel ${lineNumber} bevat geen herkenbaar OCDS-releaseobject.`,
        );
      }
      const ocid = String(release.ocid);
      if (!grouped.has(ocid)) grouped.set(ocid, []);
      grouped.get(ocid).push({
        id: String(release.id),
        date: release.date || null,
        tags: Array.isArray(release.tag) ? release.tag.map(String) : [],
        tender: release.tender ?? null,
        awards: release.awards ?? null,
        contracts: release.contracts ?? null,
      });
      recordCount += 1;
    }
    if (end === source.length) break;
    offset = end + 1;
  }

  if (!recordCount) {
    throw new SourceAdapterError(
      "UNRECOGNIZED_JSONL",
      "JSONL-bron bevat geen herkenbare OCDS-releaseobjecten.",
    );
  }

  const sourceName = baseName(name);
  const objects = [];
  const events = [];
  let caseNumber = 0;
  for (const [ocid, records] of [...grouped].sort(([a], [b]) => a.localeCompare(b))) {
    const objectId = `OCDS-${String(++caseNumber).padStart(4, "0")}`;
    objects.push({
      object_id: objectId,
      object_type: "contracting_process",
      name: ocid,
      lifecycle_status: "IMPORTED",
      attributes: { ocid },
      provenance: { source_type: "OCDS", source_ref: name },
    });
    records
      .sort((left, right) => Date.parse(left.date || 0) - Date.parse(right.date || 0))
      .forEach((release, index) => {
        const activity = release.tags[0] || "RELEASE";
        events.push({
          event_id: release.id || `${objectId}-e${index + 1}`,
          case_id: ocid,
          process_id: "P-OCDS",
          activity_id: activity,
          event_type: `OCDS_${release.tags.join("_") || "RELEASE"}`,
          timestamp: release.date,
          object_ids: [objectId],
          actor_ids: [],
          attributes: {
            tender: release.tender,
            awards: release.awards,
            contracts: release.contracts,
          },
          provenance: { source_type: "OCDS", source_ref: name },
        });
      });
  }
  return deepFreeze({
    schema: "adapter.ocds-jsonl.v1",
    bundle_id: safeId(sourceName || "ocds-jsonl-import"),
    manifest: {
      name: sourceName || "OCDS JSONL import",
      source_format: "OCDS_JSONL",
      source_record_count: recordCount,
    },
    collections: {
      events,
      objects,
      processes: [{ process_id: "P-OCDS", name: "OCDS contracting process" }],
    },
  });
}

const INCREMENTAL_OCEL_THRESHOLD = 8 * 1024 * 1024;

function jsonSkipWhitespace(source, start) {
  let index = start;
  while (index < source.length && /\s/.test(source[index])) index += 1;
  return index;
}

function jsonStringEnd(source, start) {
  if (source[start] !== '"') throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een ongeldige stringgrens.");
  let escaped = false;
  for (let index = start + 1; index < source.length; index += 1) {
    const character = source[index];
    if (escaped) escaped = false;
    else if (character === "\\") escaped = true;
    else if (character === '"') return index + 1;
  }
  throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een niet-afgesloten string.");
}

function jsonCompositeEnd(source, start) {
  const opener = source[start];
  if (opener !== "{" && opener !== "[") throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een ongeldige samengestelde waarde.");
  const stack = [opener === "{" ? "}" : "]"];
  let inString = false;
  let escaped = false;
  for (let index = start + 1; index < source.length; index += 1) {
    const character = source[index];
    if (inString) {
      if (escaped) escaped = false;
      else if (character === "\\") escaped = true;
      else if (character === '"') inString = false;
      continue;
    }
    if (character === '"') { inString = true; continue; }
    if (character === "{") stack.push("}");
    else if (character === "[") stack.push("]");
    else if (character === "}" || character === "]") {
      if (stack.pop() !== character) throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat niet-passende haakjes.");
      if (!stack.length) return index + 1;
    }
  }
  throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een niet-afgesloten samengestelde waarde.");
}

function jsonValueEnd(source, start) {
  const index = jsonSkipWhitespace(source, start);
  const character = source[index];
  if (character === '"') return jsonStringEnd(source, index);
  if (character === "{" || character === "[") return jsonCompositeEnd(source, index);
  let end = index;
  while (end < source.length && source[end] !== "," && source[end] !== "}" && source[end] !== "]") end += 1;
  if (end === index) throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een lege waarde.");
  return end;
}

function indexTopLevelJson(source) {
  const values = new Map();
  let index = jsonSkipWhitespace(source, 0);
  if (source[index] !== "{") throw new SourceAdapterError("OCEL_INCREMENTAL_NOT_APPLICABLE", "Geen top-level JSON-object.");
  index += 1;
  while (index < source.length) {
    index = jsonSkipWhitespace(source, index);
    if (source[index] === "}") return values;
    if (source[index] !== '"') throw new SourceAdapterError("MALFORMED_JSON", "JSON top-level sleutel is ongeldig.");
    const keyEnd = jsonStringEnd(source, index);
    let key;
    try { key = JSON.parse(source.slice(index, keyEnd)); }
    catch (cause) { throw new SourceAdapterError("MALFORMED_JSON", "JSON top-level sleutel kan niet worden geparseerd.", { cause }); }
    index = jsonSkipWhitespace(source, keyEnd);
    if (source[index] !== ":") throw new SourceAdapterError("MALFORMED_JSON", "JSON mist een dubbele punt na een top-level sleutel.");
    const valueStart = jsonSkipWhitespace(source, index + 1);
    const valueEnd = jsonValueEnd(source, valueStart);
    values.set(String(key), { start: valueStart, end: valueEnd });
    index = jsonSkipWhitespace(source, valueEnd);
    if (source[index] === ",") { index += 1; continue; }
    if (source[index] === "}") return values;
    throw new SourceAdapterError("MALFORMED_JSON", "JSON mist een komma of afsluitende accolade.");
  }
  throw new SourceAdapterError("MALFORMED_JSON", "JSON top-level object is niet afgesloten.");
}

function parseTopLevelJsonValue(source, span) {
  if (!span) return undefined;
  try { return JSON.parse(source.slice(span.start, span.end)); }
  catch (cause) { throw new SourceAdapterError("MALFORMED_JSON", "JSON metadatawaarde kan niet worden geparseerd.", { cause }); }
}

function forEachJsonArrayElement(source, span, visitor) {
  if (!span || source[span.start] !== "[") throw new SourceAdapterError("OCEL_INCREMENTAL_NOT_APPLICABLE", "OCEL collection is geen array.");
  let index = jsonSkipWhitespace(source, span.start + 1);
  let recordIndex = 0;
  while (index < span.end) {
    if (source[index] === "]") return recordIndex;
    const end = jsonValueEnd(source, index);
    let record;
    try { record = JSON.parse(source.slice(index, end)); }
    catch (cause) { throw new SourceAdapterError("MALFORMED_OCEL", `OCEL record ${recordIndex + 1} kan niet worden geparseerd.`, { cause }); }
    visitor(record, recordIndex);
    recordIndex += 1;
    index = jsonSkipWhitespace(source, end);
    if (source[index] === ",") { index = jsonSkipWhitespace(source, index + 1); continue; }
    if (source[index] === "]") return recordIndex;
    throw new SourceAdapterError("MALFORMED_OCEL", `OCEL array is ongeldig na record ${recordIndex}.`);
  }
  throw new SourceAdapterError("MALFORMED_OCEL", "OCEL array is niet afgesloten.");
}

function adaptLargeOcelArrayJson(source, { name = "source.ocel.json" } = {}) {
  const top = indexTopLevelJson(source);
  const markerPresent = top.has("objectTypes") || top.has("eventTypes") || top.has("ocelVersion");
  const objectSpan = top.get("objects");
  const eventSpan = top.get("events");
  if (!markerPresent || !objectSpan || !eventSpan || source[objectSpan.start] !== "[" || source[eventSpan.start] !== "[") {
    throw new SourceAdapterError("OCEL_INCREMENTAL_NOT_APPLICABLE", "JSON is geen array-gebaseerde OCEL-bron.");
  }
  const metadataName = parseTopLevelJsonValue(source, top.get("name"));
  const metadataProcessId = parseTopLevelJsonValue(source, top.get("process_id"));
  const metadataVersion = parseTopLevelJsonValue(source, top.get("ocelVersion"));
  const sourceName = typeof metadataName === "string" && metadataName ? metadataName : baseName(name);
  const processId = typeof metadataProcessId === "string" && metadataProcessId ? metadataProcessId : safeId(sourceName);
  const sourceProvenance = Object.freeze({ source_type: "OCEL", source_ref: name });
  const relations = [];
  const objects = [];
  const events = [];

  forEachJsonArrayElement(source, objectSpan, (object, index) => {
    if (!object || typeof object !== "object" || Array.isArray(object)) {
      throw new SourceAdapterError("MALFORMED_OCEL", `OCEL object op index ${index} is ongeldig.`);
    }
    const objectId = id(object, "object_id", "id", "ocel:oid") || `object-${index + 1}`;
    const relationships = ocelRelationships(object, "object", objectId, { consume: true });
    const attributes = ocelAttributes(object.attributes ?? object.ovmap ?? object["ocel:ovmap"], "object", objectId, { consume: true });
    relationships.forEach((relationship, relationshipIndex) => {
      const targetObjectId = relatedObjectId(relationship);
      if (!targetObjectId) return;
      relations.push({
        relation_id: id(relationship, "relation_id") || `ocel-relation-${String(index + 1).padStart(4, "0")}-${String(relationshipIndex + 1).padStart(3, "0")}`,
        relation_type: relationshipQualifier(relationship) || "OCEL_OBJECT_RELATION",
        source_object_id: objectId,
        target_object_id: targetObjectId,
        qualifier: relationshipQualifier(relationship),
        attributes: {},
        provenance: sourceProvenance,
      });
    });
    objects.push({
      object_id: objectId,
      object_type: id(object, "object_type", "type", "ocel:type") || "object",
      name: object.name || objectId,
      attributes: attributes.values,
      ...(attributes.source ? { ocel_attributes: attributes.source } : {}),
      provenance: sourceProvenance,
    });
  });

  forEachJsonArrayElement(source, eventSpan, (event, index) => {
    if (!event || typeof event !== "object" || Array.isArray(event)) {
      throw new SourceAdapterError("MALFORMED_OCEL", `OCEL event op index ${index} is ongeldig.`);
    }
    const eventId = id(event, "event_id", "id", "ocel:eid") || `event-${index + 1}`;
    const relationships = ocelRelationships(event, "event", eventId, { consume: true });
    const attributes = ocelAttributes(event.attributes ?? event.vmap ?? event["ocel:vmap"], "event", eventId, { consume: true });
    const activityId = id(event, "activity_id", "activity", "type", "ocel:activity");
    events.push({
      event_id: eventId,
      process_id: id(event, "process_id") || processId,
      case_id: id(event, "case_id"),
      activity_id: activityId,
      event_type: id(event, "event_type", "activity", "type", "ocel:activity") || activityId,
      timestamp: event.timestamp || event.time || event["ocel:timestamp"] || null,
      object_ids: [...new Set(relationships.map(relatedObjectId).filter(Boolean))],
      actor_ids: Array.isArray(event.actor_ids) && event.actor_ids.length ? event.actor_ids.map(String) : EMPTY_IDS,
      attributes: attributes.values,
      ...(attributes.source ? { ocel_attributes: attributes.source } : {}),
      provenance: sourceProvenance,
    });
  });

  return deepFreeze({
    schema: "adapter.ocel-json.v2",
    bundle_id: safeId(processId),
    manifest: { name: sourceName, source_format: "OCEL_JSON", ocel_version: metadataVersion || null },
    collections: { events, objects, relations, processes: [{ process_id: processId, name: sourceName }] },
  });
}


function byteView(value) {
  if (value instanceof Uint8Array) return value;
  if (value instanceof ArrayBuffer) return new Uint8Array(value);
  if (ArrayBuffer.isView(value)) return new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
  throw new SourceAdapterError("INVALID_BINARY_SOURCE", "Bronbestand bevat geen geldige bytes.");
}

function byteJsonSkipWhitespace(source, start) {
  let index = start;
  if (index === 0 && source.length >= 3 && source[0] === 0xef && source[1] === 0xbb && source[2] === 0xbf) index = 3;
  while (index < source.length && (source[index] === 0x20 || source[index] === 0x09 || source[index] === 0x0a || source[index] === 0x0d)) index += 1;
  return index;
}

function byteJsonStringEnd(source, start) {
  if (source[start] !== 0x22) throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een ongeldige stringgrens.");
  let escaped = false;
  for (let index = start + 1; index < source.length; index += 1) {
    const character = source[index];
    if (escaped) escaped = false;
    else if (character === 0x5c) escaped = true;
    else if (character === 0x22) return index + 1;
  }
  throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een niet-afgesloten string.");
}

function byteJsonCompositeEnd(source, start) {
  const opener = source[start];
  if (opener !== 0x7b && opener !== 0x5b) throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een ongeldige samengestelde waarde.");
  const stack = [opener === 0x7b ? 0x7d : 0x5d];
  let inString = false;
  let escaped = false;
  for (let index = start + 1; index < source.length; index += 1) {
    const character = source[index];
    if (inString) {
      if (escaped) escaped = false;
      else if (character === 0x5c) escaped = true;
      else if (character === 0x22) inString = false;
      continue;
    }
    if (character === 0x22) { inString = true; continue; }
    if (character === 0x7b) stack.push(0x7d);
    else if (character === 0x5b) stack.push(0x5d);
    else if (character === 0x7d || character === 0x5d) {
      if (stack.pop() !== character) throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat niet-passende haakjes.");
      if (!stack.length) return index + 1;
    }
  }
  throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een niet-afgesloten samengestelde waarde.");
}

function byteJsonValueEnd(source, start) {
  const index = byteJsonSkipWhitespace(source, start);
  const character = source[index];
  if (character === 0x22) return byteJsonStringEnd(source, index);
  if (character === 0x7b || character === 0x5b) return byteJsonCompositeEnd(source, index);
  let end = index;
  while (end < source.length && source[end] !== 0x2c && source[end] !== 0x7d && source[end] !== 0x5d) end += 1;
  if (end === index) throw new SourceAdapterError("MALFORMED_JSON", "JSON bevat een lege waarde.");
  return end;
}

function byteJsonParseSlice(source, start, end, message = "JSON-fragment kan niet worden geparseerd.") {
  try { return JSON.parse(BYTE_DECODER.decode(source.subarray(start, end))); }
  catch (cause) { throw new SourceAdapterError("MALFORMED_JSON", message, { cause }); }
}

function indexTopLevelJsonBytes(sourceValue) {
  const source = byteView(sourceValue);
  const values = new Map();
  let index = byteJsonSkipWhitespace(source, 0);
  if (source[index] !== 0x7b) throw new SourceAdapterError("OCEL_INCREMENTAL_NOT_APPLICABLE", "Geen top-level JSON-object.");
  index += 1;
  while (index < source.length) {
    index = byteJsonSkipWhitespace(source, index);
    if (source[index] === 0x7d) return values;
    if (source[index] !== 0x22) throw new SourceAdapterError("MALFORMED_JSON", "JSON top-level sleutel is ongeldig.");
    const keyEnd = byteJsonStringEnd(source, index);
    const key = byteJsonParseSlice(source, index, keyEnd, "JSON top-level sleutel kan niet worden geparseerd.");
    index = byteJsonSkipWhitespace(source, keyEnd);
    if (source[index] !== 0x3a) throw new SourceAdapterError("MALFORMED_JSON", "JSON mist een dubbele punt na een top-level sleutel.");
    const valueStart = byteJsonSkipWhitespace(source, index + 1);
    const valueEnd = byteJsonValueEnd(source, valueStart);
    values.set(String(key), { start: valueStart, end: valueEnd });
    index = byteJsonSkipWhitespace(source, valueEnd);
    if (source[index] === 0x2c) { index += 1; continue; }
    if (source[index] === 0x7d) return values;
    throw new SourceAdapterError("MALFORMED_JSON", "JSON mist een komma of afsluitende accolade.");
  }
  throw new SourceAdapterError("MALFORMED_JSON", "JSON top-level object is niet afgesloten.");
}

function parseTopLevelJsonByteValue(sourceValue, span) {
  if (!span) return undefined;
  const source = byteView(sourceValue);
  return byteJsonParseSlice(source, span.start, span.end, "JSON metadatawaarde kan niet worden geparseerd.");
}

function forEachJsonArrayElementBytes(sourceValue, span, visitor) {
  const source = byteView(sourceValue);
  if (!span || source[span.start] !== 0x5b) throw new SourceAdapterError("OCEL_INCREMENTAL_NOT_APPLICABLE", "OCEL collection is geen array.");
  let index = byteJsonSkipWhitespace(source, span.start + 1);
  let recordIndex = 0;
  while (index < span.end) {
    if (source[index] === 0x5d) return recordIndex;
    const end = byteJsonValueEnd(source, index);
    let record;
    try { record = JSON.parse(BYTE_DECODER.decode(source.subarray(index, end))); }
    catch (cause) { throw new SourceAdapterError("MALFORMED_OCEL", `OCEL record ${recordIndex + 1} kan niet worden geparseerd.`, { cause }); }
    visitor(record, recordIndex);
    record = null;
    recordIndex += 1;
    index = byteJsonSkipWhitespace(source, end);
    if (source[index] === 0x2c) { index = byteJsonSkipWhitespace(source, index + 1); continue; }
    if (source[index] === 0x5d) return recordIndex;
    throw new SourceAdapterError("MALFORMED_OCEL", `OCEL array is ongeldig na record ${recordIndex}.`);
  }
  throw new SourceAdapterError("MALFORMED_OCEL", "OCEL array is niet afgesloten.");
}

function adaptLargeOcelArrayBytes(sourceValue, { name = "source.ocel.json" } = {}) {
  const source = byteView(sourceValue);
  const top = indexTopLevelJsonBytes(source);
  const markerPresent = top.has("objectTypes") || top.has("eventTypes") || top.has("ocelVersion");
  const objectSpan = top.get("objects");
  const eventSpan = top.get("events");
  if (!markerPresent || !objectSpan || !eventSpan || source[objectSpan.start] !== 0x5b || source[eventSpan.start] !== 0x5b) {
    throw new SourceAdapterError("OCEL_INCREMENTAL_NOT_APPLICABLE", "JSON is geen array-gebaseerde OCEL-bron.");
  }
  const metadataName = parseTopLevelJsonByteValue(source, top.get("name"));
  const metadataProcessId = parseTopLevelJsonByteValue(source, top.get("process_id"));
  const metadataVersion = parseTopLevelJsonByteValue(source, top.get("ocelVersion"));
  const sourceName = typeof metadataName === "string" && metadataName ? metadataName : baseName(name);
  const processId = typeof metadataProcessId === "string" && metadataProcessId ? metadataProcessId : safeId(sourceName);
  const sourceProvenance = Object.freeze({ source_type: "OCEL", source_ref: name });
  const relations = [];
  const objects = [];
  const events = [];

  forEachJsonArrayElementBytes(source, objectSpan, (object, index) => {
    if (!object || typeof object !== "object" || Array.isArray(object)) throw new SourceAdapterError("MALFORMED_OCEL", `OCEL object op index ${index} is ongeldig.`);
    const objectId = id(object, "object_id", "id", "ocel:oid") || `object-${index + 1}`;
    const relationships = ocelRelationships(object, "object", objectId, { consume: true });
    const attributes = ocelAttributes(object.attributes ?? object.ovmap ?? object["ocel:ovmap"], "object", objectId, { consume: true });
    relationships.forEach((relationship, relationshipIndex) => {
      const targetObjectId = relatedObjectId(relationship);
      if (!targetObjectId) return;
      relations.push({
        relation_id: id(relationship, "relation_id") || `ocel-relation-${String(index + 1).padStart(4, "0")}-${String(relationshipIndex + 1).padStart(3, "0")}`,
        relation_type: relationshipQualifier(relationship) || "OCEL_OBJECT_RELATION",
        source_object_id: objectId,
        target_object_id: targetObjectId,
        qualifier: relationshipQualifier(relationship),
        attributes: {},
        provenance: sourceProvenance,
      });
    });
    objects.push({
      object_id: objectId,
      object_type: id(object, "object_type", "type", "ocel:type") || "object",
      name: object.name || objectId,
      attributes: attributes.values,
      ...(attributes.source ? { ocel_attributes: attributes.source } : {}),
      provenance: sourceProvenance,
    });
  });

  forEachJsonArrayElementBytes(source, eventSpan, (event, index) => {
    if (!event || typeof event !== "object" || Array.isArray(event)) throw new SourceAdapterError("MALFORMED_OCEL", `OCEL event op index ${index} is ongeldig.`);
    const eventId = id(event, "event_id", "id", "ocel:eid") || `event-${index + 1}`;
    const relationships = ocelRelationships(event, "event", eventId, { consume: true });
    const attributes = ocelAttributes(event.attributes ?? event.vmap ?? event["ocel:vmap"], "event", eventId, { consume: true });
    const activityId = id(event, "activity_id", "activity", "type", "ocel:activity");
    events.push({
      event_id: eventId,
      process_id: id(event, "process_id") || processId,
      case_id: id(event, "case_id"),
      activity_id: activityId,
      event_type: id(event, "event_type", "activity", "type", "ocel:activity") || activityId,
      timestamp: event.timestamp || event.time || event["ocel:timestamp"] || null,
      object_ids: [...new Set(relationships.map(relatedObjectId).filter(Boolean))],
      actor_ids: Array.isArray(event.actor_ids) && event.actor_ids.length ? event.actor_ids.map(String) : EMPTY_IDS,
      attributes: attributes.values,
      ...(attributes.source ? { ocel_attributes: attributes.source } : {}),
      provenance: sourceProvenance,
    });
  });

  return deepFreeze({
    schema: "adapter.ocel-json.v2",
    bundle_id: safeId(processId),
    manifest: { name: sourceName, source_format: "OCEL_JSON", ocel_version: metadataVersion || null },
    collections: { events, objects, relations, processes: [{ process_id: processId, name: sourceName }] },
  });
}

function adaptSourceBytes({ name, bytes }) {
  const normalizedName = String(name || "").toLowerCase();
  const source = byteView(bytes);
  if (normalizedName.endsWith(".json") && source.byteLength >= INCREMENTAL_OCEL_THRESHOLD) {
    try { return adaptLargeOcelArrayBytes(source, { name }); }
    catch (cause) {
      if (cause?.code !== "OCEL_INCREMENTAL_NOT_APPLICABLE") throw cause;
    }
  }
  return adaptSource({ name, text: BYTE_DECODER.decode(source) });
}

function adaptJson(text, { name = "source.json" } = {}) {
  const source = String(text ?? "");
  if (source.length >= INCREMENTAL_OCEL_THRESHOLD && (source.includes('"objectTypes"') || source.includes('"eventTypes"') || source.includes('"ocelVersion"'))) {
    try { return adaptLargeOcelArrayJson(source, { name }); }
    catch (cause) {
      if (cause?.code !== "OCEL_INCREMENTAL_NOT_APPLICABLE") throw cause;
    }
  }
  let raw;
  try {
    raw = JSON.parse(source);
  } catch (cause) {
    throw new SourceAdapterError("MALFORMED_JSON", "JSON-bron kan niet worden geparseerd.", { cause });
  }
  return deepFreeze(bundleFromJsonObject(raw, name));
}

function isOcdsJson(raw) {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return false;
  if (Array.isArray(raw.releases)) return raw.releases.some((release) => release && typeof release === "object" && (release.ocid || release.id));
  if (Array.isArray(raw.records)) {
    return raw.records.some((record) => record && typeof record === "object" && (record.ocid || record.compiledRelease || Array.isArray(record.releases)));
  }
  return false;
}

function adaptOcdsJson(raw, { name = "source.ocds.json" } = {}) {
  if (!isOcdsJson(raw)) {
    throw new SourceAdapterError("UNRECOGNIZED_OCDS", "JSON-bron is geen herkenbare OCDS-bron.");
  }
  const releases = Array.isArray(raw.releases)
    ? raw.releases
    : raw.records.flatMap((record) =>
        Array.isArray(record?.releases) && record.releases.length
          ? record.releases
          : record?.compiledRelease
            ? [record.compiledRelease]
            : [],
      );
  const grouped = new Map();
  for (const release of releases) {
    if (!release || typeof release !== "object" || Array.isArray(release)) continue;
    const ocid = String(release.ocid || "OCDS-UNKNOWN");
    if (!grouped.has(ocid)) grouped.set(ocid, []);
    grouped.get(ocid).push(structuredClone(release));
  }
  const sourceName = baseName(name);
  const objects = [];
  const events = [];
  let caseNumber = 0;
  for (const [ocid, records] of [...grouped].sort(([a], [b]) => a.localeCompare(b))) {
    const objectId = `OCDS-${String(++caseNumber).padStart(4, "0")}`;
    objects.push({
      object_id: objectId,
      object_type: "contracting_process",
      name: ocid,
      lifecycle_status: "IMPORTED",
      attributes: { ocid },
      provenance: { source_type: "OCDS", source_ref: name },
    });
    records
      .sort((left, right) => Date.parse(left.date || 0) - Date.parse(right.date || 0))
      .forEach((release, index) => {
        const tags = Array.isArray(release.tag) ? release.tag.map(String) : [];
        const activity = tags[0] || "RELEASE";
        events.push({
          event_id: String(release.id || `${objectId}-e${index + 1}`),
          case_id: ocid,
          process_id: "P-OCDS",
          activity_id: activity,
          event_type: `OCDS_${tags.join("_") || "RELEASE"}`,
          timestamp: release.date || null,
          object_ids: [objectId],
          actor_ids: [],
          attributes: {
            tender: structuredClone(release.tender ?? null),
            awards: structuredClone(release.awards ?? null),
            contracts: structuredClone(release.contracts ?? null),
          },
          provenance: { source_type: "OCDS", source_ref: name },
        });
      });
  }
  return deepFreeze({
    schema: "adapter.ocds-json.v2",
    bundle_id: safeId(sourceName || "ocds-import"),
    manifest: { name: sourceName || "OCDS import", source_format: "OCDS_JSON" },
    collections: {
      events,
      objects,
      processes: [{ process_id: "P-OCDS", name: "OCDS contracting process" }],
    },
  });
}

function xmlDecode(value) {
  return String(value ?? "")
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&");
}

function xesAttribute(fragment, key) {
  const escaped = String(key).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const tag = new RegExp(`<(?:string|date|int|float|boolean)\\b[^>]*\\bkey=["']${escaped}["'][^>]*\\bvalue=["']([^"']*)["'][^>]*/?>`, "i");
  const reversed = new RegExp(`<(?:string|date|int|float|boolean)\\b[^>]*\\bvalue=["']([^"']*)["'][^>]*\\bkey=["']${escaped}["'][^>]*/?>`, "i");
  const match = fragment.match(tag) || fragment.match(reversed);
  return match ? xmlDecode(match[1]) : null;
}

function adaptXes(text, { name = "source.xes" } = {}) {
  const source = String(text ?? "");
  if (!/<(?:\w+:)?log\b/i.test(source)) {
    throw new SourceAdapterError("UNRECOGNIZED_XES", "XML-bron bevat geen herkenbare XES-log.");
  }
  const traceFragments = [...source.matchAll(/<(?:\w+:)?trace\b[^>]*>([\s\S]*?)<\/(?:\w+:)?trace>/gi)].map((match) => match[1]);
  const sourceName = baseName(name);
  const objects = [];
  const events = [];
  const actors = new Map();
  traceFragments.forEach((trace, traceIndex) => {
    const beforeFirstEvent = trace.split(/<(?:\w+:)?event\b/i, 1)[0] || trace;
    const caseId = xesAttribute(beforeFirstEvent, "concept:name") || String(traceIndex + 1);
    const objectId = `XES-${safeId(caseId)}`;
    objects.push({
      object_id: objectId,
      object_type: "case",
      name: caseId,
      lifecycle_status: "IMPORTED",
      attributes: { source: name },
      provenance: { source_type: "XES", source_ref: name },
    });
    const eventFragments = [...trace.matchAll(/<(?:\w+:)?event\b[^>]*>([\s\S]*?)<\/(?:\w+:)?event>/gi)].map((match) => match[1]);
    eventFragments.forEach((eventFragment, eventIndex) => {
      const activity = xesAttribute(eventFragment, "concept:name") || "XES_EVENT";
      const timestamp = xesAttribute(eventFragment, "time:timestamp");
      const resource = xesAttribute(eventFragment, "org:resource");
      let actorId = null;
      if (resource) {
        if (!actors.has(resource)) {
          actors.set(resource, {
            actor_id: `ACT-XES-${String(actors.size + 1).padStart(4, "0")}`,
            actor_type: "PERSON_OR_SYSTEM",
            display_name: resource,
            roles: ["ROLE-XES"],
            attributes: {},
            provenance: { source_type: "XES", source_ref: name },
          });
        }
        actorId = actors.get(resource).actor_id;
      }
      events.push({
        event_id: `EVT-XES-${traceIndex + 1}-${eventIndex + 1}`,
        case_id: caseId,
        process_id: "P-XES",
        activity_id: activity,
        event_type: activity,
        timestamp,
        object_ids: [objectId],
        actor_ids: actorId ? [actorId] : [],
        attributes: { lifecycle: xesAttribute(eventFragment, "lifecycle:transition") },
        provenance: { source_type: "XES", source_ref: name },
      });
    });
  });
  if (!traceFragments.length) {
    throw new SourceAdapterError("MALFORMED_XES", "XES-log bevat geen traces.");
  }
  return deepFreeze({
    schema: "adapter.xes.v2",
    bundle_id: safeId(sourceName || "xes-import"),
    manifest: { name: sourceName || "XES import", source_format: "XES" },
    collections: {
      events,
      objects,
      actors: [...actors.values()],
      processes: [{ process_id: "P-XES", name: sourceName || "XES process" }],
    },
  });
}

const MERGE_COLLECTIONS = Object.freeze(KNOWN_COLLECTIONS);
const MERGE_ID_KEYS = Object.freeze({
  objects: "object_id", actors: "actor_id", relations: "relation_id", events: "event_id",
  communications: "communication_id", commitments: "commitment_id", decisions: "decision_id",
  information_positions: "information_position_id", norms: "norm_id", goals: "goal_id",
  outcomes: "outcome_id", evidence: "evidence_id", ground_truth: "scenario_id", processes: "process_id",
});

function mergeBundles(bundles, { name = "Gecombineerde bron", bundleId = "multi-source" } = {}) {
  if (!Array.isArray(bundles) || !bundles.length) {
    throw new SourceAdapterError("EMPTY_ARCHIVE", "Bronpakket bevat geen ondersteunde databronnen.");
  }
  if (bundles.length === 1) {
    const only = bundles[0];
    if (!only?.collections || typeof only.collections !== "object") {
      throw new SourceAdapterError("INVALID_ARCHIVE_ENTRY", "Bronpakket bevat een ongeldig bundle-resultaat.");
    }
    const collections = Object.fromEntries(MERGE_COLLECTIONS.map((key) => [key, Array.isArray(only.collections[key]) ? only.collections[key] : EMPTY_IDS]));
    return deepFreeze({
      schema: "adapter.multi-source.v2",
      bundle_id: safeId(bundleId),
      manifest: { name, source_format: "SOURCE_PACKAGE", source_count: 1 },
      collections,
    });
  }
  const collections = Object.fromEntries(MERGE_COLLECTIONS.map((key) => [key, []]));
  for (const bundle of bundles) {
    if (!bundle?.collections || typeof bundle.collections !== "object") {
      throw new SourceAdapterError("INVALID_ARCHIVE_ENTRY", "Bronpakket bevat een ongeldig bundle-resultaat.");
    }
    for (const key of MERGE_COLLECTIONS) {
      if (Array.isArray(bundle.collections[key])) collections[key].push(...structuredClone(bundle.collections[key]));
    }
  }
  for (const [collectionName, key] of Object.entries(MERGE_ID_KEYS)) {
    const seen = new Map();
    collections[collectionName] = collections[collectionName].map((record) => {
      const value = record?.[key];
      if (value === undefined || value === null || value === "") return record;
      const original = String(value);
      const count = (seen.get(original) || 0) + 1;
      seen.set(original, count);
      if (count === 1) return record;
      return { ...record, [key]: `${original}__${count}` };
    });
  }
  return deepFreeze({
    schema: "adapter.multi-source.v2",
    bundle_id: safeId(bundleId),
    manifest: { name, source_format: "SOURCE_PACKAGE", source_count: bundles.length },
    collections,
  });
}

function adaptSource({ name, text }) {
  const normalizedName = String(name || "").toLowerCase();
  if (normalizedName.endsWith(".jsonl") || normalizedName.endsWith(".ndjson")) return adaptOcdsJsonLines(text, { name });
  if (normalizedName.endsWith(".json")) return adaptJson(text, { name });
  if (normalizedName.endsWith(".csv")) return adaptCsv(text, { name });
  if (normalizedName.endsWith(".xes") || normalizedName.endsWith(".xml")) return adaptXes(text, { name });
