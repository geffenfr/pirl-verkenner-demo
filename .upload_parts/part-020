"src/application/process-entity-evidence.js":function(load){
"use strict";
const {deepFreeze}=load("src/core/data/immutability.js");
const {OBJECT_PROCESS_NAMES,OBJECT_ACTIVITY_NAMES}=load("src/application/object-explorer-controller.js");



const text = value => value == null ? "" : String(value);
const recordId = (record, name) => text(record?.[name] ?? record?.id);
const ids = value => Array.isArray(value) ? value.map(text) : [];
const canonicalJson = value => JSON.stringify(value, function (_key, item) {
  return item && !Array.isArray(item) && typeof item === "object"
    ? Object.fromEntries(Object.keys(item).sort().map(key => [key, item[key]])) : item;
});

/** Direct evidence only: no relation traversal, case expansion or inferred follows. */
function createProcessEntityEvidence(model, entity) {
  const kind = entity?.kind || "object", id = text(entity?.id);
  const records = kind === "object" ? model?.objects : kind === "actor" ? model?.actors : kind === "event" ? model?.events : [];
  const sourceKey = kind === "object" ? "object_id" : kind === "actor" ? "actor_id" : "event_id";
  const sourceEntity = (records || []).find(record => recordId(record, sourceKey) === id);
  const summary = {
    entity: { ...structuredClone(entity || {}), kind, id }, entityFound: Boolean(sourceEntity),
    basis: kind === "object" ? "event.object_ids" : kind === "actor" ? "event.actor_ids" : "event.event_id",
    sourceCollection: "canonical model.events (actieve gebeurtenissen)",
    groups: [], events: [], directEventCount: 0, duplicateRecords: 0,
    conflictingIds: [], missingEventIds: 0, missingProcessIds: 0,
    excludes: "Geen uitbreiding via objectrelaties, cases, uitgesloten bronrecords of afgeleide procespaden.",
  };
  if (!sourceEntity) return deepFreeze(summary);
  const allEvents = model.events || [];
  const matches = event => kind === "object" ? ids(event.object_ids).includes(id)
    : kind === "actor" ? ids(event.actor_ids).includes(id) : recordId(event, "event_id") === id;
  // Inspect all variants of a matching ID: an inconsistent duplicate must never
  // silently assign a process or masquerade as a second unique event.
  const matchingIds = new Set(allEvents.filter(matches).map(event => recordId(event, "event_id")).filter(Boolean));
  const byKey = new Map();
  allEvents.forEach((event, sourceIndex) => {
    const eventId = recordId(event, "event_id");
    if (!(eventId ? matchingIds.has(eventId) : matches(event))) return;
    const key = eventId ? `id:${eventId}` : `source-row:${sourceIndex}`;
    const bucket = byKey.get(key) || { key, eventId: eventId || null, sourceRows: [], sources: [], signatures: new Set() };
    bucket.sourceRows.push(sourceIndex + 1);
    const signature = canonicalJson(event);
    if (!bucket.signatures.has(signature)) { bucket.signatures.add(signature); bucket.sources.push(event); }
    byKey.set(key, bucket);
  });
  const processLabel = pid => {
    const process = (model.processes || []).find(row => recordId(row, "process_id") === pid);
    return OBJECT_PROCESS_NAMES[pid] || text(process?.label || process?.name) || pid;
  };
  for (const bucket of byKey.values()) {
    const event = bucket.sources[0], conflict = bucket.sources.length > 1;
    const pid = conflict ? null : text(event.process_id).trim() || null;
    const activityId = conflict ? null : text(event.activity_id || event.activity);
    const row = {
      key: bucket.key, id: bucket.eventId, sourceRows: bucket.sourceRows, conflict,
      processId: pid, processLabel: pid ? processLabel(pid) : conflict ? "Conflicterende event-ID — geen toewijzing" : "Zonder procesverwijzing",
      activityId, activityLabel: activityId ? OBJECT_ACTIVITY_NAMES[activityId] || activityId : "Niet eenduidig",
      timestamp: conflict ? null : text(event.timestamp || event.time || event.datetime),
      objectIds: conflict ? [] : ids(event.object_ids), actorIds: conflict ? [] : ids(event.actor_ids),
      sourceRecords: bucket.sources.map(record => structuredClone(record)),
    };
    summary.events.push(row);
    summary.duplicateRecords += bucket.sourceRows.length - 1;
    if (conflict) summary.conflictingIds.push(bucket.eventId);
