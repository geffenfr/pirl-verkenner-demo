    },
  });
}

/** Knowledge availability is separate from occurrence/validity. Do not reveal
 * later values as historical knowledge; an explicitly stored decision snapshot
 * is source testimony, not proof that unrecorded facts were available.
 */
function temporalInformationItems(position,decision,override=null){
  const cutoff=override||decision?.t_cutoff||decision?.cutoff||decision?.decision_time||decision?.timestamp;
  const cut=Date.parse(cutoff),snapshotLinked=Boolean(position && ((position.decision_id&&position.decision_id===decision?.decision_id)||(position.information_position_id&&position.information_position_id===decision?.information_position_id)));
  return informationItems(position).map(item=>{
    const raw=item.available_from||item.availability_time||position?.available_from;
    const time=Date.parse(raw),valid=Number.isFinite(cut),explicit=Number.isFinite(time);
    const later=valid&&explicit&&time>cut;
    const unknown=!valid||(!explicit&&!snapshotLinked)||Boolean(override&&!explicit);
    if(later||unknown)return {...item,value:null,actual_value:null,evidence:'Waarde/evidence niet als historisch beschikbaar aangetoond.',provenance:null,evidence_ids:[],source:null,evidence_ref:null,
      status:later?'POST_CUTOFF':'UNKNOWN',temporalBasis:later?'AVAILABLE_AFTER_CUTOFF':'AVAILABILITY_NOT_ESTABLISHED'};
