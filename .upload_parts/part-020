  for (const row of summary.events) {
    const key = row.conflict ? "conflicts" : row.processId ? `process:${row.processId}` : "unassigned";
    if (!groups.has(key)) groups.set(key, { key, processId: row.processId, label: row.processLabel, count: 0, eventKeys: [] });
