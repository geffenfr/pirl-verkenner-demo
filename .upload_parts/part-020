}

function groupCases(model, processId, measurementModel=null) {
  const cases = (model.cases || [])
    .filter((caseRecord) => String(caseRecord.process_id || "") === processId)
    .map((caseRecord) => enrichCase(model, caseRecord,measurementModel));
  const groups = new Map();
  for (const item of cases) {
    if (!groups.has(item.sequence)) groups.set(item.sequence, []);
    groups.get(item.sequence).push(item);
  }
  return [...groups.entries()]
    .map(([sequence, members]) => ({ sequence, members }))
    .sort((left, right) => right.members.length - left.members.length || left.sequence.localeCompare(right.sequence));
}

function metricsForMembers(members, processCaseCount) {
  const cycle = mean(members.map((item) => item.cycle));
  const ftrValues = members.map((item) => item.firstTimeRight === null ? null : item.firstTimeRight ? 1 : 0);
  const ftr = mean(ftrValues);
  const rework = Number.isFinite(ftr) ? 1 - ftr : null;
  return {
    count: members.length,
    share: processCaseCount ? members.length / processCaseCount : 0,
    cycle,
    ftr,
    rework,
    margin: mean(members.map((item) => item.margin)),
    risk: mean(members.map((item) => item.risk)),
    riskApplicable: members.some((item) => Number.isFinite(item.risk)),
    observations:Object.fromEntries(['cycle','firstTimeRight','margin','risk'].map(k=>[k,{valid:members.filter(m=>k==='firstTimeRight'?typeof m[k]==='boolean':Number.isFinite(m[k])).length,denominator:members.length,missing:members.filter(m=>k==='firstTimeRight'?typeof m[k]!=='boolean':!Number.isFinite(m[k])).length}])),
  };
}

function scoreAgainstBaseline(metrics, baseline, researchMode=false) {
  const why = [];
  const comparable=['cycle','ftr','rework','margin','risk'].filter(k=>Number.isFinite(metrics[k])&&Number.isFinite(baseline[k]));
  if(researchMode&&!comparable.length)return {score:null,why:['Niet beoordeelbaar: geen gekoppelde meetwaarden voor selectie én referentie. Dit is geen bewijs van afwezig gedragssignaal.']};
  let score = 0;
  if (Number.isFinite(metrics.cycle) && Number.isFinite(baseline.cycle) && metrics.cycle > baseline.cycle * 1.15) {
    score += (metrics.cycle / baseline.cycle - 1) * 3;
    why.push(`doorlooptijd ${metrics.cycle.toFixed(1)} uur versus ${baseline.cycle.toFixed(1)} uur baseline`);
  }
  if (Number.isFinite(metrics.rework) && Number.isFinite(baseline.rework) && metrics.rework > baseline.rework + 0.05) {
    score += (metrics.rework - baseline.rework) * 5;
    why.push(`meer rework (${(metrics.rework * 100).toFixed(1)}% versus ${(baseline.rework * 100).toFixed(1)}%)`);
  }
  if (Number.isFinite(metrics.ftr) && Number.isFinite(baseline.ftr) && metrics.ftr < baseline.ftr - 0.05) {
    score += (baseline.ftr - metrics.ftr) * 5;
    why.push(`lagere FTR (${(metrics.ftr * 100).toFixed(1)}% versus ${(baseline.ftr * 100).toFixed(1)}%)`);
  }
  if (Number.isFinite(metrics.margin) && Number.isFinite(baseline.margin) && metrics.margin < baseline.margin) {
    score += Math.min(3, Math.abs(metrics.margin - baseline.margin) / Math.max(1, Math.abs(baseline.margin)));
    why.push(`lagere marge/case (€ ${metrics.margin.toFixed(0)} versus € ${baseline.margin.toFixed(0)})`);
  }
  if (Number.isFinite(metrics.risk) && Number.isFinite(baseline.risk) && metrics.risk > baseline.risk && metrics.risk > 0) {
    score += Math.min(3, (metrics.risk - baseline.risk) / Math.max(1, baseline.risk || 1));
    why.push(`hogere expected loss/case (€ ${metrics.risk.toFixed(0)})`);
  }
  if (!why.length) why.push("geen sterke materiële afwijking ten opzichte van de baseline binnen de beschikbare meetwaarden");
  if(researchMode&&comparable.length<5)why.push('Onvolledige meetdekking; ontbrekende indicatoren zijn niet als nul beoordeeld.');
  return { score, why };
