function controllerFromSession(session, viewMethod, extra = {}, release = () => {}) {
  let destroyed = false;
  const listeners = new Set();
  const unsubscribe = session.subscribe((event) => {
    if (destroyed) return;
    for (const listener of listeners) listener(event);
  });
  return Object.freeze({
    getViewModel() { return session.annotate(session[viewMethod]()); },
    subscribe(listener) {
      if (typeof listener !== "function") throw new TypeError("Listener must be a function");
      if (destroyed) return () => {};
      listeners.add(listener);
      return () => listeners.delete(listener);
    },
    enter() { return session.enter(); },
    selectDecision(value) { return session.selectDecision(value); },
    clearContextCase() { return session.clearCase(); },
    clearContextDecision() { return session.clearDecision(); },
    ...extra,
    destroy() {
      if (destroyed) return;
      destroyed = true;
      unsubscribe();
      listeners.clear();
      release();
    },
  });
}

function createInformationPositionControllers({ runtimeStore, contextStore,scopeService=null, onListenerError = () => {} } = {}) {
  if (!runtimeStore?.snapshot || !runtimeStore?.subscribe) throw new TypeError("Information Position controllers require a Runtime Store");
  if (!contextStore?.getState || !contextStore?.transact || !contextStore?.subscribe) throw new TypeError("Information Position controllers require a Research Context Store");
  const session = createSession({ runtimeStore, contextStore,scopeService, onListenerError });
  let liveControllers = 5;
  let sessionReleased = false;
  const release = () => {
    liveControllers -= 1;
    if (!sessionReleased && liveControllers <= 0) { sessionReleased = true; session.destroy(); }
  };
  const overview = controllerFromSession(session, "overviewViewModel", {
    setCategory: (value) => session.setCategory(value),
    setSearch: (value) => session.setSearch(value),
    setSort: (value) => session.setSort(value),
    clearFilter: () => session.clearFilter(),
    toggleSelection: (key, selected) => session.toggleSelection(key, selected),
    selectAllVisible: () => session.selectAllVisible(),
    clearSelection: () => session.clearSelection(),
    openCompare: () => session.openCompare(),
    closeCompare: () => session.closeCompare(),
    investigate: (key) => session.investigate(key),
  }, release);
  const trace = controllerFromSession(session, "traceViewModel", {
    setCutoff: (value) => session.setCutoff(value),
    resetCutoff: () => session.resetCutoff(),
  }, release);
  const decision = controllerFromSession(session, "decisionViewModel", {
    selectDecision: (value) => session.selectDecision(value),
  }, release);
  const reconstruct = controllerFromSession(session, "reconstructViewModel", {}, release);
  const diagnose = controllerFromSession(session, "diagnoseViewModel", {}, release);
