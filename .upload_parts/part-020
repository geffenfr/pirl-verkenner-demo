function buildRelations(model) {
  const byObject = new Map();
  for (const relation of model.relations || []) {
    const source = id(relation, "source_object_id", "source_id");
    const target = id(relation, "target_object_id", "target_id");
    for (const objectId of [source, target]) {
      if (!objectId) continue;
      if (!byObject.has(objectId)) byObject.set(objectId, []);
      byObject.get(objectId).push(relation);
    }
  }
  return byObject;
}

function novaReachableObjectIds(model, caseId, objectById) {
  const reached = new Set([caseId]);
  for (let round = 0; round < 8; round += 1) {
    let changed = false;
    for (const relation of model.relations || []) {
      const type = relationType(relation);
      const source = id(relation, "source_object_id", "source_id");
      const target = id(relation, "target_object_id", "target_id");
      if (NOVA_FORWARD_RELATIONS.has(type) && reached.has(source) && target && !reached.has(target)) {
        reached.add(target);
        changed = true;
      }
      if (NOVA_REVERSE_RELATIONS.has(type) && reached.has(target) && source && !reached.has(source)) {
        reached.add(source);
        changed = true;
      }
    }
    if (!changed) break;
