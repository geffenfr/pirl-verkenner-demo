  }

  function diagnose(caseId, decisionId = null) {
    const selectedDecision = decision(caseId, decisionId);
    if (!selectedDecision) return [];
    const ip = positionFor(selectedDecision);
    const bad = (researchMode?temporalInformationItems(ip,selectedDecision):informationItems(ip)).filter((item) => isInformationIssue(informationStatus(item)));
    const caseTrace = trace(caseId,decisionId);
    const hypotheses = bad.map((item) => ({
      title: issueTitle(item, selectedDecision),
      evidence: issueEvidence(item, selectedDecision),
    }));
    const commitments = linkedCommitments(model, caseTrace.objectIds);
    const breached = commitments.filter((record) => /BREACH|MISSED|VIOLAT/i.test(String(value(record, "status", "state", "commitment_status") || "")));
    const outcomes = linkedOutcomes(model, caseTrace.objectIds);
    const commitmentOutcome = outcomes.find((record) => record?.measures && record.measures.commitment_met === false);
