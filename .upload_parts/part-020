  const unsubscribeMeasurement = measurementService?.subscribe?.((event) => notify(deepFreeze({ type: "LOAD_INVALIDATED", reason: event?.reason || "measurement" }))) || (() => {});
  const unsubscribeOnboarding = onboardingService?.subscribe?.((event) => notify(deepFreeze({ type: "LOAD_INVALIDATED", reason: event?.reason || "onboarding" }))) || (() => {});
  const view = () => deepFreeze({ ...projectLoadExplorer(runtimeStore.snapshot()), busy, error, measurementContract: measurementService?.getStatus?.() || null, sourceOnboarding: onboardingService?.getStatus?.() || null });
