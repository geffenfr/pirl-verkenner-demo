      [ev.behavior.included?(ev.behavior.partialTrace?"Gedeeltelijke uitvoeringsevidence; geen volledig primair procesbeeld voor een herwerkoordeel.":`${ev.behavior.repeatedCaseCount} volledige cases met herhaalde activiteiten.`):"Behavior is uitgesloten.",
       ev.value.included?`${ev.value.negativeMargins.length} afzonderlijke bronuitkomst(en) met negatieve marge.`:"Value is uitgesloten.",
       "Aanleiding voor onderzoek, geen bewezen herwerk, oorzaak of voordeel."].join(" "):
      `${def.id==="governance_rule"?governanceRefs.length:ipRefs.length} informatie-items met een probleem- of onzekerheidsstatus binnen de opgenomen IP-evidence. Onderzoek de betekenis voordat je een interventie kiest.`;
    else explanation="Geen specifiek probleemsignaal vastgesteld met de ondersteunde waarnemingsregels binnen de opgenomen evidence. Dit bewijst niet dat er geen probleem is.";
    const structuralLimit=def.structural?"Een structurele ingreep vraagt herhaald én passend populatie-evidence, een verklaard mechanisme en bevoegde besluitvorming; scopegrootte alleen is onvoldoende.":
      "Een lokaal signaal kan een lokale onderzoeksactie richten, maar bewijst nog geen geschikt middel of verwacht effect.";
