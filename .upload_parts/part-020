    behavior:{included:Boolean(behavior),status:behavior?.status||"EXCLUDED",eventCount:events.length,completeCaseCount:cases.length,
      repeatedActivities:repeated,repeatedCaseCount:distinct(repeated.map(x=>x.caseKey)).length,
