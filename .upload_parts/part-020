        title: "READY-beslissing met onopgeloste informatie-items",
        evidence: [`Historische beslissing ${id(selectedDecision, "decision_id", "id")} staat READY met ${bad.length} onopgeloste item(s).`],
      });
    }
    return hypotheses;
  }

  return deepFreeze({
    modelIdentity: model.identity,
    bundleId: model.bundleId,
    available: decisions.length > 0 && positions.length > 0,
    decisionCount: decisions.length,
    positionCount: positions.length,
    businessCaseCount: decisionsByCase.size,
    issueRows,
    categories: [...new Set(issueRows.map((row) => row.category))],
    patternCaseIds(processId, pattern) {
      const pid = String(processId || "");
      const sequence = String(pattern?.sequence || "").trim();
      if (!pid || !sequence) return [];
      return caseRecords
        .filter((record) => String(record?.process_id || "") === pid && caseSequence(record) === sequence)
        .map(naturalCaseId)
        .filter(Boolean);
    },
    processName:pid=>!researchMode||sourceKind==='builtin'?processName(pid):String(model.processes?.find(p=>id(p,'process_id','id')===pid)?.name||pid||'—'),
    activityName:aid=>!researchMode||sourceKind==='builtin'?activityName(aid):String(aid||'—'),
    decisionsForCase(caseId) {
      return decisionsByCase.get(String(caseId || "")) || [];
    },
    allDecisions:decisions,
    decision,
    positionFor,
    informationItems,
    temporalInformationItems,
    trace,
    diagnose,
    caseProcessId(caseId, decisionId = null) {
      return id(decision(caseId, decisionId), "process_id", "processId");
    },
    eventLabel(event) {
      const activityId = id(event, "activity_id", "event_type", "type");
      return {
        activityId,
        activityLabel: !researchMode||sourceKind==='builtin'?activityName(activityId):activityId,
        processId: id(event, "process_id", "processId"),
        processLabel: !researchMode||sourceKind==='builtin'?processName(id(event, "process_id", "processId")):id(event,'process_id','processId'),
        technicalEvent: id(event, "event_type", "type"),
