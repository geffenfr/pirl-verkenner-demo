"src/application/information-position-projection.js":function(load){
"use strict";
const {deepFreeze}=load("src/core/data/immutability.js");
const {OBJECT_ACTIVITY_NAMES,OBJECT_PROCESS_NAMES,generatedStepName}=load("src/application/object-explorer-controller.js");



const IP_COMPLETE_CATEGORY = "Volledig / geen zichtbaar issue";
const IP_ISSUES_FILTER = "__issues__";

const NOVASERVE_BUNDLE = "SYN-001-NOVASERVE-FULL-C4-V03";
const BAD_STATUS = /MISSING|INACCESSIBLE|UNKNOWN|CONFLICT|STALE|POST[_ -]?CUTOFF|NOT_AVAILABLE|ABSENT|FAIL/i;
const NOVA_FORWARD_RELATIONS = new Set([
  "incident_concerns_asset",
  "incident_uses_contract",
  "incident_has_appointment",
  "appointment_creates_work_order",
  "work_order_records_labor",
  "work_order_records_parts",
  "work_order_requires_coverage_decision",
  "work_order_generates_invoice",
  "invoice_has_payment",
  "invoice_has_credit_note",
  "complaint_has_recovery_action",
  "financial_impact_relates_to_object",
]);
const NOVA_REVERSE_RELATIONS = new Set([
  "complaint_refers_to_incident",
  "complaint_refers_to_work_order",
  "complaint_refers_to_invoice",
  "satisfaction_measures_journey",
]);
const NOVA_GENERIC_TYPES = new Set(["customer", "contract", "asset"]);

function value(record, ...keys) {
  for (const key of keys) {
    const found = record?.[key];
    if (found !== undefined && found !== null && found !== "") return found;
  }
  return null;
}

function id(record, ...keys) {
  const found = value(record, ...keys);
  return found == null ? "" : String(found);
}

function ids(record, key = "object_ids") {
  const found = record?.[key] ?? [];
  return Array.isArray(found) ? found.map(String) : [];
}

function eventTime(record) {
  return String(value(record, "timestamp", "time", "datetime") || "");
}

function timeRank(record) {
  const rank = Date.parse(eventTime(record));
  return Number.isFinite(rank) ? rank : Number.POSITIVE_INFINITY;
}

function byTime(left, right) {
  return timeRank(left) - timeRank(right) || id(left, "event_id", "decision_id", "id").localeCompare(id(right, "event_id", "decision_id", "id"));
}

function objectType(record) {
  return id(record, "object_type", "type").toLowerCase();
}

function relationType(record) {
  return id(record, "relation_type", "type");
}

function processName(processId) {
  return OBJECT_PROCESS_NAMES[String(processId)] || String(processId || "—");
}

function activityName(activityId) {
  const raw = String(activityId || "");
  const clean = raw.includes("|") ? raw.split("|").at(-1) : raw.includes(":") ? raw.split(":").at(-1) : raw;
  return OBJECT_ACTIVITY_NAMES[clean] || generatedStepName(clean) || clean || "—";
}

function decisionCaseId(decision) {
  return String(
    value(decision?.attributes, "case_id", "caseId") ??
      value(decision, "case_id", "caseId", "trace_id") ??
      "",
  );
}

function naturalCaseId(record) {
  return String(value(record, "display_case_id", "case_object_id", "case_id", "case_key") || "");
}

function caseSequence(record) {
  return (Array.isArray(record?.events) ? record.events : [])
    .map((event) => id(event, "activity_id", "event_type", "type"))
    .filter(Boolean)
    .join(" → ");
}

function informationStatus(item) {
  return String(
    value(item, "status", "availability", "evaluation", "state") ??
      item?.quality?.availability ??
      "AVAILABLE",
  );
}

function isInformationIssue(status) {
  return BAD_STATUS.test(String(status || ""));
}

function informationCategory(item) {
  return String(
    value(item, "domain", "category", "information_domain", "type") ||
      (isInformationIssue(informationStatus(item)) ? "Other issue" : "Available"),
  );
}

function informationEvidence(item) {
  const found =
    value(item, "evidence", "source", "evidence_ref") ?? item?.provenance ?? item?.evidence_ids ?? item?.value;
  if (found == null) return "—";
  return typeof found === "object" ? JSON.stringify(found).slice(0, 600) : String(found);
}

function informationItems(ip) {
  const found = ip?.elements ?? ip?.items ?? ip?.information_items ?? ip?.requirements ?? ip?.information ?? [];
  return Array.isArray(found) ? found : [];
