  const income = asNumber(financialMeasures.realized_revenue_eur) ?? (measurementModel?null:0);
  const directMargin = asNumber(financialMeasures.case_contribution_margin_eur);
  const riskSource = measurementModel?financialMeasures.expected_loss_eur:financialMeasures.expected_loss_eur ?? financialMeasures.value_at_risk_eur;
  const expectedLoss = riskSource === undefined || riskSource === null ? null : asNumber(riskSource);
