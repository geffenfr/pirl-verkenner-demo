"src/application/router.js":function(load){
"use strict";
const {getLocalNavigation,requireRoute}=load("src/product-contract/routes.js");


function routeFromHash(windowRef, fallback) {
  const hash = windowRef?.location?.hash ?? "";
  const match = /^#route=(.+)$/.exec(hash);
  if (!match) return fallback;
  const candidate = decodeURIComponent(match[1]);
  try {
    return requireRoute(candidate).id;
  } catch {
    return fallback;
  }
}

function createRouter({ initialRoute = "home", windowRef = null } = {}) {
  requireRoute(initialRoute);
  let currentRoute = windowRef ? routeFromHash(windowRef, initialRoute) : initialRoute;
  const listeners = new Set();

  const notify = (event) => {
    for (const listener of listeners) listener(event);
  };

  function writeLocation(routeId, replace) {
    if (!windowRef?.history) return;
    const hash = `#route=${encodeURIComponent(routeId)}`;
    try {
      if (replace) windowRef.history.replaceState({ routeId }, "", hash);
      else windowRef.history.pushState({ routeId }, "", hash);
    } catch {
      // A restrictive local-file host may reject History API writes. Routing
      // remains in-memory; product state is never rewritten to compensate.
    }
  }

  function go(
    routeId,
    { replace = false, writeHistory = true, source = "direct", explicitCarry = null } = {},
  ) {
    requireRoute(routeId);
    if (routeId === currentRoute) return false;
    const previousRoute = currentRoute;
    currentRoute = routeId;
    if (writeHistory) writeLocation(routeId, replace);
    notify(Object.freeze({ previousRoute, routeId, source, explicitCarry }));
    return true;
  }

  function onHistoryNavigation() {
    go(routeFromHash(windowRef, "home"), {
      writeHistory: false,
      source: "history",
    });
  }

  windowRef?.addEventListener?.("popstate", onHistoryNavigation);

  return Object.freeze({
    getCurrentRoute() {
      return currentRoute;
    },

    go,

    move(direction) {
      if (direction !== -1 && direction !== 1) {
        throw new RangeError("Local navigation direction must be -1 or 1");
      }
      const navigation = getLocalNavigation(currentRoute);
      const target = direction < 0 ? navigation.previous.routeId : navigation.next.routeId;
      return target ? go(target, { source: "local-navigation" }) : false;
    },

    subscribe(listener) {
      if (typeof listener !== "function") throw new TypeError("Listener must be a function");
      listeners.add(listener);
      return () => listeners.delete(listener);
    },

    dispose() {
      listeners.clear();
      windowRef?.removeEventListener?.("popstate", onHistoryNavigation);
    },
  });
}

return Object.freeze({"createRouter":createRouter});
},
