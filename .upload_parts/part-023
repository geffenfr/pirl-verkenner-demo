  return {
    schema:"pirl.relationship-object-depth2.v1",status,mode:"OBJECT_EXACT_DEPTH2",
    sourceKey,populationKey,seedObjectId,
    directNeighborIds:[...directNeighborIds].sort(),
    pathCount:0,hop2ObjectCount:0,paths:[],hop2Objects:[],
    unresolvedEndpointIds:[...new Set(unresolvedEndpointIds)].sort(),
    invalidRelations:structuredClone(invalidRelations),
    exactDepth:2,endpointReachability:"SYMMETRIC_RAW_DIRECTION_PRESERVED",
    synthesizedSeedToHop2Relations:0,contextExpandsResearchPopulation:false,
    primaryMembershipChanged:false,neighbourHistoryImported:false,
    propagationSemanticsApplied:false,actionAuthorized:false,
    boundary:"Exact depth-2 structural context only. Both hops must be explicit source relations; no direct seed-to-hop2 relation, neighbour history, population widening, causal/influence/metric/economic propagation or action authorization is inferred."
  };
}

function projectObjectDepth2({research,scope,directRelations=[]}={}){
  const sourceKey=scope?.sourceKey||null,populationKey=scope?.key||null;
  const entity=scope?.selection?.entity;
  if(entity?.kind!=="object")return objectDepth2Empty("NOT_APPLICABLE",{sourceKey,populationKey});
  const seedObjectId=text(entity.id);
