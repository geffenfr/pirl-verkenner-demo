    if(stale())return {status:"STALE_CONTEXT",verified:false};
    if(!selected)return {status:"CANCELLED",verified:false};
    if(!/\.json$/i.test(selected.name||"") || selected.name!==current.filename)return {status:"WRONG_FILE",verified:false};
