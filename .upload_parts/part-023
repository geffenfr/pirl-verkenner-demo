  }
  function canShare(){try{return !stale() && !!file() && typeof windowRef.navigator?.share==="function" &&
    typeof windowRef.navigator?.canShare==="function" && windowRef.navigator.canShare({files:[file()]});}catch(_){return false;}}
  function download({alternative=false}={}){
    requireCurrent();
    const name=alternative?current.filename.replace(/\.json$/i,".json.txt"):current.filename;
    const type=alternative?"text/plain;charset=utf-8":"application/json";
    const url=windowRef.URL.createObjectURL(new windowRef.Blob([current.bytes],{type}));
    if(objectURL)clearURL();objectURL=url;
    const anchor=doc.createElement("a");anchor.href=url;anchor.download=name;anchor.target="_blank";anchor.rel="noopener noreferrer";anchor.hidden=true;
    doc.body.append(anchor);
