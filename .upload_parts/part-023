function renderLoad(){const sec=document.querySelector("#app .load-import");if(!sec)return;const key=JSON.stringify([state.mode,state.busy,state.progress,state.activePartition,state.error?.code,state.error?.message,state.index?.population?.events,state.index?.cacheBytes]);let host=document.querySelector("#app [data-ls2-host]");const html=statusHtml();if(!html){host?.remove();return;}if(!host){host=document.createElement("div");host.dataset.ls2Host="1";sec.insertAdjacentElement("afterend",host);}if(host.dataset.key===key)return;host.dataset.key=key;host.innerHTML=html;const card=host.querySelector("[data-ls2-card]");if(card)card.querySelector("[data-ls2-materialize]")?.addEventListener("click",()=>materialize(card.querySelector("[data-ls2-partition]")?.value));}
