function createEvidenceFileDelivery({windowRef=window, contextToken}={}) {
  if (typeof contextToken !== "function") throw new TypeError("Context reader required");
  const doc=windowRef.document;
  let current=null, objectURL=null, sharing=false;
  const stale=()=>!current || contextToken()!==current.contextToken;
  function clearURL(){if(objectURL){windowRef.URL.revokeObjectURL(objectURL);objectURL=null;}}
  function prepare({value,filename,exportedAt}){
    if(sharing) throw new Error("Rond het deelvenster eerst af.");
    if(!value || !filename?.endsWith(".json")) throw new TypeError("Ongeldig bewijspakket");
    clearURL();
    const bytes=new TextEncoder().encode(JSON.stringify(value,null,2)+"\n");
    current=Object.freeze({bytes,filename,exportedAt,sha256:sha256Portable(bytes),contextToken:contextToken(),
      sourceKey:value.researchScope?.sourceKey??null,scopeKey:value.researchScope?.key??null,
      artifactRefs:Object.freeze({simulation:value.artifacts?.simulation?.record?.modelId??null,
        advice:!!value.artifacts?.advice?.current,review:!!value.artifacts?.researcherReview?.current})});
    return describe();
  }
  function describe(){return current?{filename:current.filename,exportedAt:current.exportedAt,bytes:current.bytes.byteLength,
    sha256:current.sha256,sourceKey:current.sourceKey,scopeKey:current.scopeKey,artifactRefs:current.artifactRefs,
    stale:stale(),savedConfirmed:false}:null;}
