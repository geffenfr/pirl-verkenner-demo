  };
  for(const row of arr(directRelations)){
    const rel=relationSnapshot(row),left=rel.sourceObjectId,right=rel.targetObjectId;
    if(!rel.id||!left||!right){invalid(row,!rel.id?"MISSING_RELATION_ID":"MISSING_ENDPOINT");continue;}
    if(left!==seedObjectId&&right!==seedObjectId){invalid(row,"DIRECT_RELATION_DOES_NOT_TOUCH_SEED");continue;}
    const hop1=left===seedObjectId?right:left;
    if(!objectById.has(hop1)){invalid(row,"UNRESOLVED_DIRECT_ENDPOINT",[hop1]);continue;}
    directNeighborIds.add(hop1);firstHops.push({hop1ObjectId:hop1,relation:rel});
