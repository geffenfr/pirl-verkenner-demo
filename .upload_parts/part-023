function relationSnapshot(row){
  return {
    id:idOf(row,"relation_id")||null,
    type:text(row?.relation_type||row?.type||"UNSPECIFIED")||"UNSPECIFIED",
    sourceObjectId:text(row?.source_object_id??row?.source_id)||null,
    targetObjectId:text(row?.target_object_id??row?.target_id)||null,
