function statusHtml(){if(!state.source&&!state.error)return"";const q=state.intake||{};const intake=`<div class="pirl-ls2-banner"><b>Externe bron-intake</b><span class="meta">container=${esc(q.container||"?")} · structuur=${esc(q.structure||"?")} · detectie=${esc(q.confidence||"?")} · route=${esc(q.route||state.mode||"?")}${q.declared_uncompressed_bytes?` · gedeclareerd uitgepakt=${fmt(q.declared_uncompressed_bytes)} bytes`:""}</span></div>`;if(state.error)return `${intake}<div class="pirl-ls2-progress fail"><b>${esc(state.error.code)}</b> · ${esc(state.error.message)}</div>`;if(state.mode==="DIRECT_RESIDENT")return `${intake}<div class="pirl-ls2-progress"><b>Exact resident</b> · ${esc(state.source.name)}<br>${esc(state.progress)}</div>`;const i=state.index;if(!i)return `<div class="pirl-ls2-progress"><b>Automatic large-source onboarding</b> · ${esc(state.source?.name||"")}<br>${esc(state.progress)}</div>`;const p=i.population,part=i.parts.find(x=>x.id===state.activePartition)||i.parts[0],acts=i.activityDistribution.slice(0,8).map(x=>`<tr><td>${esc(x.activity)}</td><td>${fmt(x.count)}</td></tr>`).join("");return `${intake}<section class="pirl-ls2-card" data-ls2-card><div><span class="pirl-ls2-chip">AUTO INDEXED STREAM</span><h3>${esc(i.source.name)}</h3><p>PRO-004 heeft de originele bron zelf streaming geïndexeerd. Geen voorafgaand .pirlpack nodig.</p></div><div class="pirl-ls2-grid"><div class="pirl-ls2-metric"><small>Volledige populatie</small><b>${fmt(p.cases)} cases</b></div><div class="pirl-ls2-metric"><small>Bron-events</small><b>${fmt(p.events)}</b></div><div class="pirl-ls2-metric"><small>Partities</small><b>${fmt(i.partitioning.partitionCount)}</b></div><div class="pirl-ls2-metric"><small>Interne cache</small><b>${(i.cacheBytes/1048576).toFixed(1)} MiB</b></div></div><div class="pirl-ls2-banner"><b>Semantiek</b><span class="meta">Globale census = EXACT_FULL_POPULATION · detail = EXACT_MATERIALIZED_PARTITION · sampling = NONE · truncation = NONE. Bron-SHA256